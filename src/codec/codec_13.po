msgstr ""
"Project-Id-Version: PWSF codec 13/15\n"
"Language: zh_CN\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-PWSF-Source: codec\n"
