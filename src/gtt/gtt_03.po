# GTT: in-mission radio and hint lines, from the GTT pools of SLOT.DAT
# (ANALYSIS/11).  Two rules for every entry here:
#   - the translation is written IN PLACE, so it must not be longer in bytes
#     than the English line -- the `budget N B` on each entry is that limit,
#     and `po_lint` fails the build with `gtt-budget` when it is exceeded;
#   - the game stores a line break as a two-character `\n`, so keep the same
#     number of lines as the source.


#. GTT pool 0x1c767903 block 0x9160 (id 0xa4, record 0), budget 47 B
#: gtt/0x1c767903/0x9160/1
msgid "Perhaps you'd care to join me in my room later?"
msgstr "回头来我房间坐坐？"

#. GTT pool 0x1c767903 block 0x9210 (id 0x8e, record 0), budget 62 B
#: gtt/0x1c767903/0x9210/0
msgid "Such a beautiful body...be sure to bring it back in one piece."
msgstr "身材真棒…可别弄坏了。"

#. GTT pool 0x1c767903 block 0x92a0 (id 0xc9, record 0), budget 63 B
#: gtt/0x1c767903/0x92a0/0
msgid "Let me guess. You're wearing our prototype stealth camo, right?"
msgstr "我猜你穿了隐形迷彩吧？"

#. GTT pool 0x1c767903 block 0x92a0 (id 0xc9, record 0), budget 38 B
#: gtt/0x1c767903/0x92a0/1
msgid "...Wait, you're not wearing ANYTHING?!"
msgstr "…等等，你什么都没穿？！"

#. GTT pool 0x1c767903 block 0x9370 (id 0x5d, record 0), budget 33 B
#: gtt/0x1c767903/0x9370/0
msgid "Aaah! Snake! Put some clothes on!"
msgstr "啊！SNAKE！快穿上衣服！"

#. GTT pool 0x1c767903 block 0x93d0 (id 0x70, record 0), budget 55 B
#: gtt/0x1c767903/0x93d0/0
msgid "Ugh, don't tell me you're still going around like that?"
msgstr "呃，你还这么晃着？"

#. GTT pool 0x1c767903 block 0x9440 (id 0x54, record 0), budget 20 B
#: gtt/0x1c767903/0x9440/0
msgid "No! I'm not looking!"
msgstr "不！我没看！"

#. GTT pool 0x1c767903 block 0x94a0 (id 0x56, record 0), budget 26 B
#: gtt/0x1c767903/0x94a0/0
msgid "Aaah! Put some clothes on!"
msgstr "啊！快穿上衣服！"

#. GTT pool 0x1c767903 block 0x9500 (id 0x70, record 0), budget 52 B
#: gtt/0x1c767903/0x9500/0
msgid "You should have more respect for yourself than that."
msgstr "你该有点自尊。"

#. GTT pool 0x1c767903 block 0x9570 (id 0x5e, record 0), budget 35 B
#: gtt/0x1c767903/0x9570/0
msgid "You like to show it off, don't you?"
msgstr "你就爱显摆，是吧？"

#. GTT pool 0x1c767903 block 0x95d0 (id 0x6b, record 0), budget 38 B
#: gtt/0x1c767903/0x95d0/0
msgid "Maybe I should do that again sometime."
msgstr "改天再来一次好了。"

#. GTT pool 0x1c767903 block 0x9640 (id 0x53, record 0), budget 18 B
#: gtt/0x1c767903/0x9640/0
msgid "Enjoying yourself?"
msgstr "玩得开心？"

#. GTT pool 0x1c767903 block 0x96a0 (id 0x75, record 0), budget 52 B
#: gtt/0x1c767903/0x96a0/0
msgid "The battery's running low. It needs to be recharged."
msgstr "电量不足，需要充电。"

#. GTT pool 0x1c767903 block 0x9720 (id 0xb2, record 0), budget 41 B
#: gtt/0x1c767903/0x9720/0
msgid "There should be a special charger for it."
msgstr "应该有专用充电器。"

#. GTT pool 0x1c767903 block 0x9720 (id 0xb2, record 0), budget 40 B
#: gtt/0x1c767903/0x9720/1
msgid "Have you teammates charge it up for you."
msgstr "让队友帮你充。"

#. GTT pool 0x1c767903 block 0x97e0 (id 0x6d, record 0), budget 40 B
#: gtt/0x1c767903/0x97e0/0
msgid "That's a special charger for a rail gun."
msgstr "那是电磁炮专用充电器。"

#. GTT pool 0x1c767903 block 0x9850 (id 0x8f, record 0), budget 72 B
#: gtt/0x1c767903/0x9850/0
msgid "Not much point in powering it up if you don't have anything to recharge."
msgstr "没东西可充，充了也白搭。"

#. GTT pool 0x1c767903 block 0x98e0 (id 0xb3, record 0), budget 34 B
#: gtt/0x1c767903/0x98e0/0
msgid "To send a charge to your teammate,"
msgstr "要给队友输电，"

#. GTT pool 0x1c767903 block 0x98e0 (id 0xb3, record 0), budget 31 B
#: gtt/0x1c767903/0x98e0/1
msgid "use AUTO AIM to lock onto them."
msgstr "用自动瞄准锁定他。"

#. GTT pool 0x1c767903 block 0x99a0 (id 0x8a, record 0), budget 48 B
#: gtt/0x1c767903/0x99a0/0
msgid "Keep tapping <I=ATK> to send an electric charge."
msgstr "连按<I=ATK>放电。"

#. GTT pool 0x1c767903 block 0x9a30 (id 0x6e, record 0), budget 34 B
#: gtt/0x1c767903/0x9a30/0
msgid "You need to get closer to lock on."
msgstr "得靠近才能锁定。"

#. GTT pool 0x1c767903 block 0x9aa0 (id 0xaa, record 0), budget 43 B
#: gtt/0x1c767903/0x9aa0/0
msgid "Increasing the charge level on the rail gun"
msgstr "提高电磁炮的蓄力"

#. GTT pool 0x1c767903 block 0x9aa0 (id 0xaa, record 0), budget 30 B
#: gtt/0x1c767903/0x9aa0/1
msgid "makes it vastly more powerful."
msgstr "威力会大增。"

#. GTT pool 0x1c767903 block 0x9b50 (id 0x62, record 0), budget 37 B
#: gtt/0x1c767903/0x9b50/0
msgid "That's....not what that thing is for."
msgstr "那玩意…不是干这个的。"

#. GTT pool 0x1c767903 block 0x9bc0 (id 0x79, record 0), budget 57 B
#: gtt/0x1c767903/0x9bc0/0
msgid "What are you gonna do by yourself with a big rubber band?"
msgstr "拿根大橡皮筋你想干嘛？"

#. GTT pool 0x1c767903 block 0x9c40 (id 0x73, record 0), budget 46 B
#: gtt/0x1c767903/0x9c40/0
msgid "That doesn't look like much of a shield to me."
msgstr "这哪算得上什么盾牌。"

#. GTT pool 0x1c767903 block 0x9cc0 (id 0x89, record 0), budget 58 B
#: gtt/0x1c767903/0x9cc0/0
msgid "Everybody needs to be CO-OP In to use the Human Slingshot!"
msgstr "所有人都要合作才能用人体弹弓！"

#. GTT pool 0x1c767903 block 0x9d50 (id 0xad, record 0), budget 45 B
#: gtt/0x1c767903/0x9d50/0
msgid "Everybody except the guy who's being launched"
msgstr "除了被发射的那个人"

#. GTT pool 0x1c767903 block 0x9d50 (id 0xad, record 0), budget 26 B
#: gtt/0x1c767903/0x9d50/1
msgid "needs to equip their part!"
msgstr ""

#. GTT pool 0x1c767903 block 0x9e00 (id 0x73, record 0), budget 47 B
#: gtt/0x1c767903/0x9e00/0
msgid "When you see the formation icon, press <I=ACT>!"
msgstr "看到阵型图标时，按<I=ACT>！"

#. GTT pool 0x1c767903 block 0x9e80 (id 0xbd, record 0), budget 41 B
#: gtt/0x1c767903/0x9e80/0
msgid "You can use <I=MOVE> to rotate it around."
msgstr "可以用<I=MOVE>旋转它。"

#. GTT pool 0x1c767903 block 0x9e80 (id 0xbd, record 0), budget 45 B
#: gtt/0x1c767903/0x9e80/1
msgid "Work with your teammate to aim at the target."
msgstr "和队友配合瞄准目标。"

#. GTT pool 0x1c767903 block 0xa000 (id 0xe0, record 0), budget 51 B
#: gtt/0x1c767903/0xa000/0
msgid "Pull on the rubber band by rapidly tapping <I=ATK>!"
msgstr "快速连按<I=ATK>拉橡皮筋！"

#. GTT pool 0x1c767903 block 0xa000 (id 0xe0, record 0), budget 71 B
#: gtt/0x1c767903/0xa000/1
msgid "The bar at the bottom of the screen shows how much you've stretched it."
msgstr "屏幕底部的条显示拉了多少。"

#. GTT pool 0x1c767903 block 0xa0e0 (id 0xae, record 0), budget 25 B
#: gtt/0x1c767903/0xa0e0/0
msgid "YOU are the human bullet!"
msgstr "你就是人体子弹！"

#. GTT pool 0x1c767903 block 0xa0e0 (id 0xae, record 0), budget 43 B
#: gtt/0x1c767903/0xa0e0/1
msgid "Use <I=CAMERA> to adjust your launch angle!"
msgstr "用<I=CAMERA>调整发射角度！"

#. GTT pool 0x1c767903 block 0xa2f0 (id 0x11e, record 0), budget 49 B
#: gtt/0x1c767903/0xa2f0/0
msgid "When the rubber band's stretched far enough back,"
msgstr "橡皮筋拉到足够靠后时，"

#. GTT pool 0x1c767903 block 0xa2f0 (id 0x11e, record 0), budget 22 B
#: gtt/0x1c767903/0xa2f0/1
msgid "hit <I=ATK> to launch!"
msgstr "按<I=ATK>发射！"

#. GTT pool 0x1c767903 block 0xa2f0 (id 0x11e, record 0), budget 71 B
#: gtt/0x1c767903/0xa2f0/2
msgid "The bar at the bottom of the screen shows how much it's been stretched."
msgstr "屏幕底部的条显示拉伸程度。"

#. GTT pool 0x1c767903 block 0xa410 (id 0x76, record 0), budget 41 B
#: gtt/0x1c767903/0xa410/0
msgid "Make way for the flying human deterrent!!"
msgstr "给飞行人体威慑让路！！"

#. GTT pool 0x1c767903 block 0xa490 (id 0x68, record 0), budget 30 B
#: gtt/0x1c767903/0xa490/0
msgid "Bullseye!! I salute you, sir!!"
msgstr ""

#. GTT pool 0x1c767903 block 0xa500 (id 0xb5, record 0), budget 43 B
#: gtt/0x1c767903/0xa500/0
msgid "Damn, missed it... Fear not, brave warrior,"
msgstr "可恶，没中……别怕，勇士，"

#. GTT pool 0x1c767903 block 0xa500 (id 0xb5, record 0), budget 32 B
#: gtt/0x1c767903/0xa500/1
msgid "you will not have died in vain!!"
msgstr "你不会白白牺牲的！！"

#. GTT pool 0x1c767903 block 0xa680 (id 0x73, record 0), budget 48 B
#: gtt/0x1c767903/0xa680/0
msgid "You'll break formation if you let go of <I=AIM>."
msgstr "松开<I=AIM>就会脱离阵型。"

#. GTT pool 0x1c767903 block 0xa700 (id 0x88, record 0), budget 58 B
#: gtt/0x1c767903/0xa700/0
msgid "The stealth gun's beam lets you turn a teammate invisible."
msgstr "隐身枪的光束能让队友隐形。"

#. GTT pool 0x1c767903 block 0xa790 (id 0x8f, record 0), budget 70 B
#: gtt/0x1c767903/0xa790/0
msgid "Too bad you can't point it at yourself, though. It's too big for that."
msgstr "可惜不能对自己用，太大了。"

#. GTT pool 0x1c767903 block 0xa820 (id 0xc6, record 0), budget 66 B
#: gtt/0x1c767903/0xa820/0
msgid "If you think you're about to die, use a ration or a recovery item."
msgstr "觉得快死了就用口粮或恢复道具。"

#. GTT pool 0x1c767903 block 0xa820 (id 0xc6, record 0), budget 21 B
#: gtt/0x1c767903/0xa820/1
msgid "Can't be too careful."
msgstr "小心为妙。"

#. GTT pool 0x1c767903 block 0xa8f0 (id 0xd8, record 0), budget 47 B
#: gtt/0x1c767903/0xa8f0/0
msgid "Keep a ration or another recovery item equipped"
msgstr "保持装备口粮或其他恢复道具，"

#. GTT pool 0x1c767903 block 0xa8f0 (id 0xd8, record 0), budget 59 B
#: gtt/0x1c767903/0xa8f0/1
msgid "and you'll use it automatically if your LIFE drops to zero."
msgstr "生命值归零时会自动使用。"

#. GTT pool 0x1c767903 block 0xa9d0 (id 0x111, record 0), budget 44 B
#: gtt/0x1c767903/0xa9d0/0
msgid "All your hard work means nothing if you die."
msgstr "死了就什么都没了。"

#. GTT pool 0x1c767903 block 0xa9d0 (id 0x111, record 0), budget 34 B
#: gtt/0x1c767903/0xa9d0/1
msgid "So avoid combat whenever possible,"
msgstr "尽量避开战斗，"

#. GTT pool 0x1c767903 block 0xa9d0 (id 0x111, record 0), budget 51 B
#: gtt/0x1c767903/0xa9d0/2
msgid "and get to your destination without being detected."
msgstr "不被发现抵达目的地。"

#. GTT pool 0x1c767903 block 0xaaf0 (id 0xf8, record 0), budget 62 B
#: gtt/0x1c767903/0xaaf0/0
msgid "If you do end up having to fight, CQC can be your best friend."
msgstr "若不得不打，CQC最好用。"

#. GTT pool 0x1c767903 block 0xaaf0 (id 0xf8, record 0), budget 78 B
#: gtt/0x1c767903/0xaaf0/1
msgid "But keep in mind you can only use it when equipping a handgun or the stun rod."
msgstr "但只有装备手枪或电击棒时才能用。"

#. GTT pool 0x1c767903 block 0xabf0 (id 0x165, record 0), budget 46 B
#: gtt/0x1c767903/0xabf0/0
msgid "If you score a hit with a tranquilizer weapon,"
msgstr "用麻醉武器命中后，"

#. GTT pool 0x1c767903 block 0xabf0 (id 0x165, record 0), budget 48 B
#: gtt/0x1c767903/0xabf0/1
msgid "the drug will eventually put the enemy to sleep."
msgstr "药效会让敌人睡着。"

#. GTT pool 0x1c767903 block 0xabf0 (id 0x165, record 0), budget 64 B
#: gtt/0x1c767903/0xabf0/2
msgid "So one way to get past an enemy is to shoot them from a distance"
msgstr "所以可从远处射击敌人"

#. GTT pool 0x1c767903 block 0xabf0 (id 0x165, record 0), budget 31 B
#: gtt/0x1c767903/0xabf0/3
msgid "and then wait for them to drop."
msgstr "再等他们倒下。"

#. GTT pool 0x1c767903 block 0xad60 (id 0x95, record 0), budget 71 B
#: gtt/0x1c767903/0xad60/0
msgid "If you're finding it tough to aim your weapon, try turning AUTO AIM on."
msgstr "若瞄准困难，试试开自动瞄准。"

#. GTT pool 0x1c767903 block 0xae00 (id 0x61, record 0), budget 35 B
#: gtt/0x1c767903/0xae00/0
msgid "Push the <I=AUTOAIM> to turn it on."
msgstr "按<I=AUTOAIM>开启。"

#. GTT pool 0x1c767903 block 0xae70 (id 0x74, record 0), budget 44 B
#: gtt/0x1c767903/0xae70/0
msgid "Open the menu, and turn it on under OPTIONS."
msgstr "打开菜单，在OPTIONS里开启。"

#. GTT pool 0x1c767903 block 0xaef0 (id 0x55, record 0), budget 27 B
#: gtt/0x1c767903/0xaef0/0
msgid "We're counting on you Boss."
msgstr "拜托你了，BOSS。"

#. GTT pool 0x1c767903 block 0xaf50 (id 0x5f, record 0), budget 28 B
#: gtt/0x1c767903/0xaf50/0
msgid "Our future is in your hands!"
msgstr "未来在你手上！"

#. GTT pool 0x1c767903 block 0xafb0 (id 0x5f, record 0), budget 38 B
#: gtt/0x1c767903/0xafb0/0
msgid "I'm counting on you. The Boss is, too."
msgstr "拜托你了。BOSS也是。"

#. GTT pool 0x1c767903 block 0xb010 (id 0x8b, record 0), budget 63 B
#: gtt/0x1c767903/0xb010/0
msgid "Let me worry about Mother Base. You go do your thing out there."
msgstr "母基地交给我。你去外面干吧。"

#. GTT pool 0x1c767903 block 0xb0a0 (id 0x77, record 0), budget 46 B
#: gtt/0x1c767903/0xb0a0/0
msgid "I know it's not easy, but I have faith in you."
msgstr "我知道不容易，但我信你。"

#. GTT pool 0x1c767903 block 0xb120 (id 0x62, record 0), budget 33 B
#: gtt/0x1c767903/0xb120/0
msgid "You're doing great, Snake! Peace!"
msgstr "干得好，SNAKE！和平！"

#. GTT pool 0x1c767903 block 0xb190 (id 0x66, record 0), budget 29 B
#: gtt/0x1c767903/0xb190/0
msgid "Snake, help us reclaim peace."
msgstr ""

#. GTT pool 0x1c767903 block 0xb200 (id 0x55, record 0), budget 26 B
#: gtt/0x1c767903/0xb200/0
msgid "I believe in you, Snake..."
msgstr "我相信你，SNAKE……"

#. GTT pool 0x1c767903 block 0xb260 (id 0x79, record 0), budget 59 B
#: gtt/0x1c767903/0xb260/0
msgid "I wish there were something I could do... Be strong, Snake."
msgstr "真希望能帮上忙……坚强点，SNAKE。"

#. GTT pool 0x1c767903 block 0xb2e0 (id 0x97, record 0), budget 75 B
#: gtt/0x1c767903/0xb2e0/0
msgid "Some view, huh? It's nice to stop and enjoy the scenery every now and then."
msgstr "景色不错吧？偶尔停下来欣赏也好。"

#. GTT pool 0x1c767903 block 0xb380 (id 0x15e, record 0), budget 71 B
#: gtt/0x1c767903/0xb380/0
msgid "Are you familiar with leafcutter ants, Snake? They help mushrooms grow."
msgstr "SNAKE，知道切叶蚁吗？它们帮蘑菇生长。"

#. GTT pool 0x1c767903 block 0xb380 (id 0x15e, record 0), budget 27 B
#: gtt/0x1c767903/0xb380/1
msgid "We have them in Costa Rica."
msgstr "哥斯达黎加就有。"

#. GTT pool 0x1c767903 block 0xb380 (id 0x15e, record 0), budget 50 B
#: gtt/0x1c767903/0xb380/2
msgid "The mushrooms provide the ants with spores to eat,"
msgstr "蘑菇给蚂蚁提供孢子吃，"

#. GTT pool 0x1c767903 block 0xb380 (id 0x15e, record 0), budget 53 B
#: gtt/0x1c767903/0xb380/3
msgid "and in exchange the ants protect them from predators."
msgstr "蚂蚁则保护它们免受天敌侵害。"

#. GTT pool 0x1c767903 block 0xb4e0 (id 0x56, record 0), budget 21 B
#: gtt/0x1c767903/0xb4e0/0
msgid "Kind of like us, huh?"
msgstr ""

#. GTT pool 0x1c767903 block 0xb540 (id 0x70, record 0), budget 33 B
#: gtt/0x1c767903/0xb540/0
msgid "That's not why I brought it up..."
msgstr "我提这个不是这意思……"

#. GTT pool 0x1c767903 block 0xb5b0 (id 0x4f, record 0), budget 11 B
#: gtt/0x1c767903/0xb5b0/0
msgid "Head north."
msgstr ""

#. GTT pool 0x1c767903 block 0xb600 (id 0x4f, record 0), budget 10 B
#: gtt/0x1c767903/0xb600/0
