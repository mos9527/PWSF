# GTT: in-mission radio and hint lines, from the GTT pools of SLOT.DAT
# (ANALYSIS/11).  Two rules for every entry here:
#   - the translation is written IN PLACE, so it must not be longer in bytes
#     than the English line -- the `budget N B` on each entry is that limit,
#     and `po_lint` fails the build with `gtt-budget` when it is exceeded;
#   - the game stores a line break as a two-character `\n`, so keep the same
#     number of lines as the source.


#. GTT pool 0x1c677285 block 0x1f80 (id 0x67, record 204), budget 37 B
#: gtt/0x1c677285/0x1f80/0
msgid "I got you into the lab! Hee hee, yay."
msgstr ""

#. GTT pool 0x1c677285 block 0x1ff0 (id 0x94, record 204), budget 75 B
#: gtt/0x1c677285/0x1ff0/0
msgid "Head for the ruins. With the ID card, you should be able to access the lab."
msgstr "去遗迹。有ID卡应该能进实验室。"

#. GTT pool 0x1c677285 block 0x2090 (id 0xba, record 204), budget 55 B
#: gtt/0x1c677285/0x2090/0
msgid "Time's running short. You need to get back to the ruins"
msgstr "时间不多了。你得赶回遗迹"

#. GTT pool 0x1c677285 block 0x2090 (id 0xba, record 204), budget 43 B
#: gtt/0x1c677285/0x2090/1
msgid "as quickly as possible and destroy that AI."
msgstr "尽快摧毁那个AI。"

#. GTT pool 0x1c677285 block 0x2150 (id 0xbf, record 204), budget 33 B
#: gtt/0x1c677285/0x2150/0
msgid "Good thing you found the ID card."
msgstr "幸好你找到了ID卡。"

#. GTT pool 0x1c677285 block 0x2150 (id 0xbf, record 204), budget 49 B
#: gtt/0x1c677285/0x2150/1
msgid "Maybe Quetzalcoatl had something to do with it..."
msgstr "也许羽蛇神跟这事有关……"

#. GTT pool 0x1c677285 block 0x2210 (id 0xc3, record 204), budget 68 B
#: gtt/0x1c677285/0x2210/0
msgid "You got a good ear, being able to pick out a quetzal call like that."
msgstr "你耳朵真灵，居然听出凤尾绿咬鹃的叫声。"

#. GTT pool 0x1c677285 block 0x2210 (id 0xc3, record 204), budget 40 B
#: gtt/0x1c677285/0x2210/1
msgid "It's something like this, right? Kyoooh!"
msgstr "是这样叫的吧？啾——！"

#. GTT pool 0x1c677285 block 0x22e0 (id 0xc0, record 204), budget 59 B
#: gtt/0x1c677285/0x22e0/0
msgid "Hey, uh... you mind if I have a look at that ID card later?"
msgstr "嘿，那个……回头能让我看看那张ID卡吗？"

#. GTT pool 0x1c677285 block 0x22e0 (id 0xc0, record 204), budget 37 B
#: gtt/0x1c677285/0x22e0/1
msgid "Er, for research purposes, of course."
msgstr "呃，当然是为了研究。"

#. GTT pool 0x1c677285 block 0x23a0 (id 0x66, record 204), budget 45 B
#: gtt/0x1c677285/0x23a0/0
msgid "Oh... Never thought she hated me that much..."
msgstr "哦……没想到她那么恨我……"

#. GTT pool 0x1c677285 block 0x2410 (id 0xab, record 204), budget 47 B
#: gtt/0x1c677285/0x2410/0
msgid "That American, Huey... can we really trust him?"
msgstr "那个美国人休伊……真能信他吗？"

#. GTT pool 0x1c677285 block 0x2410 (id 0xab, record 204), budget 22 B
#: gtt/0x1c677285/0x2410/1
msgid "That letter bother me."
msgstr "那封信让我不安"

#. GTT pool 0x1c677285 block 0x24c0 (id 0x7a, record 204), budget 47 B
#: gtt/0x1c677285/0x24c0/0
msgid "I wouldn't mind reading Huey's letter myself..."
msgstr "我倒想自己读读休伊的信……"

#. GTT pool 0x1c677285 block 0x2540 (id 0x83, record 204), budget 61 B
#: gtt/0x1c677285/0x2540/0
msgid "A letter to Dr. Strangelove... Heh, wonder what that's about."
msgstr "给斯特兰奇洛夫博士的信……呵，不知写了啥"

#. GTT pool 0x1c677285 block 0x25d0 (id 0x5f, record 204), budget 34 B
#: gtt/0x1c677285/0x25d0/0
msgid "Did you... read Mr. Huey's letter?"
msgstr "你……读了休伊的信？"

#. GTT pool 0x1c677285 block 0x2630 (id 0x93, record 204), budget 75 B
#: gtt/0x1c677285/0x2630/0
msgid "Come on, Snake! That letter could contain information vital to our mission."
msgstr "拜托，SNAKE！那封信可能有任务的关键情报。"

#. GTT pool 0x1c677285 block 0x26d0 (id 0xbd, record 204), budget 4 B
#: gtt/0x1c677285/0x26d0/0
msgid "Man,"
msgstr ""

#. GTT pool 0x1c677285 block 0x26d0 (id 0xbd, record 204), budget 74 B
#: gtt/0x1c677285/0x26d0/1
msgid "nice to see someone is relaxed enough these days to compose a love letter."
msgstr "真难得，这年头还有人闲得写情书。"

#. GTT pool 0x1c677285 block 0x2790 (id 0x7f, record 204), budget 60 B
#: gtt/0x1c677285/0x2790/0
msgid "It was a love letter? You'll have to show it to me sometime."
msgstr "是情书？回头得给我看看。"

#. GTT pool 0x1c677285 block 0x2810 (id 0x96, record 204), budget 74 B
#: gtt/0x1c677285/0x2810/0
msgid "Ha ha ha! What do you know, a love letter. Never thought he had it in him!"
msgstr "哈哈哈！想不到啊，情书。真没看出他有这本事！"

#. GTT pool 0x1c677285 block 0x28b0 (id 0xb5, record 204), budget 30 B
#: gtt/0x1c677285/0x28b0/0
msgid "I can't believe you would poke"
msgstr "真不敢相信你竟然去"

#. GTT pool 0x1c677285 block 0x28b0 (id 0xb5, record 204), budget 54 B
#: gtt/0x1c677285/0x28b0/1
msgid "your nose into someone else's personal life like that."
msgstr "打探别人的私生活。"

#. GTT pool 0x1c677285 block 0x2970 (id 0xce, record 204), budget 65 B
#: gtt/0x1c677285/0x2970/0
msgid "Your objective is a research facility disguised as ancient ruins."
msgstr "目标是伪装成古代遗迹的研究设施。"

#. GTT pool 0x1c677285 block 0x2970 (id 0xce, record 204), budget 43 B
#: gtt/0x1c677285/0x2970/1
msgid "It's on the other side of the cloud forest."
msgstr "在云雾林另一边。"

#. GTT pool 0x1c677285 block 0x2a40 (id 0x61, record 204), budget 27 B
#: gtt/0x1c677285/0x2a40/0
msgid "Head for Strangelove's lab."
msgstr ""

#. GTT pool 0x1c677285 block 0x2ab0 (id 0x69, record 204), budget 38 B
#: gtt/0x1c677285/0x2ab0/0
msgid "Promise me you won't read that letter."
msgstr "答应我，别看那封信。"

#. GTT pool 0x1c677285 block 0x2b20 (id 0x6d, record 204), budget 40 B
#: gtt/0x1c677285/0x2b20/0
msgid "I wonder what Dr. Strangelove is like..."
msgstr "斯特兰奇洛夫博士什么样…"

#. GTT pool 0x1c677285 block 0x2b90 (id 0x87, record 204), budget 58 B
#: gtt/0x1c677285/0x2b90/0
msgid "Dr. Strangelove's lab can't be much further. Hurry, Snake."
msgstr "博士实验室不远了。快，SNAKE。"

#. GTT pool 0x1c677285 block 0x2c20 (id 0x74, record 204), budget 52 B
#: gtt/0x1c677285/0x2c20/0
msgid "Shouldn't be long before you get to those ruins now."
msgstr "你应该很快就能到那片遗迹了。"

#. GTT pool 0x1c677285 block 0x2ca0 (id 0x74, record 204), budget 54 B
#: gtt/0x1c677285/0x2ca0/0
msgid "The lab seems to be located in a vast series of ruins."
msgstr "实验室似乎位于一大片遗迹之中。"

#. GTT pool 0x1c677285 block 0x2d20 (id 0xb4, record 204), budget 50 B
#: gtt/0x1c677285/0x2d20/0
msgid "Go to the lab and destroy Peace Walker's cerebrum."
msgstr "去实验室，摧毁和平行者的大脑。"

#. GTT pool 0x1c677285 block 0x2d20 (id 0xb4, record 204), budget 21 B
#: gtt/0x1c677285/0x2d20/1
msgid "You can do it, Snake!"
msgstr "你能行，SNAKE！"

#. GTT pool 0x1c677285 block 0x2de0 (id 0x7c, record 204), budget 48 B
#: gtt/0x1c677285/0x2de0/0
msgid "Strangelove's lab is north of there. Head north."
msgstr "博士实验室在北边。往北走。"

#. GTT pool 0x1c677285 block 0x2e60 (id 0x5e, record 204), budget 30 B
#: gtt/0x1c677285/0x2e60/0
msgid "Head for the lab to the north."
msgstr "往北边的实验室去。"

#. GTT pool 0x1c677285 block 0x2ec0 (id 0x84, record 204), budget 63 B
#: gtt/0x1c677285/0x2ec0/0
msgid "First cut over to the east. You'll find the lab north of there."
msgstr "先往东走。实验室就在那北边。"

#. GTT pool 0x1c677285 block 0x2f50 (id 0x7f, record 204), budget 58 B
#: gtt/0x1c677285/0x2f50/0
msgid "We had a mule at my house once. He was a real hard worker."
msgstr "我家曾养过一头骡子。它干活真卖力。"

#. GTT pool 0x1c677285 block 0x2fd0 (id 0xc1, record 204), budget 76 B
#: gtt/0x1c677285/0x2fd0/0
msgid "Sorry, but even just hearing el colibri's song makes me weak in the knees..."
msgstr "抱歉，光是听到蜂鸟的歌声我就腿软…"

#. GTT pool 0x1c677285 block 0x2fd0 (id 0xc1, record 204), budget 18 B
#: gtt/0x1c677285/0x2fd0/1
msgid "Some soldier, huh?"
msgstr ""

#. GTT pool 0x1c677285 block 0x30a0 (id 0x7c, record 204), budget 36 B
#: gtt/0x1c677285/0x30a0/0
msgid "I wonder if the mule made it home..."
msgstr "骡子回到家了吗…"

#. GTT pool 0x1c677285 block 0x3120 (id 0x78, record 204), budget 51 B
#: gtt/0x1c677285/0x3120/0
msgid "I've never been that far before. Be careful, Snake."
msgstr "我从没去过那么远。小心，SNAKE。"

#. GTT pool 0x1c677285 block 0x31a0 (id 0xc7, record 204), budget 42 B
#: gtt/0x1c677285/0x31a0/0
msgid "Snake, I'm a sucker for French women, too,"
msgstr "SNAKE，我也迷法国的女人，"

#. GTT pool 0x1c677285 block 0x31a0 (id 0xc7, record 204), budget 52 B
#: gtt/0x1c677285/0x31a0/1
msgid "but right now I need you to go meet Dr. Strangelove."
msgstr "但现在你得去见斯特兰奇洛夫博士。"

#. GTT pool 0x1c677285 block 0x3270 (id 0x56, record 204), budget 27 B
#: gtt/0x1c677285/0x3270/0
msgid "Ah, une petite Parisenne..."
msgstr "啊，一个巴黎小妞…"

#. GTT pool 0x1c677285 block 0x32d0 (id 0x46, record 204), budget 12 B
#: gtt/0x1c677285/0x32d0/0
msgid "Je t'aime..."
msgstr "我爱你…"

#. GTT pool 0x1c677285 block 0x3320 (id 0x74, record 204), budget 54 B
#: gtt/0x1c677285/0x3320/0
msgid "Better hope Xochiquetzal's watching over you, Snake..."
msgstr "最好指望女神保佑你，SNAKE…"

#. GTT pool 0x1c677285 block 0x33a0 (id 0x7f, record 204), budget 69 B
#: gtt/0x1c677285/0x33a0/0
msgid "Bet those butterflies don't have anything to worry about at all, huh?"
msgstr "那些蝴蝶肯定什么都不用担心吧？"

#. GTT pool 0x1c677285 block 0x3420 (id 0xb8, record 204), budget 65 B
#: gtt/0x1c677285/0x3420/0
msgid "I heard in Japan they have Morpho butterflies almost 6 feet long!"
msgstr "我听说日本有近六英尺长的闪蝶！"

#. GTT pool 0x1c677285 block 0x3420 (id 0xb8, record 204), budget 25 B
#: gtt/0x1c677285/0x3420/1
msgid "I, I wonder if it's true."
msgstr ""

#. GTT pool 0x1c677285 block 0x34e0 (id 0x65, record 204), budget 42 B
#: gtt/0x1c677285/0x34e0/0
msgid "Morpho butterflies... Pretty, aren't they?"
msgstr "闪蝶…挺漂亮的，是吧？"

#. GTT pool 0x1c677285 block 0x3550 (id 0x80, record 204), budget 64 B
#: gtt/0x1c677285/0x3550/0
msgid "Look at the structural coloring on these morphos... fascinating!"
msgstr "看这些闪蝶的结构色…真迷人！"

#. GTT pool 0x1c767903 block 0x0 (id 0x65, record 0), budget 37 B
#: gtt/0x1c767903/0x0/0
msgid "That area is not part of the mission."
msgstr "该区域不属于本次任务。"

#. GTT pool 0x1c767903 block 0x70 (id 0x69, record 0), budget 41 B
#: gtt/0x1c767903/0x70/0
msgid "That's outside the scope of this mission."
msgstr "这超出了本次任务范围。"

#. GTT pool 0x1c767903 block 0xe0 (id 0x67, record 0), budget 35 B
#: gtt/0x1c767903/0xe0/0
msgid "Stay focused on the mission, Snake."
msgstr "专注任务，SNAKE。"

#. GTT pool 0x1c767903 block 0x150 (id 0x65, record 0), budget 27 B
#: gtt/0x1c767903/0x150/0
msgid "Focus! You're on a mission."
msgstr ""

#. GTT pool 0x1c767903 block 0x1c0 (id 0x5e, record 0), budget 24 B
#: gtt/0x1c767903/0x1c0/0
msgid "Hey, nothing over there."
msgstr "嘿，那边没东西"

#. GTT pool 0x1c767903 block 0x220 (id 0x82, record 0), budget 55 B
#: gtt/0x1c767903/0x220/0
msgid ""
"You won't get up there alone.\n"
"With some help, maybe..."
msgstr "你一个人上不去。\n有人帮忙也许行……"

#. GTT pool 0x1c767903 block 0x2b0 (id 0x91, record 0), budget 69 B
#: gtt/0x1c767903/0x2b0/0
msgid ""
"You could probably climb that if you\n"
"had someone to lend you a hand."
msgstr "如果有人搭把手，\n你大概能爬上去。"

#. GTT pool 0x1c767903 block 0x350 (id 0x88, record 0), budget 65 B
#: gtt/0x1c767903/0x350/0
msgid ""
"Hmm, that's too tall to climb.\n"
"If only you had some equipment..."
msgstr "嗯，太高了爬不上去。\n要是有装备就好了……"

#. GTT pool 0x1c767903 block 0x3e0 (id 0x8e, record 0), budget 67 B
#: gtt/0x1c767903/0x3e0/0
msgid ""
"If you had something to stand on,\n"
"you could probably reach that..."
msgstr "要是有东西垫脚，\n你大概够得到……"

#. GTT pool 0x1c767903 block 0x470 (id 0x84, record 0), budget 73 B
#: gtt/0x1c767903/0x470/0
msgid "If you work as a pair, you should be able to climb small cliffs together."
msgstr "两人合作应该能一起爬上小悬崖。"

#. GTT pool 0x1c767903 block 0x500 (id 0x6c, record 0), budget 43 B
#: gtt/0x1c767903/0x500/0
msgid ""
"It'd take two people to\n"
"get through there."
msgstr "要两个人才能\n通过那里。"

#. GTT pool 0x1c767903 block 0x570 (id 0x7c, record 0), budget 55 B
#: gtt/0x1c767903/0x570/0
msgid ""
"You've gotta wait for backup\n"
"before going any farther."
msgstr "你得等增援\n才能继续前进。"

#. GTT pool 0x1c767903 block 0x5f0 (id 0x47, record 0), budget 9 B
#: gtt/0x1c767903/0x5f0/0
msgid "Awwright!"
msgstr ""

#. GTT pool 0x1c767903 block 0x640 (id 0x45, record 0), budget 7 B
#: gtt/0x1c767903/0x640/0
msgid "Niiice!"
msgstr ""

#. GTT pool 0x1c767903 block 0x690 (id 0x71, record 0), budget 42 B
#: gtt/0x1c767903/0x690/0
msgid "Fulton Recovery to helicopter is complete."
msgstr "富尔顿回收至直升机完成。"

#. GTT pool 0x1c767903 block 0x710 (id 0x7a, record 0), budget 53 B
#: gtt/0x1c767903/0x710/0
msgid "Fulton Recovery subject confirmed onboard helicopter."
msgstr "富尔顿回收目标已确认在机上。"

#. GTT pool 0x1c767903 block 0x790 (id 0x4f, record 0), budget 12 B
#: gtt/0x1c767903/0x790/0
msgid "What a haul!"
msgstr ""

#. GTT pool 0x1c767903 block 0x7e0 (id 0x64, record 0), budget 24 B
#: gtt/0x1c767903/0x7e0/0
msgid "Great! You did it again!"
msgstr ""

#. GTT pool 0x1c767903 block 0x850 (id 0x46, record 0), budget 8 B
#: gtt/0x1c767903/0x850/0
msgid "Amazing!"
msgstr ""

#. GTT pool 0x1c767903 block 0x8a0 (id 0xb9, record 0), budget 26 B
#: gtt/0x1c767903/0x8a0/0
msgid "The chopper's almost full!"
msgstr "直升机快满了！"

#. GTT pool 0x1c767903 block 0x8a0 (id 0xb9, record 0), budget 48 B
#: gtt/0x1c767903/0x8a0/1
msgid "You won't be able to use the Fulton much longer."
msgstr "富尔顿很快就不能再用了。"

#. GTT pool 0x1c767903 block 0x960 (id 0xc3, record 0), budget 35 B
#: gtt/0x1c767903/0x960/0
msgid "The Fulton recovery chopper's full."
msgstr "富尔顿回收直升机已满。"

#. GTT pool 0x1c767903 block 0x960 (id 0xc3, record 0), budget 60 B
#: gtt/0x1c767903/0x960/1
msgid "We'll have to suspend recoveries until it gets back to base."
msgstr "得暂停回收，等它回基地。"

#. GTT pool 0x1c767903 block 0xa30 (id 0xc3, record 0), budget 36 B
#: gtt/0x1c767903/0xa30/0
msgid "The chopper's bursting at the seams!"
msgstr "直升机快撑爆了！"

#. GTT pool 0x1c767903 block 0xa30 (id 0xc3, record 0), budget 51 B
#: gtt/0x1c767903/0xa30/1
msgid "No more Fulton recoveries until it returns to base."
msgstr "回基地前不能再富尔顿回收。"

#. GTT pool 0x1c767903 block 0xb00 (id 0xe6, record 0), budget 77 B
#: gtt/0x1c767903/0xb00/0
msgid "That last Fulton recovery of yours is still twirling around below the chopper"
msgstr "你上次富尔顿回收的还在直升机下打转"

#. GTT pool 0x1c767903 block 0xb00 (id 0xe6, record 0), budget 55 B
#: gtt/0x1c767903/0xb00/1
msgid "- there's no more room. Lay off the recoveries for now."
msgstr "——没地方了。暂时别回收了。"

#. GTT pool 0x1c767903 block 0xbf0 (id 0xc4, record 0), budget 34 B
#: gtt/0x1c767903/0xbf0/0
msgid "Mother Base is already jam-packed."
msgstr "母基地已经塞满了。"

#. GTT pool 0x1c767903 block 0xbf0 (id 0xc4, record 0), budget 54 B
#: gtt/0x1c767903/0xbf0/1
msgid "Lay off the Fulton recoveries until there's more room."
msgstr "母基地满员前，暂停富尔顿回收。"

#. GTT pool 0x1c767903 block 0xcc0 (id 0x107, record 0), budget 39 B
#: gtt/0x1c767903/0xcc0/0
msgid "Mother Base is practically overflowing."
msgstr "母基地已经快装不下了。"

#. GTT pool 0x1c767903 block 0xcc0 (id 0x107, record 0), budget 64 B
#: gtt/0x1c767903/0xcc0/1
msgid "Until some of these people leave, further Fulton recoveries are-"
msgstr "在有些人离开之前，继续富尔顿回收会——"

#. GTT pool 0x1c767903 block 0xcc0 (id 0x107, record 0), budget 18 B
#: gtt/0x1c767903/0xcc0/2
msgid "hey, stop pushing!"
msgstr "喂，别推了！"

#. GTT pool 0x1c767903 block 0xdd0 (id 0xff, record 0), budget 34 B
#: gtt/0x1c767903/0xdd0/0
msgid "No more Fulton recoveries for now."
msgstr "现在不能富尔顿回收了。"

#. GTT pool 0x1c767903 block 0xdd0 (id 0xff, record 0), budget 50 B
#: gtt/0x1c767903/0xdd0/1
msgid "Mother Base is so packed, it's standing room only."
msgstr "母基地挤得连站的地方都没有了。"

#. GTT pool 0x1c767903 block 0xdd0 (id 0xff, record 0), budget 23 B
#: gtt/0x1c767903/0xdd0/2
msgid "Damn it! Man overboard!"
msgstr ""

#. GTT pool 0x1c767903 block 0xed0 (id 0xe9, record 0), budget 43 B
#: gtt/0x1c767903/0xed0/0
msgid "To use Fulton recovery on a downed soldier,"
msgstr "对倒地士兵用富尔顿回收，"

#. GTT pool 0x1c767903 block 0xed0 (id 0xe9, record 0), budget 57 B
#: gtt/0x1c767903/0xed0/1
msgid "get up next to them so the icon appears and push <I=ACT>."
msgstr "靠近他让图标出现，然后按<I=ACT>。"

#. GTT pool 0x1c767903 block 0xfc0 (id 0xd8, record 0), budget 62 B
#: gtt/0x1c767903/0xfc0/0
msgid "To use the Fulton recovery system on an incapacitated soldier,"
msgstr "对无力士兵用富尔顿回收系统，"

#. GTT pool 0x1c767903 block 0xfc0 (id 0xd8, record 0), budget 34 B
#: gtt/0x1c767903/0xfc0/1
msgid "get next to him and press <I=ACT>."
msgstr "靠近他并按<I=ACT>。"

#. GTT pool 0x1c767903 block 0x10a0 (id 0xaf, record 0), budget 48 B
#: gtt/0x1c767903/0x10a0/0
msgid "We're not seeing any large weapons in that area."
msgstr "该区域没有发现大型武器。"

#. GTT pool 0x1c767903 block 0x10a0 (id 0xaf, record 0), budget 29 B
#: gtt/0x1c767903/0x10a0/1
msgid "No point in using the EM Net."
msgstr "用电磁网没有意义。"

#. GTT pool 0x1c767903 block 0x1150 (id 0x8d, record 0), budget 76 B
#: gtt/0x1c767903/0x1150/0
msgid "The EM Net is useless unless you're in the vicinity of a large-scale weapon."
