# GTT: in-mission radio and hint lines, from the GTT pools of SLOT.DAT
# (ANALYSIS/11).  Two rules for every entry here:
#   - the translation is written IN PLACE, so it must not be longer in bytes
#     than the English line -- the `budget N B` on each entry is that limit,
#     and `po_lint` fails the build with `gtt-budget` when it is exceeded;
#   - the game stores a line break as a two-character `\n`, so keep the same
#     number of lines as the source.


#. GTT pool 0x1c7c724b block 0x630 (id 0xae, record 186), budget 31 B
#: gtt/0x1c7c724b/0x630/0
msgid "Don't waste those parts, Snake!"
msgstr "别浪费零件，SNAKE！"

#. GTT pool 0x1c7c724b block 0x630 (id 0xae, record 186), budget 38 B
#: gtt/0x1c7c724b/0x630/1
msgid "Take it out by climbing in the AI pod!"
msgstr "趁现在爬进AI舱！"

#. GTT pool 0x1c7c724b block 0x6e0 (id 0x77, record 186), budget 41 B
#: gtt/0x1c7c724b/0x6e0/0
msgid "Blow the hatch and climb into the AI pod!"
msgstr "炸开舱盖爬进AI舱！"

#. GTT pool 0x1c7c724b block 0x760 (id 0x6c, record 186), budget 40 B
#: gtt/0x1c7c724b/0x760/0
msgid "You should be able to get in the AI pod!"
msgstr "你应该能进AI舱！"

#. GTT pool 0x1c7c724b block 0x7d0 (id 0x80, record 186), budget 53 B
#: gtt/0x1c7c724b/0x7d0/0
msgid "You can't get in now... You'll have to stop it again."
msgstr "现在进不去了…得再让它停下来。"

#. GTT pool 0x1c7c724b block 0x850 (id 0x65, record 186), budget 23 B
#: gtt/0x1c7c724b/0x850/0
msgid "Now! Get in the AI pod!"
msgstr "现在！进AI舱！"

#. GTT pool 0x1c7c724b block 0x8c0 (id 0x64, record 186), budget 35 B
#: gtt/0x1c7c724b/0x8c0/0
msgid "It's too late. Stop it from moving!"
msgstr "来不及，快让它停下！"

#. GTT pool 0x1c7c724b block 0x930 (id 0x5e, record 186), budget 28 B
#: gtt/0x1c7c724b/0x930/0
msgid "There's your chance! Get in!"
msgstr "机会来了！快进去！"

#. GTT pool 0x1c7c724b block 0x990 (id 0x68, record 186), budget 31 B
#: gtt/0x1c7c724b/0x990/0
msgid "Aim for the cylindrical AI pod!"
msgstr "瞄准圆筒状AI舱！"

#. GTT pool 0x1c7c724b block 0xa00 (id 0xab, record 186), budget 22 B
#: gtt/0x1c7c724b/0xa00/0
msgid "Get it to stop moving!"
msgstr "让它停下来！"

#. GTT pool 0x1c7c724b block 0xa00 (id 0xab, record 186), budget 46 B
#: gtt/0x1c7c724b/0xa00/1
msgid "You need to buy time to get inside the AI pod!"
msgstr "得争取时间钻进AI舱！"

#. GTT pool 0x1c7c724b block 0xab0 (id 0x76, record 186), budget 36 B
#: gtt/0x1c7c724b/0xab0/0
msgid "Use armor piercing rounds or an RPG!"
msgstr "用穿甲弹或RPG！"

#. GTT pool 0x1c7c724b block 0xb30 (id 0xa9, record 186), budget 58 B
#: gtt/0x1c7c724b/0xb30/0
msgid "Try to leave the weaponry and AI parts intact if possible."
msgstr "尽量别弄坏武器和AI零件。"

#. GTT pool 0x1c7c724b block 0xb30 (id 0xa9, record 186), budget 16 B
#: gtt/0x1c7c724b/0xb30/1
msgid "I can use those."
msgstr "我可以用。"

#. GTT pool 0x1c7c724b block 0xbe0 (id 0x79, record 186), budget 54 B
#: gtt/0x1c7c724b/0xbe0/0
msgid "There'll be some warning signs when it's coming out..."
msgstr "它出来前会有一些预兆…"

#. GTT pool 0x1c7c724b block 0xc60 (id 0x75, record 186), budget 51 B
#: gtt/0x1c7c724b/0xc60/0
msgid "The Pupa's back up and running! Shut it down again!"
msgstr "蛹又启动了！再关掉它！"

#. GTT pool 0x1c7c724b block 0xce0 (id 0x63, record 186), budget 34 B
#: gtt/0x1c7c724b/0xce0/0
msgid "There it is! That cylindrical pod!"
msgstr "就是那个！圆筒舱！"

#. GTT pool 0x1c7c724b block 0xdd0 (id 0x128, record 186), budget 41 B
#: gtt/0x1c7c724b/0xdd0/0
msgid "Non-lethal weapons against an AI machine?"
msgstr "对AI机器用非致命武器？"

#. GTT pool 0x1c7c724b block 0xdd0 (id 0x128, record 186), budget 63 B
#: gtt/0x1c7c724b/0xdd0/1
msgid "What do you think this is, shootin' squirrels in the backyard?!"
msgstr "你当这是在后院打松鼠吗？！"

#. GTT pool 0x1c7c724b block 0xdd0 (id 0x128, record 186), budget 37 B
#: gtt/0x1c7c724b/0xdd0/2
msgid "Get back here and get organized, now!"
msgstr "快回来重整队形，马上！"

#. GTT pool 0x1c7c724b block 0x1220 (id 0xb9, record 186), budget 30 B
#: gtt/0x1c7c724b/0x1220/0
msgid "Whoo! Look at that thing move!"
msgstr "哇！你看它跑得多快！"

#. GTT pool 0x1c7c724b block 0x1220 (id 0xb9, record 186), budget 38 B
#: gtt/0x1c7c724b/0x1220/1
msgid "I amaze myself sometimes... er, sorry,"
msgstr ""

#. GTT pool 0x1c7c724b block 0x12e0 (id 0xb4, record 186), budget 50 B
#: gtt/0x1c7c724b/0x12e0/0
msgid "If you destroy the boosters on the left and right,"
msgstr "打掉左右两侧的推进器，"

#. GTT pool 0x1c7c724b block 0x12e0 (id 0xb4, record 186), budget 37 B
#: gtt/0x1c7c724b/0x12e0/1
msgid "you can stop it from charging at you!"
msgstr "就能阻止它冲过来！"

#. GTT pool 0x1c7c724b block 0x13a0 (id 0x98, record 186), budget 80 B
#: gtt/0x1c7c724b/0x13a0/0
msgid "Destroy the treads on the left and right to stop it from doing its punch attack!"
msgstr "打掉左右两侧履带，阻止它出拳！"

#. GTT pool 0x1c7c724b block 0x1440 (id 0x9e, record 186), budget 29 B
#: gtt/0x1c7c724b/0x1440/0
msgid "Maybe you could buy some time"
msgstr "也许能拖延时间"

#. GTT pool 0x1c7c724b block 0x1440 (id 0x9e, record 186), budget 24 B
#: gtt/0x1c7c724b/0x1440/1
msgid "by attacking the AI pod!"
msgstr "攻击AI舱！"

#. GTT pool 0x1c7c724b block 0x14e0 (id 0xac, record 186), budget 32 B
#: gtt/0x1c7c724b/0x14e0/0
msgid "Don't attack the AI pod too much"
msgstr "别过度攻击AI舱"

#. GTT pool 0x1c7c724b block 0x14e0 (id 0xac, record 186), budget 37 B
#: gtt/0x1c7c724b/0x14e0/1
msgid "or you might break the memory boards."
msgstr "否则会打坏记忆板。"

#. GTT pool 0x1c7c724b block 0x1590 (id 0xa8, record 186), budget 23 B
#: gtt/0x1c7c724b/0x1590/0
msgid "Get close to the AI pod"
msgstr "靠近AI舱"

#. GTT pool 0x1c7c724b block 0x1590 (id 0xa8, record 186), budget 41 B
#: gtt/0x1c7c724b/0x1590/1
msgid "and press <I=ACT> when the icon shows up!"
msgstr "图标出现时按<I=ACT>！"

#. GTT pool 0x1c7c724b block 0x1640 (id 0x101, record 186), budget 86 B
#: gtt/0x1c7c724b/0x1640/0
msgid "Apparently each part of an AI weapon is connected to a memory board inside the AI pod."
msgstr "AI兵器的每个部件都连着AI舱内的记忆板。"

#. GTT pool 0x1c7c724b block 0x1640 (id 0x101, record 186), budget 60 B
#: gtt/0x1c7c724b/0x1640/1
msgid "Destroying a part will release the lock on the memory board."
msgstr "摧毁部件就能解除记忆板的锁定。"

#. GTT pool 0x1c7c724b block 0x1750 (id 0x65, record 186), budget 27 B
#: gtt/0x1c7c724b/0x1750/0
msgid "Now! Get inside the AI pod!"
msgstr "快！进AI舱！"

#. GTT pool 0x1c7c724b block 0x17c0 (id 0x67, record 186), budget 32 B
#: gtt/0x1c7c724b/0x17c0/0
msgid "The AI pod is open - get inside!"
msgstr "AI舱开了，快进去！"

#. GTT pool 0x1c7c72cb block 0x0 (id 0x71, record 282), budget 39 B
#: gtt/0x1c7c72cb/0x0/0
msgid "Isn't there some way to bust that lock?"
msgstr "没办法撬开那锁吗？"

#. GTT pool 0x1c7c72cb block 0x80 (id 0x70, record 282), budget 49 B
#: gtt/0x1c7c72cb/0x80/0
msgid "The jigsaw, Snake - that'll get you out of there."
msgstr "用锯子，SNAKE，能帮你脱身。"

#. GTT pool 0x1c7c72cb block 0xf0 (id 0x6f, record 282), budget 38 B
#: gtt/0x1c7c72cb/0xf0/0
msgid "Couldn't you unlock that door somehow?"
msgstr "不能想办法开那门吗？"

#. GTT pool 0x1c7c72cb block 0x160 (id 0x7b, record 282), budget 45 B
#: gtt/0x1c7c72cb/0x160/0
msgid "What about the ID card, Snake? Give it a try."
msgstr "试试ID卡，SNAKE？"

#. GTT pool 0x1c7c72cb block 0x1e0 (id 0x95, record 282), budget 21 B
#: gtt/0x1c7c72cb/0x1e0/0
msgid "They took the jigsaw?"
msgstr "锯子被拿走了？"

#. GTT pool 0x1c7c72cb block 0x1e0 (id 0x95, record 282), budget 33 B
#: gtt/0x1c7c72cb/0x1e0/1
msgid "There's got to be some other way."
msgstr "肯定还有别的办法。"

#. GTT pool 0x1c7c72cb block 0x280 (id 0xb1, record 282), budget 19 B
#: gtt/0x1c7c72cb/0x280/0
msgid "They took the card?"
msgstr "卡被拿走了？"

#. GTT pool 0x1c7c72cb block 0x280 (id 0xb1, record 282), budget 60 B
#: gtt/0x1c7c72cb/0x280/1
msgid "We'd better think of some other way to get you out of there."
msgstr "得另想办法救你出来。"

#. GTT pool 0x1c7c72cb block 0x340 (id 0xb8, record 282), budget 41 B
#: gtt/0x1c7c72cb/0x340/0
msgid "You lost both the jigsaw and the ID card?"
msgstr "锯子和ID卡都没了？"

#. GTT pool 0x1c7c72cb block 0x340 (id 0xb8, record 282), budget 50 B
#: gtt/0x1c7c72cb/0x340/1
msgid "I guess we'll have to come up with something else."
msgstr "只能另想办法了。"

#. GTT pool 0x1c7c72cb block 0x400 (id 0x129, record 282), budget 43 B
#: gtt/0x1c7c72cb/0x400/0
msgid "Don't just stand there. Try something else."
msgstr "别愣着，试试别的。"

#. GTT pool 0x1c7c72cb block 0x400 (id 0x129, record 282), budget 58 B
#: gtt/0x1c7c72cb/0x400/1
msgid "Good thing there are two of you. It'd be impossible alone."
msgstr "幸好有两个人，一个人根本不可能。"

#. GTT pool 0x1c7c72cb block 0x400 (id 0x129, record 282), budget 57 B
#: gtt/0x1c7c72cb/0x400/2
msgid "Work together and you should be able to get out of there."
msgstr "合作就能脱身。"

#. GTT pool 0x1c7c72cb block 0x530 (id 0xd6, record 282), budget 35 B
#: gtt/0x1c7c72cb/0x530/0
msgid "Look around. Analyze the situation."
msgstr "观察四周，分析情况。"

#. GTT pool 0x1c7c72cb block 0x530 (id 0xd6, record 282), budget 63 B
#: gtt/0x1c7c72cb/0x530/1
msgid "I bet you can find a way out if you work with your buddy there."
msgstr "和同伴合作，肯定能找到出路。"

#. GTT pool 0x1c7c72cb block 0x610 (id 0x112, record 282), budget 55 B
#: gtt/0x1c7c72cb/0x610/0
msgid "I bet you could extend your reach if you work together."
msgstr "你们合作的话，能到更远的地方。"

#. GTT pool 0x1c7c72cb block 0x610 (id 0x112, record 282), budget 58 B
#: gtt/0x1c7c72cb/0x610/1
msgid "Isn't there some sort of opening you could escape through?"
msgstr "有没有什么出口能逃出去？"

#. GTT pool 0x1c7c72cb block 0x610 (id 0x112, record 282), budget 21 B
#: gtt/0x1c7c72cb/0x610/2
msgid "Look around. Look up."
msgstr ""

#. GTT pool 0x1c7c72cb block 0x730 (id 0xc9, record 282), budget 53 B
#: gtt/0x1c7c72cb/0x730/0
msgid "Press the icon buttons alternately to use the jigsaw."
msgstr "交替按图标键使用线锯。"

#. GTT pool 0x1c7c72cb block 0x730 (id 0xc9, record 282), budget 35 B
#: gtt/0x1c7c72cb/0x730/1
msgid "But try not to make too much noise."
msgstr "但尽量别弄出太大动静。"

#. GTT pool 0x1c7c72cb block 0x800 (id 0xc5, record 282), budget 56 B
#: gtt/0x1c7c72cb/0x800/0
msgid ""
"Use the jigsaw by alternating between the icon\n"
"buttons."
msgstr "交替按图标\n键使用线锯。"

#. GTT pool 0x1c7c72cb block 0x800 (id 0xc5, record 282), budget 31 B
#: gtt/0x1c7c72cb/0x800/1
msgid "Just make sure to keep it down."
msgstr "务必保持安静。"

#. GTT pool 0x1c7c72cb block 0x8d0 (id 0x7b, record 282), budget 53 B
#: gtt/0x1c7c72cb/0x8d0/0
msgid "Looks like they've finished their little Q&A session."
msgstr "看来他们的小问答结束了。"

#. GTT pool 0x1c7c72cb block 0x950 (id 0x92, record 282), budget 64 B
#: gtt/0x1c7c72cb/0x950/0
msgid "Guess it's over for now. Let's hope there's no permanent damage."
msgstr "暂时结束了。但愿没造成永久损伤。"

#. GTT pool 0x1c7c72cb block 0x9f0 (id 0xcb, record 282), budget 48 B
#: gtt/0x1c7c72cb/0x9f0/0
msgid "Looks like your buddy didn't tell them anything."
msgstr "看来你的战友什么都没说。"

#. GTT pool 0x1c7c72cb block 0x9f0 (id 0xcb, record 282), budget 36 B
#: gtt/0x1c7c72cb/0x9f0/1
msgid "You sure know how to pick 'em, Boss."
msgstr "你挑人真有一套，BOSS。"

#. GTT pool 0x1c7c72cb block 0xac0 (id 0x60, record 282), budget 34 B
#: gtt/0x1c7c72cb/0xac0/0
msgid "This is bad, Snake. Hang in there."
msgstr "情况不妙，SNAKE。撑住。"

#. GTT pool 0x1c7c72cb block 0xb20 (id 0x67, record 282), budget 37 B
#: gtt/0x1c7c72cb/0xb20/0
msgid "Sure hope you come back in one piece."
msgstr "希望你能完好回来。"

#. GTT pool 0x1c7c72cb block 0xb90 (id 0x5f, record 282), budget 35 B
#: gtt/0x1c7c72cb/0xb90/0
msgid "Don't break! We're counting on you!"
msgstr "别垮掉！我们全靠你了！"

#. GTT pool 0x1c7c72cb block 0xbf0 (id 0x65, record 282), budget 41 B
#: gtt/0x1c7c72cb/0xbf0/0
msgid "You plan on leaving your comrades behind?"
msgstr "你打算丢下战友不管？"

#. GTT pool 0x1c7c72cb block 0xc60 (id 0x80, record 282), budget 47 B
#: gtt/0x1c7c72cb/0xc60/0
msgid "Escape with your comrades. Leave no man behind."
msgstr "带战友一起逃。不丢下任何人。"

#. GTT pool 0x1c7c72cb block 0xce0 (id 0x73, record 282), budget 37 B
#: gtt/0x1c7c72cb/0xce0/0
msgid "Can't you unlock your comrade's cell?"
msgstr "你不能打开战友的牢房吗？"

#. GTT pool 0x1c7c72cb block 0xd60 (id 0x74, record 282), budget 44 B
#: gtt/0x1c7c72cb/0xd60/0
msgid "Unlock the cell doors from the control room."
msgstr "从控制室打开牢房门。"

#. GTT pool 0x1c7c72cb block 0xde0 (id 0x8a, record 282), budget 66 B
#: gtt/0x1c7c72cb/0xde0/0
msgid "Find a way to help your comrades, Snake. Don't leave without them."
msgstr "想办法救出战友，SNAKE。别丢下他们。"

#. GTT pool 0x1c7c72cb block 0xe70 (id 0xe9, record 282), budget 62 B
#: gtt/0x1c7c72cb/0xe70/0
msgid "Snake, that door won’t open while the base is on high alert."
msgstr "SNAKE，基地高度戒备时那扇门打不开。"

#. GTT pool 0x1c7c72cb block 0xe70 (id 0xe9, record 282), budget 55 B
#: gtt/0x1c7c72cb/0xe70/1
msgid "You'll have to wait until the security level's lowered."
msgstr "得等警戒级别降下来。"

#. GTT pool 0x1c7c730b block 0x0 (id 0x6a, record 324), budget 39 B
#: gtt/0x1c7c730b/0x0/0
msgid "The gate! Get through before it closes!"
msgstr "大门！趁它关上之前过去！"

#. GTT pool 0x1c7c730b block 0x70 (id 0x67, record 324), budget 26 B
#: gtt/0x1c7c730b/0x70/0
msgid "RPGs?! Here?! That's nuts!"
msgstr ""

#. GTT pool 0x1c7c730b block 0xe0 (id 0x84, record 324), budget 56 B
#: gtt/0x1c7c730b/0xe0/0
msgid "Don't hold back. They deserve what they get - and worse!"
msgstr "别手软。他们活该——还便宜他们了！"

#. GTT pool 0x1c7c730b block 0x170 (id 0x58, record 324), budget 25 B
#: gtt/0x1c7c730b/0x170/0
msgid "Take the elevator, quick!"
msgstr "坐电梯，快！"

#. GTT pool 0x1c7c730b block 0x1d0 (id 0x6a, record 324), budget 34 B
#: gtt/0x1c7c730b/0x1d0/0
msgid "What's wrong? Afraid of elevators?"
msgstr "怎么了？怕电梯？"

#. GTT pool 0x1c7c730b block 0x240 (id 0x6c, record 324), budget 30 B
#: gtt/0x1c7c730b/0x240/0
msgid "Hurry, before the gate closes!"
msgstr "快，趁门还没关！"

#. GTT pool 0x1c7c730b block 0x2b0 (id 0xae, record 324), budget 47 B
#: gtt/0x1c7c730b/0x2b0/0
msgid "Don't let them close that gate! <I=ACT>, Snake!"
msgstr "别让他们关门！按<I=ACT>，SNAKE！"

#. GTT pool 0x1c7c730b block 0x2b0 (id 0xae, record 324), budget 28 B
#: gtt/0x1c7c730b/0x2b0/1
msgid "Use <I=ACT> to prop it open!"
msgstr "用<I=ACT>顶住门！"

#. GTT pool 0x1c7c730b block 0x360 (id 0xd9, record 324), budget 46 B
#: gtt/0x1c7c730b/0x360/0
msgid "You've got to help get your teammates through!"
msgstr "你得帮队友通过！"

#. GTT pool 0x1c7c730b block 0x360 (id 0xd9, record 324), budget 58 B
#: gtt/0x1c7c730b/0x360/1
msgid "Press <I=ACT> while near the gate to keep it from closing!"
msgstr "在门旁按<I=ACT>阻止它关闭！"

#. GTT pool 0x1c7c730b block 0x440 (id 0xc5, record 324), budget 35 B
#: gtt/0x1c7c730b/0x440/0
msgid "Push <I=ACT> when the icon appears."
msgstr "图标出现时按<I=ACT>。"

#. GTT pool 0x1c7c730b block 0x440 (id 0xc5, record 324), budget 53 B
#: gtt/0x1c7c730b/0x440/1
msgid "Hold open the gate so your teammates can get through!"
msgstr "撑住门让队友通过！"

#. GTT pool 0x1c7c730b block 0x510 (id 0xe2, record 324), budget 54 B
#: gtt/0x1c7c730b/0x510/0
msgid "You're going to have to get that gate open to proceed."
msgstr "你得把门弄开才能前进。"

#. GTT pool 0x1c7c730b block 0x510 (id 0xe2, record 324), budget 61 B
#: gtt/0x1c7c730b/0x510/1
msgid "When the icon appears, hit <I=ACT> repeatedly to pry it open!"
msgstr "图标出现时连按<I=ACT>撬开！"

#. GTT pool 0x1c7c730b block 0x600 (id 0xfa, record 324), budget 48 B
#: gtt/0x1c7c730b/0x600/0
msgid "You're just going to have to pry that gate open."
msgstr "你只能把门撬开。"

#. GTT pool 0x1c7c730b block 0x600 (id 0xfa, record 324), budget 36 B
#: gtt/0x1c7c730b/0x600/1
msgid "Position yourself so an icon appears"
msgstr "站好位置让图标出现"

#. GTT pool 0x1c7c730b block 0x700 (id 0xc7, record 324), budget 44 B
#: gtt/0x1c7c730b/0x700/0
msgid "You opened the gate with your bare hands...?"
msgstr "你徒手把门打开了……？"

#. GTT pool 0x1c7c730b block 0x700 (id 0xc7, record 324), budget 45 B
#: gtt/0x1c7c730b/0x700/1
msgid "You gotta teach me some of these tricks, Boss"
msgstr "你得教教我这些招，BOSS"

#. GTT pool 0x1c7cf20b block 0x0 (id 0x5e, record 126), budget 29 B
#: gtt/0x1c7cf20b/0x0/0
msgid "Destroy that armored vehicle!"
msgstr "摧毁那辆装甲车！"

#. GTT pool 0x1c7cf20b block 0x60 (id 0x6b, record 126), budget 31 B
#: gtt/0x1c7cf20b/0x60/0
msgid "Just junk that armored vehicle."
msgstr "把那辆装甲车报废掉。"

#. GTT pool 0x1c7cf20b block 0xd0 (id 0x73, record 126), budget 45 B
#: gtt/0x1c7cf20b/0xd0/0
msgid ""
"Start with the armored vehicle!\n"
"Take it out!"
msgstr "先解决装甲车！\n干掉它！"

