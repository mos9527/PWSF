# GTT: in-mission radio and hint lines, from the GTT pools of SLOT.DAT
# (ANALYSIS/11).  Two rules for every entry here:
#   - the translation is written IN PLACE, so it must not be longer in bytes
#     than the English line -- the `budget N B` on each entry is that limit,
#     and `po_lint` fails the build with `gtt-budget` when it is exceeded;
#   - the game stores a line break as a two-character `\n`, so keep the same
#     number of lines as the source.


#. GTT pool 0x1c79f38b block 0x16a0 (id 0xdb, record 192), budget 55 B
#: gtt/0x1c79f38b/0x16a0/1
msgid "Are you prepared to tell Capcom you killed one of them?"
msgstr "你准备好告诉卡普空你杀了它们一只吗？"

#. GTT pool 0x1c79f38b block 0x1780 (id 0xa7, record 192), budget 47 B
#: gtt/0x1c79f38b/0x1780/0
msgid "How dare you do that to that poor little kitty!"
msgstr "你竟忍心对那可怜小猫下手！"

#. GTT pool 0x1c79f38b block 0x1780 (id 0xa7, record 192), budget 28 B
#: gtt/0x1c79f38b/0x1780/1
msgid "The barbarism of soldiers..."
msgstr "士兵的野蛮……"

#. GTT pool 0x1c79f38b block 0x1830 (id 0x7d, record 192), budget 42 B
#: gtt/0x1c79f38b/0x1830/0
msgid "What are you doing?! He's not the enemeow!"
msgstr "你干什么？！他不是敌喵！"

#. GTT pool 0x1c79f38b block 0x18b0 (id 0xc4, record 192), budget 46 B
#: gtt/0x1c79f38b/0x18b0/0
msgid "I'm getting some familiar vibes from this one."
msgstr "这家伙给我一种熟悉的感觉。"

#. GTT pool 0x1c79f38b block 0x18b0 (id 0xc4, record 192), budget 38 B
#: gtt/0x1c79f38b/0x18b0/1
msgid "Like he was born to fight, same as us."
msgstr ""

#. GTT pool 0x1c79f38b block 0x1980 (id 0xd5, record 192), budget 57 B
#: gtt/0x1c79f38b/0x1980/0
msgid "Fascinating...I can see the logic in the creature's form."
msgstr "有意思……我能看出这生物构造中的逻辑。"

#. GTT pool 0x1c79f38b block 0x1980 (id 0xd5, record 192), budget 46 B
#: gtt/0x1c79f38b/0x1980/1
msgid "I might even be able to apply it in my work..."
msgstr "说不定还能用到我的工作里……"

#. GTT pool 0x1c79f38b block 0x1a60 (id 0xb1, record 192), budget 38 B
#: gtt/0x1c79f38b/0x1a60/0
msgid "Is that a fierce-looking UMA or what?!"
msgstr ""

#. GTT pool 0x1c79f38b block 0x1a60 (id 0xb1, record 192), budget 32 B
#: gtt/0x1c79f38b/0x1a60/1
msgid "It's like some fighting machine!"
msgstr "简直像台战斗机器！"

#. GTT pool 0x1c79f38b block 0x1b20 (id 0xb6, record 192), budget 36 B
#: gtt/0x1c79f38b/0x1b20/0
msgid "Maybe Gear REX is sounding the alarm"
msgstr "也许霸王是在发出警告"

#. GTT pool 0x1c79f38b block 0x1b20 (id 0xb6, record 192), budget 44 B
#: gtt/0x1c79f38b/0x1b20/1
msgid "over man's destruction of the environment..."
msgstr "针对人类对环境的破坏……"

#. GTT pool 0x1c79f38b block 0x1be0 (id 0xa3, record 192), budget 43 B
#: gtt/0x1c79f38b/0x1be0/0
msgid "You think you can capture that thing alive?"
msgstr "你觉得你能活捉那东西？"

#. GTT pool 0x1c79f38b block 0x1be0 (id 0xa3, record 192), budget 30 B
#: gtt/0x1c79f38b/0x1be0/1
msgid "I'd love to take a look at it!"
msgstr "我倒想好好看看它！"

#. GTT pool 0x1c79f38b block 0x1c90 (id 0xa3, record 192), budget 22 B
#: gtt/0x1c79f38b/0x1c90/0
msgid "This beast is too big!"
msgstr "这野兽太大了！"

#. GTT pool 0x1c79f38b block 0x1c90 (id 0xa3, record 192), budget 37 B
#: gtt/0x1c79f38b/0x1c90/1
msgid "The stun rod's not having any effect!"
msgstr "电击棒完全没效果！"

#. GTT pool 0x1c79f38b block 0x1d40 (id 0xdc, record 192), budget 67 B
#: gtt/0x1c79f38b/0x1d40/0
msgid "I guess these big monsters get immune to the stun rod pretty quick."
msgstr "看来这些大怪物很快就对电击棒免疫了。"

#. GTT pool 0x1c79f38b block 0x1d40 (id 0xdc, record 192), budget 46 B
#: gtt/0x1c79f38b/0x1d40/1
msgid "You'll have to think of another way to attack."
msgstr "你得想别的办法攻击。"

#. GTT pool 0x1c79f38b block 0x1e20 (id 0xf1, record 192), budget 18 B
#: gtt/0x1c79f38b/0x1e20/0
msgid "That's a BBQ spit."
msgstr ""

#. GTT pool 0x1c79f38b block 0x1e20 (id 0xf1, record 192), budget 43 B
#: gtt/0x1c79f38b/0x1e20/1
msgid "You can use it to roast food, even rations,"
msgstr "你能用它烤食物，连口粮也行，"

#. GTT pool 0x1c79f38b block 0x1e20 (id 0xf1, record 192), budget 27 B
#: gtt/0x1c79f38b/0x1e20/2
msgid "simply by pressing <I=ACT>."
msgstr "只需按<I=ACT>。"

#. GTT pool 0x1c79f38b block 0x1f20 (id 0x7a, record 192), budget 46 B
#: gtt/0x1c79f38b/0x1f20/0
msgid "To stop roasting, press <I=ACT> one more time."
msgstr "要停止烧烤，再按一次<I=ACT>。"

#. GTT pool 0x1c79f38b block 0x1fa0 (id 0x65, record 192), budget 28 B
#: gtt/0x1c79f38b/0x1fa0/0
msgid "Hey, your food it's burning!"
msgstr "喂，你食物烧焦了！"

#. GTT pool 0x1c79f38b block 0x2010 (id 0x93, record 192), budget 64 B
#: gtt/0x1c79f38b/0x2010/0
msgid "Cooking meat is all about timing! Same when it comes to rations."
msgstr "烤肉全靠时机！口粮也一样。"

#. GTT pool 0x1c79f38b block 0x20b0 (id 0x7c, record 192), budget 67 B
#: gtt/0x1c79f38b/0x20b0/0
msgid "I would love to cook some chicken on that cooker of yours sometime."
msgstr "改天我真想用你那烤架烤点鸡肉。"

#. GTT pool 0x1c79f38b block 0x2130 (id 0xbf, record 192), budget 53 B
#: gtt/0x1c79f38b/0x2130/0
msgid "Now, don't overcook it or not only will it taste bad,"
msgstr "别烤过头，不然不光难吃，"

#. GTT pool 0x1c79f38b block 0x2130 (id 0xbf, record 192), budget 21 B
#: gtt/0x1c79f38b/0x2130/1
msgid "it'll be bad for you."
msgstr "还对身体不好。"

#. GTT pool 0x1c79f38b block 0x21f0 (id 0xb8, record 192), budget 46 B
#: gtt/0x1c79f38b/0x21f0/0
msgid "Cold rations aren't very appetizing, are they?"
msgstr "冷口粮不太好吃吧？"

#. GTT pool 0x1c79f38b block 0x21f0 (id 0xb8, record 192), budget 42 B
#: gtt/0x1c79f38b/0x21f0/1
msgid "I'm sure they'll be much better heated up."
msgstr "热一热肯定好多了。"

#. GTT pool 0x1c79f38b block 0x22b0 (id 0x8d, record 192), budget 70 B
#: gtt/0x1c79f38b/0x22b0/0
msgid "That's an awfully crude way to cook - you sure it's going to turn out?"
msgstr "这做法也太糙了，你确定能成？"

#. GTT pool 0x1c79f38b block 0x2340 (id 0x53, record 192), budget 17 B
#: gtt/0x1c79f38b/0x2340/0
msgid "Mmm! Looks tasty!"
msgstr ""

#. GTT pool 0x1c79f38b block 0x25e0 (id 0x51, record 192), budget 15 B
#: gtt/0x1c79f38b/0x25e0/0
msgid "Target is down!"
msgstr ""

#. GTT pool 0x1c79f38b block 0x2640 (id 0x4e, record 192), budget 20 B
#: gtt/0x1c79f38b/0x2640/0
msgid "Nice huntin', Snake!"
msgstr ""

#. GTT pool 0x1c79f38b block 0x2690 (id 0x6b, record 192), budget 28 B
#: gtt/0x1c79f38b/0x2690/0
msgid "Hunt's over! Return to base."
msgstr "狩猎结束！回基地。"

#. GTT pool 0x1c79f38b block 0x2700 (id 0x93, record 192), budget 7 B
#: gtt/0x1c79f38b/0x2700/0
msgid "Got it!"
msgstr ""

#. GTT pool 0x1c79f38b block 0x2700 (id 0x93, record 192), budget 44 B
#: gtt/0x1c79f38b/0x2700/1
msgid "You sure know how to bag the big ones, Boss!"
msgstr "你真会猎大家伙，BOSS！"

#. GTT pool 0x1c79f38b block 0x27a0 (id 0xb7, record 192), budget 24 B
#: gtt/0x1c79f38b/0x27a0/0
msgid "Yes! Now that's a prize."
msgstr ""

#. GTT pool 0x1c79f38b block 0x27a0 (id 0xb7, record 192), budget 58 B
#: gtt/0x1c79f38b/0x27a0/1
msgid "Only a master hunter could bring something like that down!"
msgstr "只有大师级猎手才能放倒那玩意儿！"

#. GTT pool 0x1c79f38b block 0x2860 (id 0x8f, record 192), budget 59 B
#: gtt/0x1c79f38b/0x2860/0
msgid "Look at this guy's skin...might make a decent camo pattern."
msgstr "看这皮……也许能做不错的迷彩。"

#. GTT pool 0x1c79f38b block 0x28f0 (id 0x91, record 192), budget 67 B
#: gtt/0x1c79f38b/0x28f0/0
msgid "Whoa, nice fangs! Once they sink into something, they don't let go!"
msgstr "哇，好牙！一旦咬住就不松口！"

#. GTT pool 0x1c79f38b block 0x2990 (id 0x94, record 192), budget 81 B
#: gtt/0x1c79f38b/0x2990/0
msgid "This thing's just charging like a bull. Maybe if you acted like a bullfighter...?"
msgstr "这家伙像公牛一样冲。你学学斗牛士试试？"

#. GTT pool 0x1c79f38b block 0x2a30 (id 0xc7, record 192), budget 38 B
#: gtt/0x1c79f38b/0x2a30/0
msgid "I don't think this is the last of 'em."
msgstr "我觉得这还不是最后一只。"

#. GTT pool 0x1c79f38b block 0x2a30 (id 0xc7, record 192), budget 59 B
#: gtt/0x1c79f38b/0x2a30/1
msgid "There could be a second or even third Gear REX out there..."
msgstr "可能还有第二甚至第三只霸王……"

#. GTT pool 0x1c79f38b block 0x2b00 (id 0xa2, record 192), budget 48 B
#: gtt/0x1c79f38b/0x2b00/0
msgid "Figures there'd be a giant monster in a volcano."
msgstr "火山里有巨型怪物，不奇怪。"

#. GTT pool 0x1c79f38b block 0x2b00 (id 0xa2, record 192), budget 13 B
#: gtt/0x1c79f38b/0x2b00/1
msgid "Take it down!"
msgstr "放倒它！"

#. GTT pool 0x1c79f38b block 0x2bb0 (id 0x8d, record 192), budget 65 B
#: gtt/0x1c79f38b/0x2bb0/0
msgid "You have to stop Gear REX. It's up to you to protect Mother Base!"
msgstr "必须阻止霸王。保护母基地就靠你了！"

#. GTT pool 0x1c79f3cb block 0x0 (id 0x65, record 186), budget 34 B
#: gtt/0x1c79f3cb/0x0/0
msgid "Now, yank out those memory boards!"
msgstr "现在，拔出记忆板！"

#. GTT pool 0x1c79f3cb block 0x70 (id 0x6c, record 186), budget 38 B
#: gtt/0x1c79f3cb/0x70/0
msgid "Each memory board has its own purpose."
msgstr "每块记忆板各有用途。"

#. GTT pool 0x1c79f3cb block 0xe0 (id 0xa9, record 186), budget 84 B
#: gtt/0x1c79f3cb/0xe0/0
msgid "Attacking certain parts should trigger a reaction in the corresponding memory board."
msgstr "攻击特定部位应能触发对应记忆板的反应。"

#. GTT pool 0x1c79f3cb block 0x190 (id 0xb4, record 186), budget 32 B
#: gtt/0x1c79f3cb/0x190/0
msgid "Too big a shock from the outside"
msgstr "外部冲击太大"

#. GTT pool 0x1c79f3cb block 0x190 (id 0xb4, record 186), budget 41 B
#: gtt/0x1c79f3cb/0x190/1
msgid "may make it harder to extract the boards."
msgstr "可能更难取出记忆板。"

#. GTT pool 0x1c79f3cb block 0x250 (id 0x89, record 186), budget 61 B
#: gtt/0x1c79f3cb/0x250/0
msgid "Pull out all the AI's memory boards before the pod's ejected!"
msgstr "在舱体弹出前拔出所有AI存储板！"

#. GTT pool 0x1c79f3cb block 0x2e0 (id 0xc2, record 186), budget 35 B
#: gtt/0x1c79f3cb/0x2e0/0
msgid "The black memory boards are locked."
msgstr "黑色存储板被锁住了。"

#. GTT pool 0x1c79f3cb block 0x2e0 (id 0xc2, record 186), budget 41 B
#: gtt/0x1c79f3cb/0x2e0/1
msgid "Go after the boards with icons over them."
msgstr "去拔上方有图标的存储板。"

#. GTT pool 0x1c79f3cb block 0x3b0 (id 0xa7, record 186), budget 87 B
#: gtt/0x1c79f3cb/0x3b0/0
msgid "You can unlock memory boards by destroying the mechanical components that they control."
msgstr "摧毁存储板控制的机械部件即可解锁。"

#. GTT pool 0x1c79f3cb block 0x460 (id 0x9e, record 186), budget 61 B
#: gtt/0x1c79f3cb/0x460/0
msgid "Any boards you remove can be used to build our own AI weapon."
msgstr "拔下的存储板可用来造我们的AI兵器。"

#. GTT pool 0x1c79f3cb block 0x500 (id 0xdc, record 186), budget 82 B
#: gtt/0x1c79f3cb/0x500/0
msgid "Memory boards have different functions according to the icons displayed over them."
msgstr "存储板功能不同，看上方图标便知。"

#. GTT pool 0x1c79f3cb block 0x500 (id 0xdc, record 186), budget 42 B
#: gtt/0x1c79f3cb/0x500/1
msgid "Go ahead and take whichever ones you want."
msgstr "想要哪个就尽管拿吧。"

#. GTT pool 0x1c79f3cb block 0x5e0 (id 0x6e, record 186), budget 40 B
#: gtt/0x1c79f3cb/0x5e0/0
msgid "Pull out all the unlocked memory boards!"
msgstr "拔出所有已解锁的存储板！"

#. GTT pool 0x1c79f3cb block 0x650 (id 0xb9, record 186), budget 27 B
#: gtt/0x1c79f3cb/0x650/0
msgid "Pull out the memory boards!"
msgstr "拔出存储板！"

#. GTT pool 0x1c79f3cb block 0x650 (id 0xb9, record 186), budget 50 B
#: gtt/0x1c79f3cb/0x650/1
msgid "All the unlocked boards will have icons over them."
msgstr "已解锁的存储板上方都有图标。"

#. GTT pool 0x1c79f3cb block 0x710 (id 0xd2, record 186), budget 51 B
#: gtt/0x1c79f3cb/0x710/0
msgid "If you attack parts on the exterior of the machine,"
msgstr "攻击机体外部的部件，"

#. GTT pool 0x1c79f3cb block 0x710 (id 0xd2, record 186), budget 59 B
#: gtt/0x1c79f3cb/0x710/1
msgid "the memory boards that control those parts should light up."
msgstr "控制那些部件的存储板就会亮起。"

#. GTT pool 0x1c79f3cb block 0x7f0 (id 0x98, record 186), budget 80 B
#: gtt/0x1c79f3cb/0x7f0/0
msgid "You can tell what a memory board does by looking at its color when it lights up."
msgstr "看存储板亮起的颜色便知其功能。"

#. GTT pool 0x1c79f3cb block 0x890 (id 0x62, record 186), budget 27 B
#: gtt/0x1c79f3cb/0x890/0
msgid "No good, that one's broken!"
msgstr "不行，那块坏了！"

#. GTT pool 0x1c79f3cb block 0x900 (id 0x61, record 186), budget 31 B
#: gtt/0x1c79f3cb/0x900/0
msgid "Forget about any broken boards."
msgstr "坏掉的板就别管了。"

#. GTT pool 0x1c79f3cb block 0x970 (id 0x67, record 186), budget 32 B
#: gtt/0x1c79f3cb/0x970/0
msgid "What? What's a tape doing there?"
msgstr ""

#. GTT pool 0x1c79f3cb block 0x9e0 (id 0x4e, record 186), budget 13 B
#: gtt/0x1c79f3cb/0x9e0/0
msgid "Another tape?"
msgstr ""

#. GTT pool 0x1c79f3cb block 0xa30 (id 0x85, record 186), budget 61 B
#: gtt/0x1c79f3cb/0xa30/0
msgid "Attack different areas of the exterior to disengage the lock."
msgstr "攻击外部不同部位来解除锁定。"

#. GTT pool 0x1c79f3cb block 0xb60 (id 0x8c, record 186), budget 57 B
#: gtt/0x1c79f3cb/0xb60/0
msgid "Don't attack the AI pod! You'll damage the memory boards!"
msgstr "别打AI舱！会损坏存储板！"

#. GTT pool 0x1c79f3cb block 0xbf0 (id 0x75, record 186), budget 45 B
#: gtt/0x1c79f3cb/0xbf0/0
msgid "Watch your aim! We'll lose the memory boards!"
msgstr "瞄准点！别弄丢存储板！"

#. GTT pool 0x1c79f3cb block 0xd20 (id 0x89, record 186), budget 69 B
#: gtt/0x1c79f3cb/0xd20/0
msgid "You can't pull out a broken board. Watch out for any changes in them."
msgstr "坏板拔不出来。留意它们的变化。"

#. GTT pool 0x1c79f3cb block 0xdb0 (id 0x7c, record 186), budget 50 B
#: gtt/0x1c79f3cb/0xdb0/0
msgid "That one's locked. You'll have to unlock it first."
msgstr "那块锁住了，得先解锁。"

#. GTT pool 0x1c79f3cb block 0xe30 (id 0x5e, record 186), budget 27 B
#: gtt/0x1c79f3cb/0xe30/0
msgid "So... You found the tape..."
msgstr ""

#. GTT pool 0x1c79f3cb block 0xe90 (id 0xa2, record 186), budget 13 B
#: gtt/0x1c79f3cb/0xe90/0
msgid "What is that?"
msgstr "那啥？"

#. GTT pool 0x1c79f3cb block 0xe90 (id 0xa2, record 186), budget 27 B
#: gtt/0x1c79f3cb/0xe90/1
msgid "You mind if I listen to it?"
msgstr "介意我听听吗？"

#. GTT pool 0x1c79f3cb block 0xe90 (id 0xa2, record 186), budget 8 B
#: gtt/0x1c79f3cb/0xe90/2
msgid "Please?!"
msgstr ""

#. GTT pool 0x1c79f3cb block 0xf40 (id 0x61, record 186), budget 30 B
#: gtt/0x1c79f3cb/0xf40/0
msgid "Pull out the AI memory boards!"
msgstr "拔出AI存储板！"

#. GTT pool 0x1c79f3cb block 0xfb0 (id 0xc4, record 186), budget 38 B
#: gtt/0x1c79f3cb/0xfb0/0
msgid "There are four types of memory boards:"
msgstr "记忆板有四种："

#. GTT pool 0x1c79f3cb block 0xfb0 (id 0xc4, record 186), budget 45 B
#: gtt/0x1c79f3cb/0xfb0/1
msgid "\"Attack,\" \"Control,\" \"Mobility,\" and \"Sense.\""
msgstr "\"攻击\"\"控制\"\"机动\"与\"感知\"。"

#. GTT pool 0x1c79f3cb block 0x1080 (id 0x42, record 186), budget 8 B
#: gtt/0x1c79f3cb/0x1080/0
msgid "Jack...!"
msgstr ""

#. GTT pool 0x1c79f3cb block 0x10d0 (id 0xa0, record 186), budget 8 B
#: gtt/0x1c79f3cb/0x10d0/0
msgid "Go home!"
msgstr ""

#. GTT pool 0x1c79f3cb block 0x10d0 (id 0xa0, record 186), budget 26 B
#: gtt/0x1c79f3cb/0x10d0/1
msgid "I'm not your Boss anymore!"
msgstr "我不再是你的BOSS！"

#. GTT pool 0x1c79f3cb block 0x12b0 (id 0xae, record 186), budget 32 B
#: gtt/0x1c79f3cb/0x12b0/0
msgid "What is this... this response..."
msgstr "这是……这反应……"

#. GTT pool 0x1c79f3cb block 0x12b0 (id 0xae, record 186), budget 9 B
#: gtt/0x1c79f3cb/0x12b0/1
msgid "Oh god..."
msgstr ""

#. GTT pool 0x1c79f3cb block 0x12b0 (id 0xae, record 186), budget 12 B
#: gtt/0x1c79f3cb/0x12b0/2
msgid "Discontinue!"
msgstr "中止！"

#. GTT pool 0x1c79f3cb block 0x1360 (id 0x109, record 186), budget 42 B
#: gtt/0x1c79f3cb/0x1360/0
msgid "I've been waiting, Snake, for a long time."
msgstr "我一直在等，SNAKE，等了很久。"

#. GTT pool 0x1c79f3cb block 0x1360 (id 0x109, record 186), budget 36 B
#: gtt/0x1c79f3cb/0x1360/1
msgid "Waiting for your birth, your growth,"
msgstr "等待你出生、成长，"

#. GTT pool 0x1c79f3cb block 0x1360 (id 0x109, record 186), budget 26 B
#: gtt/0x1c79f3cb/0x1360/2
msgid "and the finality of today."
msgstr "直到今日的终结。"

#. GTT pool 0x1c79f3cb block 0x1360 (id 0x109, record 186), budget 7 B
#: gtt/0x1c79f3cb/0x1360/3
msgid "Boss..."
msgstr ""

#. GTT pool 0x1c79f3cb block 0x1470 (id 0x4d6, record 186), budget 59 B
#: gtt/0x1c79f3cb/0x1470/0
msgid "I didn't raise you and shape you into the man you are today"
msgstr "我养你育你，把你塑造成今天的样子，"

#. GTT pool 0x1c79f3cb block 0x1470 (id 0x4d6, record 186), budget 43 B
#: gtt/0x1c79f3cb/0x1470/1
msgid "just so we could face each other in battle."
msgstr "不是为了让我们战场相见。"

#. GTT pool 0x1c79f3cb block 0x1470 (id 0x4d6, record 186), budget 59 B
#: gtt/0x1c79f3cb/0x1470/2
msgid "A soldier's skills aren't meant to be used to hurt friends."
msgstr "士兵的本领不该用来伤害朋友。"

#. GTT pool 0x1c79f3cb block 0x1470 (id 0x4d6, record 186), budget 25 B
#: gtt/0x1c79f3cb/0x1470/3
msgid "So then what is an enemy?"
msgstr "那什么才是敌人？"

#. GTT pool 0x1c79f3cb block 0x1470 (id 0x4d6, record 186), budget 52 B
#: gtt/0x1c79f3cb/0x1470/4
msgid "Is there such a thing as an absolute timeless enemy?"
msgstr "存在绝对且永恒的敌人吗？"

#. GTT pool 0x1c79f3cb block 0x1470 (id 0x4d6, record 186), budget 42 B
#: gtt/0x1c79f3cb/0x1470/5
msgid "There is no such thing and never has been."
msgstr "从来没有，过去也不曾有。"

#. GTT pool 0x1c79f3cb block 0x1470 (id 0x4d6, record 186), budget 60 B
#: gtt/0x1c79f3cb/0x1470/6
msgid "And the reason is that our enemies are human beings like us."
msgstr "因为敌人也是和我们一样的人。"

#. GTT pool 0x1c79f3cb block 0x1470 (id 0x4d6, record 186), budget 47 B
#: gtt/0x1c79f3cb/0x1470/7
msgid "They can only be our enemies in relative terms."
msgstr "他们只是相对而言的敌人。"

#. GTT pool 0x1c79f3cb block 0x1470 (id 0x4d6, record 186), budget 35 B
#: gtt/0x1c79f3cb/0x1470/8
msgid "The world must be made whole again."
msgstr "世界必须重归完整。"

#. GTT pool 0x1c79f3cb block 0x1470 (id 0x4d6, record 186), budget 34 B
#: gtt/0x1c79f3cb/0x1470/9
msgid "The Philosophers must be reunited."
msgstr "哲学家们必须重聚。"

#. GTT pool 0x1c79f3cb block 0x1470 (id 0x4d6, record 186), budget 40 B
#: gtt/0x1c79f3cb/0x1470/10
msgid "I will devote my skills to that purpose."
msgstr "我将为此献上我的本领。"

#. GTT pool 0x1c79f3cb block 0x1470 (id 0x4d6, record 186), budget 54 B
#: gtt/0x1c79f3cb/0x1470/11
msgid "And with the Colonel's money, I will achieve that end."
msgstr "用上校的钱，我必将达成此愿。"

#. GTT pool 0x1c79f3cb block 0x1470 (id 0x4d6, record 186), budget 34 B
#: gtt/0x1c79f3cb/0x1470/12
msgid "Just as I once created the Cobras."
msgstr "正如我曾创立眼镜蛇。"

#. GTT pool 0x1c79f3cb block 0x1470 (id 0x4d6, record 186), budget 19 B
#: gtt/0x1c79f3cb/0x1470/13
msgid "They are my family."
msgstr ""

#. GTT pool 0x1c79f3cb block 0x1470 (id 0x4d6, record 186), budget 40 B
#: gtt/0x1c79f3cb/0x1470/14
msgid "I may no longer be able to bear children"
msgstr "我也许再不能生育，"

#. GTT pool 0x1c79f3cb block 0x1470 (id 0x4d6, record 186), budget 26 B
#: gtt/0x1c79f3cb/0x1470/15
msgid "but I still have a family."
msgstr "但我仍有家人。"

#. GTT pool 0x1c79f3cb block 0x1950 (id 0x363, record 186), budget 13 B
#: gtt/0x1c79f3cb/0x1950/0
msgid "I raised you."
msgstr ""

#. GTT pool 0x1c79f3cb block 0x1950 (id 0x363, record 186), budget 12 B
#: gtt/0x1c79f3cb/0x1950/1
msgid "I loved you."
msgstr ""

#. GTT pool 0x1c79f3cb block 0x1950 (id 0x363, record 186), budget 46 B
#: gtt/0x1c79f3cb/0x1950/2
msgid "I've given you weapons, taught you techniques,"
msgstr "我给了你武器，教了你技术，"

#. GTT pool 0x1c79f3cb block 0x1950 (id 0x363, record 186), budget 27 B
#: gtt/0x1c79f3cb/0x1950/3
msgid "endowed you with knowledge."
msgstr "赋予了你知识。"

#. GTT pool 0x1c79f3cb block 0x1950 (id 0x363, record 186), budget 41 B
#: gtt/0x1c79f3cb/0x1950/4
msgid "There is nothing more for me to give you."
msgstr "我已没有什么能给你了。"

#. GTT pool 0x1c79f3cb block 0x1950 (id 0x363, record 186), budget 45 B
#: gtt/0x1c79f3cb/0x1950/5
msgid "All that's left for you to take is my life..."
msgstr "剩下的，你只需取走我的命……"

#. GTT pool 0x1c79f3cb block 0x1950 (id 0x363, record 186), budget 20 B
#: gtt/0x1c79f3cb/0x1950/6
msgid "...by your own hand."
msgstr "……亲手取。"

#. GTT pool 0x1c79f3cb block 0x1950 (id 0x363, record 186), budget 31 B
#: gtt/0x1c79f3cb/0x1950/7
msgid "One must die and one must live."
msgstr "一人死，一人活。"

#. GTT pool 0x1c79f3cb block 0x1950 (id 0x363, record 186), budget 22 B
#: gtt/0x1c79f3cb/0x1950/8
msgid "No victory, no defeat."
msgstr "无胜，无败。"

#. GTT pool 0x1c79f3cb block 0x1950 (id 0x363, record 186), budget 37 B
#: gtt/0x1c79f3cb/0x1950/9
msgid "The survivor will carry on the fight."
msgstr "幸存者将继续战斗。"

#. GTT pool 0x1c79f3cb block 0x1950 (id 0x363, record 186), budget 24 B
#: gtt/0x1c79f3cb/0x1950/10
msgid ""
"\n"
"\n"
"It is our destiny..."
msgstr "\n\n宿命……"

#. GTT pool 0x1c79f3cb block 0x1950 (id 0x363, record 186), budget 52 B
#: gtt/0x1c79f3cb/0x1950/11
msgid "The one who survives will inherit the title of Boss."
msgstr "活下来的人将继承 BOSS 之名。"

#. GTT pool 0x1c79f3cb block 0x1950 (id 0x363, record 186), budget 42 B
#: gtt/0x1c79f3cb/0x1950/12
msgid "And the one who inherits the title of Boss"
msgstr "而继承BOSS之名的人"

#. GTT pool 0x1c79f3cb block 0x1950 (id 0x363, record 186), budget 41 B
#: gtt/0x1c79f3cb/0x1950/13
msgid "will face an existence of endless battle."
msgstr "将面对无尽的战斗。"

#. GTT pool 0x1c79f3cb block 0x1cc0 (id 0x8e, record 186), budget 10 B
#: gtt/0x1c79f3cb/0x1cc0/0
msgid "Kill me..."
msgstr "杀我…"

#. GTT pool 0x1c79f3cb block 0x1cc0 (id 0x8e, record 186), budget 14 B
#: gtt/0x1c79f3cb/0x1cc0/1
msgid "Kill me now..."
msgstr "杀我吧…"

#. GTT pool 0x1c79f3cb block 0x1cc0 (id 0x8e, record 186), budget 6 B
#: gtt/0x1c79f3cb/0x1cc0/2
msgid "Do it."
msgstr ""

#. GTT pool 0x1c79f3cb block 0x1d50 (id 0x8e, record 186), budget 33 B
#: gtt/0x1c79f3cb/0x1d50/0
msgid "There's only room for one Boss..."
msgstr "BOSS 只能有一个……"

#. GTT pool 0x1c79f3cb block 0x1d50 (id 0x8e, record 186), budget 16 B
#: gtt/0x1c79f3cb/0x1d50/1
msgid "And one Snake..."
msgstr "而一蛇……"

#. GTT pool 0x1c79f3cb block 0x1de0 (id 0x73, record 186), budget 44 B
#: gtt/0x1c79f3cb/0x1de0/0
msgid "The quick brown fox jumps over the lazy dog."
msgstr "敏捷的棕狐跃过懒狗。"

#. GTT pool 0x1c79f3cb block 0x1e60 (id 0x70, record 186), budget 41 B
#: gtt/0x1c79f3cb/0x1e60/0
msgid "The lonely fox chases the one-eyed hound."
msgstr "孤独的狐狸追逐独眼猎犬。"

#. GTT pool 0x1c79f3cb block 0x1ed0 (id 0x6a, record 186), budget 47 B
#: gtt/0x1c79f3cb/0x1ed0/0
msgid "Shall we walk through the rainy plain of Spain?"
msgstr "要漫步西班牙的雨原吗？"

#. GTT pool 0x1c79f3cb block 0x1f40 (id 0x128, record 186), budget 35 B
#: gtt/0x1c79f3cb/0x1f40/0
msgid "Kawanishi-noseguchi, Kinunobebashi,"
msgstr "川西能势口、绢延桥、"

#. GTT pool 0x1c79f3cb block 0x1f40 (id 0x128, record 186), budget 37 B
#: gtt/0x1c79f3cb/0x1f40/1
msgid "Takiyama, Uguisunomori, Tsuzumigataki"
msgstr "泷山、莺之森、鼓泷"

#. GTT pool 0x1c79f3cb block 0x1f40 (id 0x128, record 186), budget 26 B
#: gtt/0x1c79f3cb/0x1f40/2
msgid "Tada, Hirano, Ichinotorii,"
msgstr ""

#. GTT pool 0x1c79f3cb block 0x1f40 (id 0x128, record 186), budget 25 B
