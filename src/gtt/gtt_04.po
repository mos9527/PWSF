#. GTT pool 0x1c79f3cb block 0x1080 (id 0x42, record 186), budget 8 B
#: gtt/0x1c79f3cb/0x1080/0
msgid "Jack...!"
msgstr ""

#. GTT pool 0x1c79f3cb block 0x10d0 (id 0xa0, record 186), budget 8 B
#: gtt/0x1c79f3cb/0x10d0/0
msgid "Go home!"
msgstr ""

#. GTT pool 0x1c79f3cb block 0x10d0 (id 0xa0, record 186), budget 26 B
#: gtt/0x1c79f3cb/0x10d0/1
msgid "I'm not your Boss anymore!"
msgstr ""

#. GTT pool 0x1c79f3cb block 0x12b0 (id 0xae, record 186), budget 32 B
#: gtt/0x1c79f3cb/0x12b0/0
msgid "What is this... this response..."
msgstr ""

#. GTT pool 0x1c79f3cb block 0x12b0 (id 0xae, record 186), budget 9 B
#: gtt/0x1c79f3cb/0x12b0/1
msgid "Oh god..."
msgstr ""

#. GTT pool 0x1c79f3cb block 0x12b0 (id 0xae, record 186), budget 12 B
#: gtt/0x1c79f3cb/0x12b0/2
msgid "Discontinue!"
msgstr ""

#. GTT pool 0x1c79f3cb block 0x1360 (id 0x109, record 186), budget 42 B
#: gtt/0x1c79f3cb/0x1360/0
msgid "I've been waiting, Snake, for a long time."
msgstr "我一直在等，SNAKE，等了很久。"

#. GTT pool 0x1c79f3cb block 0x1360 (id 0x109, record 186), budget 36 B
#: gtt/0x1c79f3cb/0x1360/1
msgid "Waiting for your birth, your growth,"
msgstr ""

#. GTT pool 0x1c79f3cb block 0x1360 (id 0x109, record 186), budget 26 B
#: gtt/0x1c79f3cb/0x1360/2
msgid "and the finality of today."
msgstr ""

#. GTT pool 0x1c79f3cb block 0x1360 (id 0x109, record 186), budget 7 B
#: gtt/0x1c79f3cb/0x1360/3
msgid "Boss..."
msgstr ""

#. GTT pool 0x1c79f3cb block 0x1470 (id 0x4d6, record 186), budget 59 B
#: gtt/0x1c79f3cb/0x1470/0
msgid "I didn't raise you and shape you into the man you are today"
msgstr ""

#. GTT pool 0x1c79f3cb block 0x1470 (id 0x4d6, record 186), budget 43 B
#: gtt/0x1c79f3cb/0x1470/1
msgid "just so we could face each other in battle."
msgstr ""

#. GTT pool 0x1c79f3cb block 0x1470 (id 0x4d6, record 186), budget 59 B
#: gtt/0x1c79f3cb/0x1470/2
msgid "A soldier's skills aren't meant to be used to hurt friends."
msgstr ""

#. GTT pool 0x1c79f3cb block 0x1470 (id 0x4d6, record 186), budget 25 B
#: gtt/0x1c79f3cb/0x1470/3
msgid "So then what is an enemy?"
msgstr ""

#. GTT pool 0x1c79f3cb block 0x1470 (id 0x4d6, record 186), budget 52 B
#: gtt/0x1c79f3cb/0x1470/4
msgid "Is there such a thing as an absolute timeless enemy?"
msgstr ""

#. GTT pool 0x1c79f3cb block 0x1470 (id 0x4d6, record 186), budget 42 B
#: gtt/0x1c79f3cb/0x1470/5
msgid "There is no such thing and never has been."
msgstr ""

#. GTT pool 0x1c79f3cb block 0x1470 (id 0x4d6, record 186), budget 60 B
#: gtt/0x1c79f3cb/0x1470/6
msgid "And the reason is that our enemies are human beings like us."
msgstr ""

#. GTT pool 0x1c79f3cb block 0x1470 (id 0x4d6, record 186), budget 47 B
#: gtt/0x1c79f3cb/0x1470/7
msgid "They can only be our enemies in relative terms."
msgstr ""

#. GTT pool 0x1c79f3cb block 0x1470 (id 0x4d6, record 186), budget 35 B
#: gtt/0x1c79f3cb/0x1470/8
msgid "The world must be made whole again."
msgstr ""

#. GTT pool 0x1c79f3cb block 0x1470 (id 0x4d6, record 186), budget 34 B
#: gtt/0x1c79f3cb/0x1470/9
msgid "The Philosophers must be reunited."
msgstr ""

#. GTT pool 0x1c79f3cb block 0x1470 (id 0x4d6, record 186), budget 40 B
#: gtt/0x1c79f3cb/0x1470/10
msgid "I will devote my skills to that purpose."
msgstr ""

#. GTT pool 0x1c79f3cb block 0x1470 (id 0x4d6, record 186), budget 54 B
#: gtt/0x1c79f3cb/0x1470/11
msgid "And with the Colonel's money, I will achieve that end."
msgstr ""

#. GTT pool 0x1c79f3cb block 0x1470 (id 0x4d6, record 186), budget 34 B
#: gtt/0x1c79f3cb/0x1470/12
msgid "Just as I once created the Cobras."
msgstr ""

#. GTT pool 0x1c79f3cb block 0x1470 (id 0x4d6, record 186), budget 19 B
#: gtt/0x1c79f3cb/0x1470/13
msgid "They are my family."
msgstr ""

#. GTT pool 0x1c79f3cb block 0x1470 (id 0x4d6, record 186), budget 40 B
#: gtt/0x1c79f3cb/0x1470/14
msgid "I may no longer be able to bear children"
msgstr ""

#. GTT pool 0x1c79f3cb block 0x1470 (id 0x4d6, record 186), budget 26 B
#: gtt/0x1c79f3cb/0x1470/15
msgid "but I still have a family."
msgstr ""

#. GTT pool 0x1c79f3cb block 0x1950 (id 0x363, record 186), budget 13 B
#: gtt/0x1c79f3cb/0x1950/0
msgid "I raised you."
msgstr ""

#. GTT pool 0x1c79f3cb block 0x1950 (id 0x363, record 186), budget 12 B
#: gtt/0x1c79f3cb/0x1950/1
msgid "I loved you."
msgstr ""

#. GTT pool 0x1c79f3cb block 0x1950 (id 0x363, record 186), budget 46 B
#: gtt/0x1c79f3cb/0x1950/2
msgid "I've given you weapons, taught you techniques,"
msgstr ""

#. GTT pool 0x1c79f3cb block 0x1950 (id 0x363, record 186), budget 27 B
#: gtt/0x1c79f3cb/0x1950/3
msgid "endowed you with knowledge."
msgstr ""

#. GTT pool 0x1c79f3cb block 0x1950 (id 0x363, record 186), budget 41 B
#: gtt/0x1c79f3cb/0x1950/4
msgid "There is nothing more for me to give you."
msgstr "我已没有什么能给你了。"

