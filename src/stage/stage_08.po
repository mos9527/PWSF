#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x48404d/0x000002
#: stage/168/lang_gameover_en.olang/0x48404d/0x000002
msgid "We'll put the operation on hold."
msgstr "行动先搁置。"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x484051/0x000000
#: stage/168/lang_gameover_en.olang/0x484051/0x000000
msgid "Looks like you're out of ammo."
msgstr "看来你没弹药了。"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x484051/0x000001
#: stage/168/lang_gameover_en.olang/0x484051/0x000001
msgid "Maybe I underestimated... Anyway, back to base."
msgstr "也许是我低估了…总之，回基地。"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x4840e5/0x000000
#: stage/168/lang_gameover_en.olang/0x4840e5/0x000000
msgid "Aaaaaaaaaah!"
msgstr "啊啊啊啊啊！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x484141/0x000000
#: stage/168/lang_gameover_en.olang/0x484141/0x000000
msgid "Everyone, get those fires out! Dammit - we'll never catch up! Argh!"
msgstr "快灭火！该死，追不上了！呃啊！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x484145/0x000000
#: stage/168/lang_gameover_en.olang/0x484145/0x000000
msgid "Mom... Is that you, Mom...? Aarrgh!!"
msgstr "妈妈…是你吗，妈妈…？啊啊啊！！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x484149/0x000000
#: stage/168/lang_gameover_en.olang/0x484149/0x000000
msgid "What are you doing? I told you to keep him alive!"
msgstr "你在干什么？我说了要留活口！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x48414d/0x000000
#: stage/168/lang_gameover_en.olang/0x48414d/0x000000
msgid "They spotted you? Training is over - come on back."
msgstr "被发现了？训练结束——回来吧。"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x4841d9/0x000000
#: stage/168/lang_gameover_en.olang/0x4841d9/0x000000
msgid "No! They got the researcher - mission failed!"
msgstr "不！研究员被抓，任务失败！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x486feb/0x000000
#: stage/168/lang_gameover_en.olang/0x486feb/0x000000
msgid "Time's up. You failed the mission."
msgstr "时间到。任务失败。"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x487047/0x000000
#: stage/168/lang_gameover_en.olang/0x487047/0x000000
msgid "You're out of time... Mission incomplete..."
msgstr "时间不够了…任务未完成…"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x48704b/0x000000
#: stage/168/lang_gameover_en.olang/0x48704b/0x000000
msgid "Forget it, you'll never make it in time. The mission's over."
msgstr "算了，你赶不上了。任务结束。"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x48d0eb/0x000000
#: stage/168/lang_gameover_en.olang/0x48d0eb/0x000000
msgid "Snake... Peace Walker launched the nuke."
msgstr ""

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x48d147/0x000000
#: stage/168/lang_gameover_en.olang/0x48d147/0x000000
msgid "Snake... The nuke was launched."
msgstr "SNAKE…核弹发射了。"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x48d147/0x000001
#: stage/168/lang_gameover_en.olang/0x48d147/0x000001
msgid "Those bastards from the Pentagon just plunged the world into a nuclear apocalypse!"
msgstr "五角大楼那帮混蛋把世界推入了核浩劫！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x48d14b/0x000000
#: stage/156/lang_gameover_en.olang/0x48d14c/0x000000
#: stage/156/lang_gameover_en.olang/0x48d14d/0x000000
#: stage/156/lang_gameover_en.olang/0x48d14e/0x000000
#: stage/156/lang_gameover_en.olang/0x48d14f/0x000000
#: stage/156/lang_gameover_en.olang/0x48d150/0x000000
#: stage/168/lang_gameover_en.olang/0x48d14b/0x000000
#: stage/168/lang_gameover_en.olang/0x48d14c/0x000000
#: stage/168/lang_gameover_en.olang/0x48d14d/0x000000
#: stage/168/lang_gameover_en.olang/0x48d14e/0x000000
#: stage/168/lang_gameover_en.olang/0x48d14f/0x000000
#: stage/168/lang_gameover_en.olang/0x48d150/0x000000
msgid "The mission's a failure. Return to base!"
msgstr "任务失败。返回基地！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x584def/0x000000
#: stage/168/lang_gameover_en.olang/0x584def/0x000000
msgid "Snake, what happened?! Say something! Snaaaaaaake!"
msgstr "SNAKE，怎么了？！说话！SNAAAAAAKE！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x584df3/0x000000
#: stage/168/lang_gameover_en.olang/0x584df3/0x000000
msgid "This can't be happening... Tell me you're OK, Snake! Snaaaake!"
msgstr "这不可能…告诉我你没事，SNAKE！SNAAAKE！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x584df7/0x000000
#: stage/168/lang_gameover_en.olang/0x584df7/0x000000
msgid "Get up, Snake! Without you, Costa Rica's finished! Snaaake!"
msgstr "起来，SNAKE！没有你，哥斯达黎加就完了！SNAAAKE！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x584dfb/0x000000
#: stage/168/lang_gameover_en.olang/0x584dfb/0x000000
msgid "What happened?! Say something!"
msgstr "怎么了？！说话！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x584dff/0x000000
#: stage/168/lang_gameover_en.olang/0x584dff/0x000000
msgid "No, don't tell me... I don't want to see anyone else die!"
msgstr "不，别告诉我…我不想再看到有人死了！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x584e03/0x000000
#: stage/168/lang_gameover_en.olang/0x584e03/0x000000
msgid "Please, get up! Costa Rica needs you!"
msgstr "求你了，起来！哥斯达黎加需要你！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x5f2371/0x000000
#: stage/168/lang_gameover_en.olang/0x5f2371/0x000000
msgid "Paz (Tara Strong)"
msgstr "帕兹（Tara Strong）"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x6df642/0x000000
#: stage/168/lang_gameover_en.olang/0x6df642/0x000000
msgid "What happened, Snake?! Snaaaaaaaake!"
msgstr "怎么了，SNAKE？！SNAAAAAAKE！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x6df646/0x000000
#: stage/168/lang_gameover_en.olang/0x6df646/0x000000
msgid "This cannot be... Snake!"
msgstr "这不可能……SNAKE！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x6df646/0x000001
#: stage/168/lang_gameover_en.olang/0x6df646/0x000001
msgid "There is so much more I wanted to learn from you... Snaaaaaake!"
msgstr "我还想从你身上学好多东西……SNAAAAAAKE！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x6df64a/0x000000
#: stage/168/lang_gameover_en.olang/0x6df64a/0x000000
msgid "Get up, Snake, please! I cannot lose another comandante! Snaaaaaake!"
msgstr "起来，SNAKE，求你了！我不能再失去一个指挥官了！SNAAAAAAKE！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x6df64e/0x000000
#: stage/168/lang_gameover_en.olang/0x6df64e/0x000000
msgid "Snake, no! You were... you were so close!"
msgstr "SNAKE，不要！你……你明明就差一点了！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x6df652/0x000000
#: stage/168/lang_gameover_en.olang/0x6df652/0x000000
msgid "What happened?! Can you hear me? Say something!"
msgstr "怎么了？！能听见我吗？说句话！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x6df6ae/0x000000
#: stage/168/lang_gameover_en.olang/0x6df6ae/0x000000
msgid "What is going on? Are you injured? Please, come in!"
msgstr "发生什么了？你受伤了吗？请回答！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x6df6b2/0x000000
#: stage/168/lang_gameover_en.olang/0x6df6b2/0x000000
msgid "No! Talk to me! We still have to liberate Nicaragua together!"
msgstr "不！跟我说话！我们还要一起解放尼加拉瓜！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x6df6b6/0x000000
#: stage/168/lang_gameover_en.olang/0x6df6b6/0x000000
msgid "Snake, return to base! We have to abort."
msgstr "SNAKE，回基地！必须中止。"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x6df6b6/0x000001
#: stage/168/lang_gameover_en.olang/0x6df6b6/0x000001
msgid "Your partner has taken a fall!"
msgstr "你的搭档倒下了！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x6df6ba/0x000000
#: stage/168/lang_gameover_en.olang/0x6df6ba/0x000000
msgid "Snake, we are aborting the operation! "
msgstr "SNAKE，我们中止行动！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x6df6ba/0x000001
#: stage/168/lang_gameover_en.olang/0x6df6ba/0x000001
msgid "Your partner took a fall... How could you take your eyes off our compas?! "
msgstr "你的搭档倒下了……你怎么能不看住同伴？！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x6df6ba/0x000002
#: stage/168/lang_gameover_en.olang/0x6df6ba/0x000002
msgid "You are supposed to be the Boss!"
msgstr "你可是BOSS啊！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x6df6be/0x000000
#: stage/168/lang_gameover_en.olang/0x6df6be/0x000000
msgid "Return to base! We're aborting. "
msgstr "回基地！中止行动。"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x6df6be/0x000001
#: stage/168/lang_gameover_en.olang/0x6df6be/0x000001
msgid "Unfortunately, your partner took a fall..."
msgstr "很遗憾，你的搭档倒下了……"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x6df6c2/0x000000
#: stage/168/lang_gameover_en.olang/0x6df6c2/0x000000
msgid "The operation is aborted. Your partner has taken a fall. "
msgstr "行动中止。你的搭档倒下了。"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x6df6c2/0x000001
#: stage/168/lang_gameover_en.olang/0x6df6c2/0x000001
msgid "Why did this have to happen...?"
msgstr "为什么会这样……？"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x74cb70/0x000000
#: stage/168/lang_gameover_en.olang/0x74cb70/0x000000
msgid "Amanda (Grey DeLisle)"
msgstr "阿曼达（Grey DeLisle）"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x89095a/0x000000
#: stage/168/lang_gameover_en.olang/0x89095a/0x000000
msgid "Snake! What happened?! Snaaaaaake!"
msgstr "SNAKE！怎么了？！SNAAAAAAKE！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x89095e/0x000000
#: stage/168/lang_gameover_en.olang/0x89095e/0x000000
msgid "What is going on?  Snake, Answer me! Snaaake!"
msgstr "怎么了？SNAKE，回答我！SNAAAKE！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x890962/0x000000
#: stage/168/lang_gameover_en.olang/0x890962/0x000000
msgid "The birds are weeping... What happened?  Snake?  "
msgstr "鸟儿在哭泣……怎么了？SNAKE？"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x890962/0x000001
#: stage/168/lang_gameover_en.olang/0x890962/0x000001
msgid "Say something!"
msgstr "说句话！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x890966/0x000000
#: stage/168/lang_gameover_en.olang/0x890966/0x000000
msgid "Snake, get up, please! "
msgstr "SNAKE，起来，求你了！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x890966/0x000001
#: stage/168/lang_gameover_en.olang/0x890966/0x000001
msgid "Here, I'll do a quetzal for you! Kyoooh, kyoooh..."
msgstr "来，我给你学个凤尾绿咬鹃！叽——叽——……"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x89096a/0x000000
#: stage/168/lang_gameover_en.olang/0x89096a/0x000000
msgid "Hey, what happened?! Please, answer me!"
msgstr "喂，怎么了？！回答我！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x89096e/0x000000
#: stage/168/lang_gameover_en.olang/0x89096e/0x000000
msgid "Talk to me! Are you there?  Oh, what happened?"
msgstr "说话！你在吗？哦，怎么了？"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x890972/0x000000
#: stage/168/lang_gameover_en.olang/0x890972/0x000000
msgid "Have you... taken to the skies yourself now?"
msgstr "你……现在也自己飞上天了吗？"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x8909ce/0x000000
#: stage/168/lang_gameover_en.olang/0x8909ce/0x000000
msgid "What do we do, Snake?! Your friend has fallen! Come back immediately!"
msgstr "怎么办，SNAKE？！你的同伴倒下了！马上回来！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x8909d2/0x000000
#: stage/168/lang_gameover_en.olang/0x8909d2/0x000000
msgid "Come back, Snake! Your friend has fallen... If only man had wings..."
msgstr "回来，SNAKE！同伴倒下了……人有翅膀多好……"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x8909d6/0x000000
#: stage/168/lang_gameover_en.olang/0x8909d6/0x000000
msgid "Hurry back! Your friend has fallen! Oh mon Dieu..."
msgstr "快回来！同伴倒下了！哦天哪……"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x8909da/0x000000
#: stage/168/lang_gameover_en.olang/0x8909da/0x000000
msgid "I cannot believe this... Your friend has fallen... Come back!"
msgstr "不敢相信……同伴倒下了……回来！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x8b7462/0x000000
#: stage/168/lang_gameover_en.olang/0x8b7462/0x000000
msgid "Snake, what happened?! Answer me! Snaaaaake!"
msgstr "SNAKE，出什么事了？！回答我！SNAAAAKE！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x8b7466/0x000000
#: stage/168/lang_gameover_en.olang/0x8b7466/0x000000
msgid "Snake! What's going on? We still gotta look for UMAs together! Snaaaaake!"
msgstr "SNAKE！怎么了？我们还得一起找未知生物呢！SNAAAAKE！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x8b746a/0x000000
#: stage/168/lang_gameover_en.olang/0x8b746a/0x000000
msgid "Come on, Snake! You can't just leave us like this! Snaaaaaaake!"
msgstr "别这样，SNAKE！不能丢下我们！SNAAAAAAKE！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x8b746e/0x000000
#: stage/168/lang_gameover_en.olang/0x8b746e/0x000000
msgid "What the heck happened?! Talk to me! Please!"
msgstr "怎么了？！说话啊！求你！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x8b7472/0x000000
#: stage/168/lang_gameover_en.olang/0x8b7472/0x000000
msgid "What's going on?! Can you still hear me? Come in!"
msgstr "怎么了？！还听得到我吗？请回答！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x8b7476/0x000000
#: stage/168/lang_gameover_en.olang/0x8b7476/0x000000
msgid "We were going to go back to Nicaragua together!"
msgstr "我们本来说好一起回尼加拉瓜的！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x8b7476/0x000001
#: stage/168/lang_gameover_en.olang/0x8b7476/0x000001
msgid "Say something! No...!"
msgstr "说句话啊！不……！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x8b747a/0x000000
#: stage/168/lang_gameover_en.olang/0x8b747a/0x000000
msgid "Return to base, Snake! The mission's aborted. Your partner took a fall..."
msgstr "返回基地，SNAKE！任务中止。你的搭档倒下了……"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x8b747e/0x000000
#: stage/168/lang_gameover_en.olang/0x8b747e/0x000000
msgid "Your partner took a fall... Better come back, Snake."
msgstr "你的搭档倒下了……最好回来，SNAKE。"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x8b747e/0x000001
#: stage/168/lang_gameover_en.olang/0x8b747e/0x000001
msgid "Why weren't you watching them?!"
msgstr "你怎么没看好他们？！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x8b7482/0x000000
#: stage/168/lang_gameover_en.olang/0x8b7482/0x000000
msgid "No! It can't be over yet!"
msgstr "不！不能就这么结束！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x8b74de/0x000000
#: stage/168/lang_gameover_en.olang/0x8b74de/0x000000
msgid "Return to base! A compa fell! We gotta reorganize things."
msgstr "回基地！同伴倒下了！得重整。"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x8feb70/0x000000
#: stage/168/lang_gameover_en.olang/0x8feb70/0x000000
msgid "Cécile (Cathrine Taber)"
msgstr "塞西尔（Cathrine Taber）"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x924770/0x000000
#: stage/168/lang_gameover_en.olang/0x924770/0x000000
msgid "Chico (Antony Del Rio)"
msgstr "奇科（Antony Del Rio）"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x953f71/0x000000
#: stage/168/lang_gameover_en.olang/0x953f71/0x000000
msgid "Snake (David Hayter)"
msgstr "SNAKE（David Hayter）"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0xa10742/0x000000
#: stage/168/lang_gameover_en.olang/0xa10742/0x000000
msgid "What's going on? What happened, Snake? Acknowledge! SNA-A-AKE!!"
msgstr "怎么了？出什么事，SNAKE？回答！SNA-A-AKE！！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0xa10746/0x000000
#: stage/168/lang_gameover_en.olang/0xa10746/0x000000
msgid "Don't quit on me now, Snake! You call yourself her disciple?!"
msgstr "别放弃，SNAKE！你自称她弟子？！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0xa1074a/0x000000
#: stage/168/lang_gameover_en.olang/0xa1074a/0x000000
msgid "You disappoint me, Snake... It seems I misjudged you..."
msgstr "你真让我失望，SNAKE……看来是我看错你了……"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0xa1074e/0x000000
#: stage/168/lang_gameover_en.olang/0xa1074e/0x000000
msgid "What's happened? Give me a status report! Acknowledge!"
msgstr "发生了什么？给我状况报告！回答！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0xa10752/0x000000
#: stage/168/lang_gameover_en.olang/0xa10752/0x000000
msgid "Respond, soldier! At least give me a status report... or is it too late..."
msgstr "回答，士兵！至少报个状况……还是已经太迟……"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0xa10756/0x000000
#: stage/168/lang_gameover_en.olang/0xa10756/0x000000
msgid "No... This can't be the right outcome..."
msgstr "不……这不该是正确结果……"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0xa1075a/0x000000
#: stage/168/lang_gameover_en.olang/0xa1075a/0x000000
msgid "Return to base, Snake! Your teammate's had a fall. The mission is aborted!!"
msgstr "回基地，SNAKE！你的队友倒下了。任务中止！！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0xa1075e/0x000000
#: stage/168/lang_gameover_en.olang/0xa1075e/0x000000
msgid "Return to base, your teammate's fallen! Where were you?"
msgstr "回基地，你的队友倒下了！你当时在哪？"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0xa1075e/0x000001
#: stage/168/lang_gameover_en.olang/0xa1075e/0x000001
msgid "SHE would never have abandoned her comrades like that!"
msgstr "她绝不会那样抛弃同伴！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0xa10762/0x000000
#: stage/168/lang_gameover_en.olang/0xa10762/0x000000
msgid "Your companion has fallen. Return to base and regroup!"
msgstr "你的同伴倒下了。回基地重整旗鼓！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0xa107be/0x000000
#: stage/168/lang_gameover_en.olang/0xa107be/0x000000
msgid "Mission aborted, your companion's fallen. Humans are such fragile creatures..."
msgstr "任务中止，你的同伴倒下了。人类真是脆弱的生物……"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0xa7eb70/0x000000
#: stage/168/lang_gameover_en.olang/0xa7eb70/0x000000
msgid "Strangelove (Vanessa Marshall)"
msgstr "斯特兰奇洛夫（Vanessa Marshall）"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0xae66e6/0x000000
#: stage/156/lang_gameover_en.olang/0xae66e6/0x000001
#: stage/168/lang_gameover_en.olang/0xae66e6/0x000000
#: stage/168/lang_gameover_en.olang/0xae66e6/0x000001
msgid "The End!"
msgstr "终焉"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0xc2cb14/0x000000
#: stage/168/lang_gameover_en.olang/0xc2cb14/0x000000
msgid "Paz, wait! PA-A-AZ!"
msgstr "帕兹，等等！帕——兹！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0xc2cb70/0x000000
#: stage/168/lang_gameover_en.olang/0xc2cb70/0x000000
msgid "Paz, I'm sorry! Don't walk away! PA-A-AZ!"
msgstr "帕兹，对不起！别走！帕兹！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0xc2cb74/0x000000
#: stage/168/lang_gameover_en.olang/0xc2cb74/0x000000
msgid "Hey, Kaz, come back! KA-A-AZ!"
msgstr "嘿，卡兹，回来！卡——兹！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0xc2cb78/0x000000
#: stage/168/lang_gameover_en.olang/0xc2cb78/0x000000
msgid "Kaz, I'm sorry! I didn't mean it! C'mon! KA-A-AZ!"
msgstr "卡兹，对不起！我不是那个意思！别走！卡——兹！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0xcbb801/0x4a4f2c
#: stage/168/lang_gameover_en.olang/0xcbb801/0x4a4f2c
msgid "When count reaches 0, game will continue automatically."
msgstr "计数归零后，游戏将自动继续。"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0xcbb801/0x75081c
#: stage/168/lang_gameover_en.olang/0xcbb801/0x75081c
msgid "Waiting for the host."
msgstr "正在等待主机。"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0xcbb801/0xcfe5d3
#: stage/168/lang_gameover_en.olang/0xcbb801/0xcfe5d3
msgid "Waiting for other players."
msgstr "等待其他玩家。"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0xe24d3a/0x000000
#: stage/168/lang_gameover_en.olang/0xe24d3a/0x000000
msgid "Snake, what happened? Answer me! SNA-A-AKE!!"
msgstr "SNAKE，怎么了？回答我！SNAKE！！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0xe24d3e/0x000000
#: stage/168/lang_gameover_en.olang/0xe24d3e/0x000000
msgid "Snake, you OK?! C'mon, shake it off! SNA-A-AKE!!"
msgstr "SNAKE，没事吧？！振作点！SNAKE！！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0xe24d42/0x000000
#: stage/168/lang_gameover_en.olang/0xe24d42/0x000000
msgid "Don't die on me, Snake! Who's gonna stop Peace Walker now?!"
msgstr "别死啊，SNAKE！还有谁能阻止和平行者？！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0xe24d42/0x000001
#: stage/168/lang_gameover_en.olang/0xe24d42/0x000001
msgid "SNA-A-AKE!"
msgstr "SNAKE！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0xe24d46/0x000000
#: stage/168/lang_gameover_en.olang/0xe24d46/0x000000
msgid "Snake! Get up, Snake!"
msgstr "SNAKE！起来，SNAKE！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
