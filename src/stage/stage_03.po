#: stage/23/lang_item_text_en.olang/0x048941/0x00009e
#: stage/174/lang_item_text_en.olang/0x048941/0x00009e
msgid "Special ammo that recovers its target's PSYCHE."
msgstr "可恢复目标精神值的特殊弹药。"

#. STAGEDAT entry 23, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 174, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/23/lang_item_text_en.olang/0x048941/0x00009f
#: stage/174/lang_item_text_en.olang/0x048941/0x00009f
msgid "Special ammo that recovers its target's LIFE."
msgstr "可恢复目标生命值的特殊弹药。"

#. STAGEDAT entry 23, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 174, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/23/lang_item_text_en.olang/0x048941/0x0000a0
#: stage/174/lang_item_text_en.olang/0x048941/0x0000a0
msgid "Special ammo that knocks its target unconscious. Hitting certain areas will quicken the effect."
msgstr "可使目标昏迷的特殊弹药。击中特定部位可加快生效。"

#. STAGEDAT entry 23, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 174, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/23/lang_item_text_en.olang/0x048941/0x0000a1
#: stage/174/lang_item_text_en.olang/0x048941/0x0000a1
msgid "Omnidirectional sensor that visualizes nearby sounds as waveforms. The \"N\" icon points north."
msgstr "全向传感器，将附近声音以波形显示。\"N\"图标指向北方。"

#. STAGEDAT entry 23, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 174, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/23/lang_item_text_en.olang/0x048941/0x0000a2
#: stage/174/lang_item_text_en.olang/0x048941/0x0000a2
msgid "Omnidirectional sensor that visualizes nearby sounds as waveforms. The \"N\" icon points north. Modified to show precise enemy locations."
msgstr "全向传感器，将附近声音以波形显示。\"N\"图标指向北方。经改造可显示敌人精确位置。"

#. STAGEDAT entry 23, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 174, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/23/lang_item_text_en.olang/0x048941/0x0000a3
#: stage/174/lang_item_text_en.olang/0x048941/0x0000a3
msgid "High-power sensor that displays surrounding topography and enemy positions. Only functional in Normal Phase."
msgstr "高性能传感器，可显示周围地形与敌人位置。仅在普通阶段有效。"

#. STAGEDAT entry 23, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 174, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/23/lang_item_text_en.olang/0x048941/0x0000a4
#: stage/23/lang_item_text_en.olang/0x048941/0x0000a5
#: stage/23/lang_item_text_en.olang/0x048941/0x0000a6
#: stage/174/lang_item_text_en.olang/0x048941/0x0000a4
#: stage/174/lang_item_text_en.olang/0x048941/0x0000a5
#: stage/174/lang_item_text_en.olang/0x048941/0x0000a6
msgid "High-power sensor that displays surrounding topography and enemy positions. Only functional in Normal Phase. Modified to extend battery life."
msgstr "高性能传感器，可显示周围地形与敌人位置。仅在普通阶段有效。经改造延长了电池寿命。"

#. STAGEDAT entry 23, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 174, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/23/lang_item_text_en.olang/0x048941/0x0000a7
#: stage/174/lang_item_text_en.olang/0x048941/0x0000a7
msgid "High-power sensor that displays surrounding topography and enemy positions. Only functional in Normal Phase. Modified to consume virtually no battery power at all."
msgstr "高性能传感器，可显示周围地形与敌人位置。仅在普通阶段有效。经改造几乎不消耗电池。"

#. STAGEDAT entry 23, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 174, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/23/lang_item_text_en.olang/0x048941/0x0000a8
#: stage/174/lang_item_text_en.olang/0x048941/0x0000a8
msgid "Sensor that displays nearby sound sources as animated symbols. Not affected by surrounding objects. A prototype, it will only work when lying down or against a wall."
msgstr "将附近声源以动画符号显示的传感器。不受周围物体影响。为试制品，仅在卧倒或靠墙时有效。"

#. STAGEDAT entry 23, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 174, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/23/lang_item_text_en.olang/0x048941/0x0000a9
#: stage/174/lang_item_text_en.olang/0x048941/0x0000a9
msgid "Sensor that displays nearby sound sources as animated symbols. Symbols are displayed regardless of body position."
msgstr "将附近声源以动画符号显示的传感器。无论身体姿势如何都会显示符号。"

#. STAGEDAT entry 23, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 174, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/23/lang_item_text_en.olang/0x048941/0x0000aa
#: stage/23/lang_item_text_en.olang/0x048941/0x0000ab
#: stage/174/lang_item_text_en.olang/0x048941/0x0000aa
#: stage/174/lang_item_text_en.olang/0x048941/0x0000ab
msgid "Sensor that displays nearby sound sources as animated symbols. Modified to extend battery life."
msgstr "将附近声源以动画符号显示的传感器。经改造延长了电池寿命。"

#. STAGEDAT entry 23, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 174, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/23/lang_item_text_en.olang/0x048941/0x0000ac
#: stage/174/lang_item_text_en.olang/0x048941/0x0000ac
msgid "Sensor that displays nearby sound sources as animated symbols. Modified to consume virtually no battery power at all."
msgstr "将附近声源以动画符号显示的传感器。经改造几乎不消耗电池。"

#. STAGEDAT entry 23, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 174, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/23/lang_item_text_en.olang/0x048941/0x0000ad
#: stage/174/lang_item_text_en.olang/0x048941/0x0000ad
msgid "Citrus-flavored carbonated soft drink.  Recovers PSYCHE and a small amount of LIFE. Automatically used if LIFE reaches zero when equipped."
msgstr "柑橘味碳酸软饮料。恢复精神值与少量生命值。装备时生命值归零会自动使用。"

#. STAGEDAT entry 23, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 174, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/23/lang_item_text_en.olang/0x048941/0x0000ae
#: stage/174/lang_item_text_en.olang/0x048941/0x0000ae
msgid "Zero-calorie carbonated soft drink.  Recovers PSYCHE and a small amount of LIFE. Automatically used if LIFE reaches zero when equipped."
msgstr "零卡路里碳酸软饮料。恢复精神值与少量生命值。装备时生命值归零会自动使用。"

#. STAGEDAT entry 23, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 174, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/23/lang_item_text_en.olang/0x048941/0x0000af
#: stage/174/lang_item_text_en.olang/0x048941/0x0000af
msgid "Tasty taco-flavored tortilla chips. Recovers LIFE.  Automatically used if LIFE reaches zero when equipped."
msgstr "美味的塔可味玉米片。恢复生命值。装备时生命值归零会自动使用。"

#. STAGEDAT entry 23, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 174, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/23/lang_item_text_en.olang/0x048941/0x0000b0
#: stage/23/lang_item_text_en.olang/0x048941/0x0000b1
#: stage/23/lang_item_text_en.olang/0x048941/0x0000b2
#: stage/23/lang_item_text_en.olang/0x048941/0x0000b3
#: stage/23/lang_item_text_en.olang/0x048941/0x0000b4
#: stage/174/lang_item_text_en.olang/0x048941/0x0000b0
#: stage/174/lang_item_text_en.olang/0x048941/0x0000b1
#: stage/174/lang_item_text_en.olang/0x048941/0x0000b2
#: stage/174/lang_item_text_en.olang/0x048941/0x0000b3
#: stage/174/lang_item_text_en.olang/0x048941/0x0000b4
msgid "Cardboard box that explodes if damaged or if someone tries to see what's inside. Will inflict damage if you are inside. \"DROP\" to set."
msgstr "受损或有人试图查看内部时会爆炸的纸箱。你在里面时会受到伤害。按\"DROP\"设置。"

#. STAGEDAT entry 23, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 174, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/23/lang_item_text_en.olang/0x048941/0x0000b5
#: stage/23/lang_item_text_en.olang/0x048941/0x0000b6
#: stage/23/lang_item_text_en.olang/0x048941/0x0000b7
#: stage/23/lang_item_text_en.olang/0x048941/0x0000b8
#: stage/174/lang_item_text_en.olang/0x048941/0x0000b5
#: stage/174/lang_item_text_en.olang/0x048941/0x0000b6
#: stage/174/lang_item_text_en.olang/0x048941/0x0000b7
#: stage/174/lang_item_text_en.olang/0x048941/0x0000b8
msgid "Cardboard box that explodes and stuns anyone nearby if damaged or if someone tries to see what's inside. Will inflict damage if you are inside. \"DROP\" to set."
msgstr "受损或有人试图查看内部时会爆炸并震晕附近人员的纸箱。你在里面时会受到伤害。按\"DROP\"设置。"

#. STAGEDAT entry 23, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 174, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/23/lang_item_text_en.olang/0x048941/0x0000b9
#: stage/23/lang_item_text_en.olang/0x048941/0x0000ba
#: stage/23/lang_item_text_en.olang/0x048941/0x0000bb
#: stage/23/lang_item_text_en.olang/0x048941/0x0000bc
#: stage/23/lang_item_text_en.olang/0x048941/0x0000bd
#: stage/174/lang_item_text_en.olang/0x048941/0x0000b9
#: stage/174/lang_item_text_en.olang/0x048941/0x0000ba
#: stage/174/lang_item_text_en.olang/0x048941/0x0000bb
#: stage/174/lang_item_text_en.olang/0x048941/0x0000bc
#: stage/174/lang_item_text_en.olang/0x048941/0x0000bd
msgid "Cardboard box that explodes and releases smoke if damaged or if someone tries to see what's inside. Will inflict damage if you are inside. \"DROP\" to set."
msgstr "受损或有人试图查看内部时会爆炸并释放烟雾的纸箱。你在里面时会受到伤害。按\"DROP\"设置。"

#. STAGEDAT entry 23, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 174, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/23/lang_item_text_en.olang/0x048941/0x0000be
#: stage/174/lang_item_text_en.olang/0x048941/0x0000be
msgid "Cardboard box made of straw. Allows you to pull enemies inside, knock them out, and perform a Fulton recovery."
msgstr "稻草制成的纸箱。可将敌人拉入其中，使其昏迷并进行富尔顿回收。"

#. STAGEDAT entry 23, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 174, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/23/lang_item_text_en.olang/0x048941/0x0000bf
#: stage/174/lang_item_text_en.olang/0x048941/0x0000bf
msgid "Special box that speeds your LIFE recovery when you are inside or a teammate's when giving CPR.   \"DROP\" to set."
msgstr "特殊纸箱，你在里面时或对队友进行心肺复苏时可加快生命值恢复。按\"DROP\"设置。"

#. STAGEDAT entry 23, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 174, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/23/lang_item_text_en.olang/0x048941/0x0000c0
#: stage/23/lang_item_text_en.olang/0x048941/0x0000c1
#: stage/23/lang_item_text_en.olang/0x048941/0x0000c2
#: stage/23/lang_item_text_en.olang/0x048941/0x0000c3
#: stage/174/lang_item_text_en.olang/0x048941/0x0000c0
#: stage/174/lang_item_text_en.olang/0x048941/0x0000c1
#: stage/174/lang_item_text_en.olang/0x048941/0x0000c2
#: stage/174/lang_item_text_en.olang/0x048941/0x0000c3
msgid "Special box that speeds your LIFE recovery when you are inside or a teammate's when giving CPR.R&D has increased LIFE recovery.   \"DROP\" to set."
msgstr "特殊纸箱，你在里面时或对队友进行心肺复苏时可加快生命值恢复。研发提升了生命值恢复量。按\"DROP\"设置。"

#. STAGEDAT entry 23, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 174, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/23/lang_item_text_en.olang/0x048941/0x0000c4
#: stage/23/lang_item_text_en.olang/0x048941/0x0000c5
#: stage/23/lang_item_text_en.olang/0x048941/0x0000c6
#: stage/23/lang_item_text_en.olang/0x048941/0x0000c7
#: stage/23/lang_item_text_en.olang/0x048941/0x0000c8
#: stage/174/lang_item_text_en.olang/0x048941/0x0000c4
#: stage/174/lang_item_text_en.olang/0x048941/0x0000c5
#: stage/174/lang_item_text_en.olang/0x048941/0x0000c6
#: stage/174/lang_item_text_en.olang/0x048941/0x0000c7
#: stage/174/lang_item_text_en.olang/0x048941/0x0000c8
msgid "Undercooked Meal, Ready-to-Eat. An already unappetizing creation made worse by being undercooked. Recovers only a small amount of LIFE."
msgstr "没煮熟的即食口粮。本就难吃，没煮熟后更难吃。仅恢复少量生命值。"

#. STAGEDAT entry 23, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 174, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/23/lang_item_text_en.olang/0x048941/0x0000c9
#: stage/23/lang_item_text_en.olang/0x048941/0x0000ca
#: stage/23/lang_item_text_en.olang/0x048941/0x0000cb
#: stage/23/lang_item_text_en.olang/0x048941/0x0000cc
#: stage/23/lang_item_text_en.olang/0x048941/0x0000cd
#: stage/174/lang_item_text_en.olang/0x048941/0x0000c9
#: stage/174/lang_item_text_en.olang/0x048941/0x0000ca
#: stage/174/lang_item_text_en.olang/0x048941/0x0000cb
#: stage/174/lang_item_text_en.olang/0x048941/0x0000cc
#: stage/174/lang_item_text_en.olang/0x048941/0x0000cd
msgid "Well-done Meal, Ready-to-Eat. Makes a revolting ration surprisingly delicious. Recovers more LIFE than normal, and also recovers PSYCHE."
msgstr "煮熟的即食口粮。让恶心的口粮变得出奇美味。恢复的生命值比普通更多，还能恢复精神值。"

#. STAGEDAT entry 23, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 174, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/23/lang_item_text_en.olang/0x048941/0x0000ce
#: stage/23/lang_item_text_en.olang/0x048941/0x0000cf
#: stage/23/lang_item_text_en.olang/0x048941/0x0000d0
#: stage/23/lang_item_text_en.olang/0x048941/0x0000d1
#: stage/23/lang_item_text_en.olang/0x048941/0x0000d2
#: stage/174/lang_item_text_en.olang/0x048941/0x0000ce
#: stage/174/lang_item_text_en.olang/0x048941/0x0000cf
#: stage/174/lang_item_text_en.olang/0x048941/0x0000d0
#: stage/174/lang_item_text_en.olang/0x048941/0x0000d1
#: stage/174/lang_item_text_en.olang/0x048941/0x0000d2
msgid "Burnt Meal, Ready-to-Eat. The only thing worse than a ration is a burnt ration. Eating it won't recover much LIFE."
msgstr "烧焦的即食口粮。比口粮更糟的只有烧焦的口粮。吃了也恢复不了多少生命值。"

#. STAGEDAT entry 23, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 174, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/23/lang_item_text_en.olang/0x048941/0x0000d3
#: stage/23/lang_item_text_en.olang/0x048941/0x0000d4
#: stage/23/lang_item_text_en.olang/0x048941/0x0000d5
#: stage/23/lang_item_text_en.olang/0x048941/0x0000d6
#: stage/23/lang_item_text_en.olang/0x048941/0x0000d7
#: stage/174/lang_item_text_en.olang/0x048941/0x0000d3
#: stage/174/lang_item_text_en.olang/0x048941/0x0000d4
#: stage/174/lang_item_text_en.olang/0x048941/0x0000d5
#: stage/174/lang_item_text_en.olang/0x048941/0x0000d6
#: stage/174/lang_item_text_en.olang/0x048941/0x0000d7
msgid "Tea that recovers PSYCHE. Select from the Equipment window and press <I=USE> to drink."
msgstr "恢复精神值的茶。在装备窗口选择后按<I=USE>饮用。"

#. STAGEDAT entry 23, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 174, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/23/lang_item_text_en.olang/0x048941/0x0000d8
#: stage/174/lang_item_text_en.olang/0x048941/0x0000d8
msgid "Rubber shotgun rounds."
msgstr "橡胶霰弹。"

#. STAGEDAT entry 23, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 174, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/23/lang_item_text_en.olang/0x048941/0x0000d9
#: stage/174/lang_item_text_en.olang/0x048941/0x0000d9
msgid "Grenade launcher smoke rounds."
msgstr "榴弹发射器烟雾弹。"

#. STAGEDAT entry 23, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 174, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/23/lang_item_text_en.olang/0x048941/0x0000da
#: stage/174/lang_item_text_en.olang/0x048941/0x0000da
msgid "Soviet grenade launcher smoke rounds."
msgstr "苏联榴弹发射器烟雾弹。"

#. STAGEDAT entry 23, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 174, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/23/lang_item_text_en.olang/0x048941/0x0000db
#: stage/174/lang_item_text_en.olang/0x048941/0x0000db
msgid "Support strike marker (fired)."
msgstr "支援打击标记（已发射）。"

#. STAGEDAT entry 23, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 174, lang_item_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/23/lang_item_text_en.olang/0x048941/0x0000dc
#: stage/174/lang_item_text_en.olang/0x048941/0x0000dc
msgid "Support supply marker (fired)."
