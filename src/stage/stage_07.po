#: stage/156/lang_gameover_en.olang/0x037878/0x000000
#: stage/168/lang_gameover_en.olang/0x037878/0x000000
msgid "Why...? Are your secrets really worth your life?"
msgstr "为什么……？你的秘密真值得你搭上性命吗？"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x03787c/0x000000
#: stage/168/lang_gameover_en.olang/0x03787c/0x000000
msgid "You're LYING, Snake! SNA-A-AKE!"
msgstr "你在撒谎，SNAKE！SNA-A-AKE！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x084041/0x000000
#: stage/168/lang_gameover_en.olang/0x084041/0x000000
msgid "What happened, Snake?!"
msgstr ""

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x084045/0x000000
#: stage/168/lang_gameover_en.olang/0x084045/0x000000
msgid "Snake! Come in, Snake!"
msgstr ""

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x084049/0x000000
#: stage/168/lang_gameover_en.olang/0x084049/0x000000
msgid "Are you all right?! Snake?!"
msgstr ""

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x08404d/0x000000
#: stage/168/lang_gameover_en.olang/0x08404d/0x000000
msgid "What's wrong, Boss?"
msgstr "怎么了，BOSS？"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x084051/0x000000
#: stage/168/lang_gameover_en.olang/0x084051/0x000000
msgid "What's going on, Snake?! Report!"
msgstr ""

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x084052/0x000000
#: stage/168/lang_gameover_en.olang/0x084052/0x000000
msgid "What's going on, Snake?! Report! What's your situation?! Snaaaaaaake!"
msgstr "怎么回事，SNAKE？！报告！你那边情况如何？！Snaaaaaaake！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x084055/0x000000
#: stage/168/lang_gameover_en.olang/0x084055/0x000000
msgid "Stop kidding around, Snake!"
msgstr ""

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x084059/0x000000
#: stage/168/lang_gameover_en.olang/0x084059/0x000000
msgid "What's wrong? What happened?! Report your status! Report!"
msgstr "怎么了？出什么事了？！报告情况！报告！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x08405d/0x000000
#: stage/168/lang_gameover_en.olang/0x08405d/0x000000
msgid "Hey! What's going on?! Report! Report, damnit!"
msgstr "喂！怎么回事？！报告！快报告！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x084061/0x000000
#: stage/168/lang_gameover_en.olang/0x084061/0x000000
msgid "Damn, they got us good. Are you all right? Respond!"
msgstr "该死，我们中招了。你没事吧？回答！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x084065/0x000000
#: stage/156/lang_gameover_en.olang/0x084066/0x000000
#: stage/168/lang_gameover_en.olang/0x084065/0x000000
#: stage/168/lang_gameover_en.olang/0x084066/0x000000
msgid "What's wrong? Why aren't you responding?! Requesting status report!"
msgstr "怎么了？为什么不回答？！请求情况报告！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x0840c1/0x000000
#: stage/168/lang_gameover_en.olang/0x0840c1/0x000000
msgid "It's over, Snake. Your buddy fell in."
msgstr ""

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x0840c5/0x000000
#: stage/168/lang_gameover_en.olang/0x0840c5/0x000000
msgid "Abort the mission, Snake!"
msgstr ""

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x0840c5/0x000001
#: stage/168/lang_gameover_en.olang/0x0840c5/0x000001
msgid "How could you let him die?!"
msgstr "你怎么能让他死了？！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x0840c9/0x000000
#: stage/168/lang_gameover_en.olang/0x0840c9/0x000000
msgid "Hold it, Snake. Your man's been incapacitated."
msgstr ""

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x0840c9/0x000001
#: stage/168/lang_gameover_en.olang/0x0840c9/0x000001
msgid "Too bad..."
msgstr "真糟糕……"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x0840cd/0x000000
#: stage/168/lang_gameover_en.olang/0x0840cd/0x000000
msgid "I'm getting no response"
msgstr ""

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x0840cd/0x000001
#: stage/168/lang_gameover_en.olang/0x0840cd/0x000001
msgid "I'm calling off the mission."
msgstr ""

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x0840d1/0x000000
#: stage/168/lang_gameover_en.olang/0x0840d1/0x000000
msgid "Damnit, man! Your partner fell in. We have to abort!"
msgstr "该死！你的搭档倒下了。必须中止！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x0840d5/0x000000
#: stage/168/lang_gameover_en.olang/0x0840d5/0x000000
msgid "We lost someone! This operation is over. Return to base!"
msgstr "我们损失了人手！行动结束。回基地！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x0840d9/0x000000
#: stage/168/lang_gameover_en.olang/0x0840d9/0x000000
msgid "Abort the mission. We have a man down. Just come back..."
msgstr "中止任务。有人倒下了。回来吧……"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x0840da/0x000000
#: stage/168/lang_gameover_en.olang/0x0840da/0x000000
msgid "Abort the mission. We have a man down."
msgstr "中止任务。有人倒下了。"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x0840dd/0x000000
#: stage/168/lang_gameover_en.olang/0x0840dd/0x000000
msgid "I can't reach your partner. I'm calling off the mission. Return immediately!"
msgstr "联系不上你的搭档。我取消任务。立刻返回！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x0f2371/0x000000
#: stage/168/lang_gameover_en.olang/0x0f2371/0x000000
msgid "Miller (Robin Atkin Downes)"
msgstr "米勒(Robin Atkin Downes)"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x483fc9/0x000000
#: stage/168/lang_gameover_en.olang/0x483fc9/0x000000
msgid "The unconscious soldier is coming to."
msgstr "昏迷的士兵醒过来了。"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x483fc9/0x000001
#: stage/168/lang_gameover_en.olang/0x483fc9/0x000001
msgid "You won't be able to recover anything now. Return to base."
msgstr "现在什么都回收不了了。回基地吧。"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x483fcd/0x000000
#: stage/168/lang_gameover_en.olang/0x483fcd/0x000000
msgid "The prisoner's been moved to another location. We can't rescue him now."
msgstr "囚犯已被转移到别处。现在救不了他。"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x483fcd/0x000001
#: stage/168/lang_gameover_en.olang/0x483fcd/0x000001
msgid "Come on back."
msgstr "回来吧。"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x483fd1/0x000000
#: stage/168/lang_gameover_en.olang/0x483fd1/0x000000
msgid "Call off the operation! "
msgstr "取消行动！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x483fd1/0x000001
#: stage/168/lang_gameover_en.olang/0x483fd1/0x000001
msgid "Your orders were to recover that scout without killing him!"
msgstr "你的命令是活捉那名侦察兵！"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x483fd5/0x000000
#: stage/168/lang_gameover_en.olang/0x483fd5/0x000000
msgid "All the bases have been overrun. "
msgstr "所有基地都已失守。"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x483fd5/0x000001
#: stage/168/lang_gameover_en.olang/0x483fd5/0x000001
msgid "That's a pretty epic failure on our part."
msgstr "我们这次败得可真彻底。"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x483fdd/0x000000
#: stage/168/lang_gameover_en.olang/0x483fdd/0x000000
msgid "Abort mission - they stole an item."
msgstr ""

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x483fe1/0x000000
#: stage/168/lang_gameover_en.olang/0x483fe1/0x000000
msgid "All of the items we secured have been stolen."
msgstr "我们拿到的所有物品都被偷了。"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x483fe1/0x000001
#: stage/168/lang_gameover_en.olang/0x483fe1/0x000001
msgid "The operation's a failure."
msgstr "行动失败。"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x483fe5/0x000000
#: stage/168/lang_gameover_en.olang/0x483fe5/0x000000
msgid "Enemy soldiers captured the prisoner. The mission's a failure."
msgstr "敌兵抓走了囚犯。任务失败。"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x483fe5/0x000001
#: stage/168/lang_gameover_en.olang/0x483fe5/0x000001
msgid "Let's hope he can find his own way out of there."
msgstr "但愿他能自己找到出路。"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x484045/0x000000
#: stage/168/lang_gameover_en.olang/0x484045/0x000000
msgid "Time's up! "
msgstr "时间到"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x484045/0x000001
#: stage/168/lang_gameover_en.olang/0x484045/0x000001
msgid "I'm calling off the operation - retreat for now."
msgstr "我取消行动——暂时撤退。"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x48404a/0x000000
#: stage/168/lang_gameover_en.olang/0x48404a/0x000000
msgid "Out of ammo, huh?"
msgstr "没弹药了？"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x48404a/0x000001
#: stage/168/lang_gameover_en.olang/0x48404a/0x000001
msgid "Abort mission. Come on back."
msgstr "任务中止。回来吧。"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x48404d/0x000000
#: stage/168/lang_gameover_en.olang/0x48404d/0x000000
msgid "Out of ammo, huh? "
msgstr "没弹药了？"

#. STAGEDAT entry 156, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 168, lang_gameover_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#: stage/156/lang_gameover_en.olang/0x48404d/0x000001
#: stage/168/lang_gameover_en.olang/0x48404d/0x000001
msgid "Guess it was too much, even for you... "
msgstr "看来对你来说也太勉强了…"
