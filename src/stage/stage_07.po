#: stage/174/lang_weapon_text_en.olang/0x594864/0x0000fb
#: stage/174/lang_weapon_text_en.olang/0x594864/0x0000fc
msgid "Fragmentation grenade. Unleashes explosion over a wide radius. R&D can increase power."
msgstr "破片手雷。爆炸范围广。研发可提升威力。"

#. STAGEDAT entry 23, lang_weapon_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
#. STAGEDAT entry 174, lang_weapon_text_en.olang -- written back by pwsf.stage_build into 009645fa.PDT
