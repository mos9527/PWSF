msgstr "- FREE -"

#: slot/0x00d9b1f3/0x1331ad/0xe9062a
#, c-format
msgid "PRESET WORDS: %d"
msgstr "预设词：%d"

#: slot/0x00d9b1f3/0x1331ad/0xecd829
