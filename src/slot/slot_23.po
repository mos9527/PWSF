msgstr "武器"

#: slot/0x00d9b1f3/0x1331ad/0xd26188
#, c-format
msgid "Weapon from %s"
msgstr "%s的武器"

#: slot/0x00d9b1f3/0x1331ad/0xd64f9c
msgid "Add/change weapons or items."
msgstr "添加/更换武器或道具。"

#: slot/0x00d9b1f3/0x1331ad/0xd85746
msgid ""
"Choose a recipient.  Selecting \"- FREE -\" will send\n"
"the box to an undisclosed recipient."
msgstr "选择收件人。选择“- FREE -”将把箱子\n寄给未指定的收件人。"

#: slot/0x00d9b1f3/0x1331ad/0xe8afe9
