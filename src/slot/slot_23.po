msgstr "集章卡"

#: slot/0x00d9b1f3/0x1331ad/0xb7812d
msgid "Select at least 1 item."
msgstr "至少选1件道具。"

#: slot/0x00d9b1f3/0x1331ad/0xb8a0c0
msgid "YOUR FRIENDS"
msgstr "你的好友"

#: slot/0x00d9b1f3/0x1331ad/0xbbc0e2
msgid "Please verify the Date & Time settings on your PSP<I=TM> system. Incorrect date settings may interfere with package deliveries."
msgstr "请检查PSP<I=TM>主机的日期与时间设置。日期设置错误可能导致包裹无法送达。"

#: slot/0x00d9b1f3/0x1331ad/0xcfd8cb
