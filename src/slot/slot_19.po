#: slot/0x00a57090/0x12908e/0x000120
msgid "Enemy encountered. Request reinforcements."
msgstr "遭遇敌人。请求增援。"

#: slot/0x00a57090/0x12908e/0x000121
msgid "Enemy sighted. Moving to engage."
msgstr "发现敌人。前去交战。"

#: slot/0x00a57090/0x12908e/0x000122
msgid "Someone's firing at us! Going to alert status!"
msgstr "有人向我们开火！进入警戒状态！"

#: slot/0x00a57090/0x12908e/0x000128
msgid "It's some kind of device!"
msgstr "是某种装置！"

#: slot/0x00a57090/0x12908e/0x000129
msgid "Neutralized!"
msgstr "已解决！"

#: slot/0x00a57090/0x12908e/0x00012a
msgid "Understood!"
msgstr "明白！"

#: slot/0x00a57090/0x12908e/0x00012b
msgid "Work is complete!"
msgstr "工作完成！"

#: slot/0x00a57090/0x12908e/0x00012d
msgid "CAPTA-A-AIN!"
msgstr "队长！"

#: slot/0x00a57090/0x12908e/0x00012e
msgid "Let's go!"
msgstr "走吧！"

#: slot/0x00a57090/0x12908e/0x000130
msgid "I need backup!"
msgstr "我需要支援！"

#: slot/0x00a57090/0x12908e/0x000131
msgid "I am screwed."
msgstr "我完蛋了。"

#: slot/0x00a57090/0x12908e/0x000142
msgid "I got a visual!"
msgstr "我看到目标了！"

#: slot/0x00a57090/0x12908e/0x000143
msgid "What the...?!"
msgstr "什么鬼……？！"

#: slot/0x00a57090/0x12908e/0x000144
msgid "Hey...!"
msgstr "喂！"

#: slot/0x00a57090/0x12908e/0x000145
msgid "Hmm?!"
msgstr "嗯？！"

#: slot/0x00a57090/0x12908e/0x000146
msgid "Somebody there?!"
msgstr "谁在那？！"

#: slot/0x00a57090/0x12908e/0x000148
msgid "Huh. Nothing..."
msgstr "哼，没人"

#: slot/0x00a57090/0x12908e/0x00014a
msgid "Enemy attack?!"
msgstr "敌袭？！"

#: slot/0x00a57090/0x12908e/0x00014b
msgid "We're under attack!"
msgstr "我们被袭了！"

#: slot/0x00a57090/0x12908e/0x00014c
msgid "He's vanished. Start up the search!"
msgstr "他不见了。开始搜索！"

#: slot/0x00a57090/0x12908e/0x00014e
msgid "The enemy...! He couldn't have gotten far..."
msgstr "敌人……！他跑不远……"

#: slot/0x00a57090/0x12908e/0x000151
msgid "Eat it!"
msgstr "吃我一招！"

#: slot/0x00a57090/0x12908e/0x000153
msgid "He's here!"
msgstr "他在这儿！"

#: slot/0x00a57090/0x12908e/0x000154
msgid "Look out!"
msgstr "当心！"

#: slot/0x00a57090/0x12908e/0x000155
msgid "Footsteps!"
msgstr "脚步！"

#: slot/0x00a57090/0x12908e/0x000156
msgid "Hold up."
msgstr "站住"

#: slot/0x00a57090/0x12908e/0x000159
msgid "Gotcha covered!"
msgstr "我掩护你！"

#: slot/0x00a57090/0x12908e/0x00015a
msgid "Go 'round back!"
msgstr "绕后！"

#: slot/0x00a57090/0x12908e/0x00015c
msgid "Down! Now!"
msgstr "趴下！"

#: slot/0x00a57090/0x12908e/0x00015f
msgid "Get ready!"
msgstr "准备！"

#: slot/0x00a57090/0x12908e/0x000160
msgid "Stay with me!"
msgstr "跟紧我！"

#: slot/0x00a57090/0x12908e/0x000161
msgid "Another one!"
msgstr "又来一个！"

#: slot/0x00a57090/0x12908e/0x00016e
msgid "Score one for us."
msgstr "得一分。"

#: slot/0x00a57090/0x12908e/0x00016f
msgid "Adios!"
msgstr "再见啦！"

#: slot/0x00a57090/0x12908e/0x000170
msgid "We've been had!"
msgstr "上当了！"

#: slot/0x00a57090/0x12908e/0x000171
msgid "Cut it out!"
msgstr "住手！"

#: slot/0x00a57090/0x12908e/0x000172
msgid "They're not getting past us!"
msgstr "他们别想过去！"

#: slot/0x00a57090/0x12908e/0x000174
msgid "Who's out there?!"
msgstr "谁在外？！"

#: slot/0x00a57090/0x12908e/0x000175
msgid "FIRE!"
msgstr "开火！"

#: slot/0x00a57090/0x12908e/0x000176
msgid "Kiss your ass goodbye!"
msgstr "跟你的屁股说再见吧！"

#: slot/0x00a57090/0x12908e/0x000178
msgid "Release him!"
msgstr "放开他！"

#: slot/0x00a57090/0x12908e/0x00017a
msgid "That's better, thanks."
msgstr "好多了，谢谢。"

#: slot/0x00a57090/0x12908e/0x00017b
msgid "Is somebody there?"
msgstr "有人在吗？"

#: slot/0x00a57090/0x12908e/0x00017c
msgid "There! Who's that?!"
msgstr "那边！谁？！"

#: slot/0x00a57090/0x12908e/0x00017d
msgid "You hear that? Gunshots!"
msgstr "听到了吗？枪声！"

#: slot/0x00a57090/0x12908e/0x00017e
msgid "You hear that bang?"
msgstr "听到那声枪响了吗？"

#: slot/0x00a57090/0x12908e/0x00017f
msgid "What was that?"
msgstr "那是什么声音？"

#: slot/0x00a57090/0x12908e/0x000180
msgid "Got a hostile!"
msgstr "发现敌人！"

#: slot/0x00a57090/0x12908e/0x000181
msgid "There! Saw it again!"
msgstr "那边！又看到了！"

#: slot/0x00a57090/0x12908e/0x000182
msgid "This place is getting to me..."
msgstr "这地方让我发毛……"

#: slot/0x00a57090/0x12908e/0x000186
msgid "It's the enemy! Send reinforcements."
msgstr "是敌人！派增援来。"

#: slot/0x00a57090/0x12908e/0x000187
msgid "Enemy sighted. Preparing to attack."
msgstr "发现敌人。准备攻击。"

#: slot/0x00a57090/0x12908e/0x000188
msgid "We're being shot at! Going to alert status!"
msgstr "我们遭到射击！进入警戒状态！"

#: slot/0x00a57090/0x12908e/0x00018e
msgid "Device located!"
msgstr "找到装置了！"

#: slot/0x00a57090/0x12908e/0x00018f
msgid "Cleared!"
msgstr "清除了！"

#: slot/0x00a57090/0x12908e/0x000191
msgid "Repairs finished!"
msgstr "修理完成！"

#: slot/0x00a57090/0x12908e/0x000192
msgid "I surrender!"
msgstr "我投降！"

#: slot/0x00a57090/0x12908e/0x000193
msgid "They got the captain!"
msgstr "他们抓走队长了！"

#: slot/0x00a57090/0x12908e/0x000194
msgid "Move, move, move!"
msgstr "快走，快走，快走！"

#: slot/0x00a57090/0x12908e/0x000196
msgid "Gimme some backup!"
msgstr "给我点支援！"

#: slot/0x00a57090/0x12908e/0x000197
msgid "I'm finished."
msgstr "我完了。"

#: slot/0x00a57090/0x12908e/0x000198
msgid "Wha?  Hey, you!"
msgstr "啥？喂，你！"

#: slot/0x00a57090/0x12908e/0x000199
msgid "Huh? What are you doing here?!"
msgstr "嗯？你在这干嘛？！"

#: slot/0x00a57090/0x12908e/0x00019a
msgid "Huh? ...Ah, never mind."
msgstr "嗯？……算了。"

#: slot/0x00a57090/0x12908e/0x00019b
msgid "Where do you think you're going?!"
msgstr "你想往哪跑？！"

#: slot/0x00a57090/0x12908e/0x00019c
#: slot/0x00e2e8b4/0x6f069d/0x000000
msgid "Get in there. "
msgstr "进去。"

#: slot/0x00a57090/0x12908e/0x00019d
#: slot/0x00e2e8b4/0x70a69d/0x000000
msgid "Come on!"
msgstr "快上！"

#: slot/0x00a57090/0x12908e/0x00019e
msgid "Where did you get these?!"
msgstr "哪弄来的？！"

#: slot/0x00a57090/0x12908e/0x00019f
msgid "Prisoner's gone! After 'em!"
msgstr "囚犯跑了！追！"

#: slot/0x00a57090/0x12908e/0x0001a0
#: slot/0x00e2e8b4/0x9ec69d/0x000000
msgid "Prisoner secure!"
msgstr "囚犯已控！"

#: slot/0x00a57090/0x12908e/0x0001a1
msgid "Mmm, love that screaming... Music to my ears."
msgstr "嗯，就爱这惨叫……真悦耳。"

#: slot/0x00a57090/0x12908e/0x0001a2
msgid "Next! Bring 'em in!"
msgstr "下一个！带进来！"

#: slot/0x00a57090/0x12908e/0x0001a3
msgid "Comfy in there?"
msgstr "里面舒服吗？"

#: slot/0x00a57090/0x12908e/0x0001a4
msgid "Quiet in there."
msgstr "里面安静点。"

#: slot/0x00a57090/0x12908e/0x0001a6
#: slot/0x00a57090/0x12908e/0x0001b0
#: slot/0x00a57090/0x12908e/0x0001ba
#: slot/0x00a57090/0x12908e/0x0001c4
#: slot/0x00a57090/0x12908e/0x0001ce
#: slot/0x00a57090/0x12908e/0x0001d8
#: slot/0x00a57090/0x12908e/0x0001e2
#: slot/0x00a57090/0x12908e/0x0001ec
msgid "Reporting for duty!"
msgstr "报到！"

#: slot/0x00a57090/0x12908e/0x0001a7
msgid "Whoa!"
msgstr "哇！"

#: slot/0x00a57090/0x12908e/0x0001a8
msgid "These guys are good..."
msgstr "这些家伙真厉害……"

#: slot/0x00a57090/0x12908e/0x0001a9
msgid "C'mon, let's go!"
msgstr "快，走吧！"

#: slot/0x00a57090/0x12908e/0x0001aa
msgid "You can't beat the best!"
msgstr "你打不过最强！"

#: slot/0x00a57090/0x12908e/0x0001ab
msgid "That's gotta hurt!"
msgstr "那一下肯定很疼！"

#: slot/0x00a57090/0x12908e/0x0001ac
#: slot/0x00a57090/0x12908e/0x0001e8
msgid "I give up."
msgstr "我投降。"

#: slot/0x00a57090/0x12908e/0x0001ad
msgid "That's it...?"
msgstr "就这样……？"

#: slot/0x00a57090/0x12908e/0x0001af
msgid "We... We're done already?!"
msgstr "我……我们已经结束了？！"

#: slot/0x00a57090/0x12908e/0x0001b1
msgid "No wonder he's a legend..."
msgstr "难怪他是传奇……"

#: slot/0x00a57090/0x12908e/0x0001b2
msgid "These guys are for real..."
msgstr "这些家伙是来真的……"

#: slot/0x00a57090/0x12908e/0x0001b3
msgid "That all you got?"
msgstr "你就这点本事？"

#: slot/0x00a57090/0x12908e/0x0001b4
msgid "Think you can take me?"
msgstr "你觉得你能打赢我？"

#: slot/0x00a57090/0x12908e/0x0001b5
msgid "Heh! Yeah!"
msgstr "嘿！没错！"

#: slot/0x00a57090/0x12908e/0x0001b6
msgid "OK, enough."
msgstr "好，够了。"

#: slot/0x00a57090/0x12908e/0x0001b7
msgid "I overestimated you..."
msgstr "我高估你了……"

#: slot/0x00a57090/0x12908e/0x0001b8
msgid "Uh... Are you... "
msgstr "呃…你是…"

#: slot/0x00a57090/0x12908e/0x0001b9
msgid "Wait a minute...!"
msgstr "等等…！"

#: slot/0x00a57090/0x12908e/0x0001bb
msgid "He's strong!"
msgstr "他很强！"

#: slot/0x00a57090/0x12908e/0x0001bc
msgid "This is more like it..."
msgstr "这才像样……"

#: slot/0x00a57090/0x12908e/0x0001bd
#: slot/0x00a57090/0x12908e/0x0001e7
msgid "I'm not done yet!"
msgstr "我还没完！"

#: slot/0x00a57090/0x12908e/0x0001be
#: slot/0x00eeea4a/0x3d5433/0xdaea26
msgid "Show me what you got!"
msgstr "让我看看你的本事！"

#: slot/0x00a57090/0x12908e/0x0001c0
#: slot/0x00a57090/0x12908e/0x0001d4
msgid "You win."
msgstr "你赢了。"

#: slot/0x00a57090/0x12908e/0x0001c1
msgid "This is all ya got...?"
msgstr "就这点本事…？"

#: slot/0x00a57090/0x12908e/0x0001c2
msgid "Uh... Isn't this supposed to be a test?"
msgstr "呃……这不是测试吗？"

#: slot/0x00a57090/0x12908e/0x0001c3
msgid "B-but we're not done with the test yet!"
msgstr "可、可测试还没结束呢！"

#: slot/0x00a57090/0x12908e/0x0001c5
msgid "He's as good as they say!"
msgstr "他果然名不虚传！"

#: slot/0x00a57090/0x12908e/0x0001c6
msgid "Now this is CQC..."
msgstr "这才叫CQC……"

#: slot/0x00a57090/0x12908e/0x0001c7
#: slot/0x00a57090/0x12908e/0x0001ef
msgid "One more time!"
msgstr "再来一次！"

#: slot/0x00a57090/0x12908e/0x0001c8
msgid "You ready for a real challenge? "
msgstr "准备好真挑战了吗？"

#: slot/0x00a57090/0x12908e/0x0001c9
msgid "Got 'em!"
msgstr "搞定！"

#: slot/0x00a57090/0x12908e/0x0001ca
msgid "You win this one."
msgstr "这次你赢了"

#: slot/0x00a57090/0x12908e/0x0001cb
msgid "Not exactly what I expected..."
msgstr "跟我想的不一样…"

#: slot/0x00a57090/0x12908e/0x0001cc
msgid "Did I... do something wrong...?"
msgstr "我做错什么了吗…？"

#: slot/0x00a57090/0x12908e/0x0001cd
msgid "Y-you're joking, right?!"
msgstr "你开玩笑吧？！"

#: slot/0x00a57090/0x12908e/0x0001cf
msgid "Wow!"
msgstr "哇！"

#: slot/0x00a57090/0x12908e/0x0001d0
msgid "Impressive."
msgstr "厉害。"

#: slot/0x00a57090/0x12908e/0x0001d1
msgid "You'll have to do better than that!"
msgstr "你得再加把劲才行！"

#: slot/0x00a57090/0x12908e/0x0001d2
msgid "Let's see what you got!"
msgstr "看看你本事！"

#: slot/0x00a57090/0x12908e/0x0001d3
msgid "How's that?!"
msgstr "怎么样？！"

#: slot/0x00a57090/0x12908e/0x0001d5
msgid "Is that it...?"
msgstr "就这样？"

#: slot/0x00a57090/0x12908e/0x0001d6
msgid "Am I... doing something wrong?"
msgstr "我……做错什么了吗？"

#: slot/0x00a57090/0x12908e/0x0001d7
msgid "You're leaving?! Why?!"
msgstr "你要走？！为什么？！"

#: slot/0x00a57090/0x12908e/0x0001d9
msgid "So this is the legend!"
msgstr "这就是传说！"

#: slot/0x00a57090/0x12908e/0x0001da
msgid "How'd you do that?"
msgstr "你怎么做到的？"

#: slot/0x00a57090/0x12908e/0x0001db
msgid "Just getting warmed up!"
msgstr "才刚热身而已！"

#: slot/0x00a57090/0x12908e/0x0001dc
msgid "You're in for a surprise!"
msgstr "等着大吃一惊吧！"

#: slot/0x00a57090/0x12908e/0x0001dd
msgid "Ohh, yeah!"
msgstr "哦耶！"

#: slot/0x00a57090/0x12908e/0x0001de
msgid "Enough! I lost..."
msgstr "够了！我输了……"

#: slot/0x00a57090/0x12908e/0x0001df
msgid "I expected better than this..."
msgstr "我本以为你更强……"

#: slot/0x00a57090/0x12908e/0x0001e0
msgid "Something the matter?"
msgstr "有什么问题吗？"

#: slot/0x00a57090/0x12908e/0x0001e1
msgid "What?! No, don't go!"
msgstr "什么？！不，别走！"

#: slot/0x00a57090/0x12908e/0x0001e3
msgid "Such power!"
msgstr "好强！"

#: slot/0x00a57090/0x12908e/0x0001e4
msgid "Not bad at all."
msgstr "相当不错。"

#: slot/0x00a57090/0x12908e/0x0001e5
msgid "Come on, give it to me!"
msgstr "来吧，放马过来！"

#: slot/0x00a57090/0x12908e/0x0001e6
msgid "This ought to be fun!"
msgstr "这下有意思了！"

#: slot/0x00a57090/0x12908e/0x0001e9
msgid "What a waste of time!"
msgstr "真是浪费时间！"

#: slot/0x00a57090/0x12908e/0x0001ea
msgid "I-isn't this supposed to be a test?"
msgstr "这、这不是测试吗？"

#: slot/0x00a57090/0x12908e/0x0001eb
msgid "Wait, what about my test?!"
msgstr "等等，我的测试怎么办？！"

#: slot/0x00a57090/0x12908e/0x0001ed
msgid "The stories are true!"
msgstr "传闻是真的！"

#: slot/0x00a57090/0x12908e/0x0001ee
msgid "You're good!"
msgstr "你真厉害！"

#: slot/0x00a57090/0x12908e/0x0001f0
msgid "Watch it! I'm no pushover!"
msgstr "小心！我不好惹！"

#: slot/0x00a57090/0x12908e/0x0001f1
msgid "Hurts, don't it?!"
msgstr "很疼吧？！"

#: slot/0x00a57090/0x12908e/0x0001f2
msgid "OK, you win this one."
msgstr "好，这局你赢了。"

#: slot/0x00a57090/0x12908e/0x0001f3
msgid "That was kinda disappointing."
msgstr "真让人失望。"

#: slot/0x00a57090/0x12908e/0x0001f4
msgid "So, uh... Are we gonna start...? "
msgstr "那，呃…开始吗？"

#: slot/0x00a57090/0x12908e/0x0001f5
msgid "You're no fun..."
msgstr "真没劲…"

#: slot/0x00a57090/0x12908e/0x0001f6
msgid "Intruder detected."
msgstr "发现入侵者。"

#: slot/0x00a57090/0x12908e/0x0001f9
#: slot/0x00a57090/0x12908e/0x000225
msgid "Damn you-u-u..."
msgstr "可恶啊…"

#: slot/0x00a57090/0x12908e/0x0001fa
#: slot/0x00a57090/0x12908e/0x000226
msgid "There you a-a-are!"
msgstr "找到你了！"

#: slot/0x00a57090/0x12908e/0x000200
#: slot/0x00a57090/0x12908e/0x00022c
msgid "I'll get you-u-u..."
msgstr "我会抓到你…"

#: slot/0x00a57090/0x12908e/0x000201
#: slot/0x00a57090/0x12908e/0x00020c
#: slot/0x00a57090/0x12908e/0x000217
#: slot/0x00a57090/0x12908e/0x000222
#: slot/0x00a57090/0x12908e/0x00022d
#: slot/0x00a57090/0x12908e/0x000238
#: slot/0x00a57090/0x12908e/0x000243
#: slot/0x00a57090/0x12908e/0x00024e
msgid "Who goes there..."
msgstr "什么人……"

#: slot/0x00a57090/0x12908e/0x000202
#: slot/0x00a57090/0x12908e/0x00022e
msgid "Hmm...?"
msgstr "嗯？"

#: slot/0x00a57090/0x12908e/0x000204
#: slot/0x00a57090/0x12908e/0x000230
msgid "Nevermore..."
msgstr "永不复还……"

#: slot/0x00a57090/0x12908e/0x000205
#: slot/0x00a57090/0x12908e/0x000231
msgid "I've got you now-w-w!"
msgstr "抓到你了了了！"

#: slot/0x00a57090/0x12908e/0x00020b
msgid "You can't run from me-e-e..."
msgstr "你逃不出我手心…"

#: slot/0x00a57090/0x12908e/0x00020d
#: slot/0x00a57090/0x12908e/0x000239
msgid "Nnn...?"
msgstr "唔？"

#: slot/0x00a57090/0x12908e/0x00020f
msgid "I'll be ba-a-ack..."
msgstr "我会回来…"

#: slot/0x00a57090/0x12908e/0x000210
#: slot/0x00a57090/0x12908e/0x00023c
msgid "You can't hide from me-e-e!"
msgstr "你躲不过我我我！"

#: slot/0x00a57090/0x12908e/0x000216
#: slot/0x00a57090/0x12908e/0x000242
msgid "I'm going to get you-u-u..."
msgstr "我要抓住你啊啊……"

#: slot/0x00a57090/0x12908e/0x000218
#: slot/0x00a57090/0x12908e/0x000244
msgid "Ahh...?"
msgstr "啊？"

#: slot/0x00a57090/0x12908e/0x00021a
msgid "Curse you-u-u..."
msgstr "该死的…"

#: slot/0x00a57090/0x12908e/0x00021b
msgid "A-aha-a-a!"
msgstr "啊哈哈！"

#: slot/0x00a57090/0x12908e/0x000221
#: slot/0x00a57090/0x12908e/0x00024d
msgid "You can't run forever-r-r..."
msgstr "你逃不了一辈子…"

#: slot/0x00a57090/0x12908e/0x000237
msgid "There's no escape…"
msgstr "无处可逃……"

#: slot/0x00a57090/0x12908e/0x00023b
msgid "You'll pay-y-y..."
msgstr "你会付出代价价价……"

#: slot/0x00a57090/0x12908e/0x000246
msgid "A curse upon you-u-u..."
msgstr "诅咒你…"

#: slot/0x00a57090/0x12908e/0x000247
msgid "A-a ha-a-a!"
msgstr "啊哈哈！"

#: slot/0x00a57090/0x12908e/0x00024f
msgid "Ehh...?"
msgstr "诶？"

#: slot/0x00a57090/0x12908e/0x000251
msgid "Hm?  What are you doing?!"
msgstr "嗯？干嘛？！"

#: slot/0x00a57090/0x12908e/0x000252
msgid "Eh? You're not going anywhere!"
msgstr "呃？你哪儿也别想去！"

#: slot/0x00a57090/0x12908e/0x000253
msgid "Huh? ...Hm, checks out OK."
msgstr "咦？……嗯，检查没问题。"

#: slot/0x00a57090/0x12908e/0x000254
msgid "You! Stop!"
msgstr "你！站住！"

#: slot/0x00a57090/0x12908e/0x000255
msgid "Break time!"
msgstr "休息！"

#: slot/0x00a57090/0x12908e/0x000256
msgid "Your turn!"
msgstr "轮到你了！"

#: slot/0x00a57090/0x12908e/0x000257
msgid "Whatcha got here?"
msgstr "藏了啥？"

#: slot/0x00a57090/0x12908e/0x000258
msgid "Prisoner escaped! Security team, search the area!"
msgstr "囚犯逃跑了！警卫队，搜索区域！"

#: slot/0x00a57090/0x12908e/0x000259
#: slot/0x00e2e8b4/0x9eda9d/0x000000
msgid "Nice try!"
msgstr "想得美！"

#: slot/0x00a57090/0x12908e/0x00025a
msgid "Ya hear that? You'll be singing the same tune before long."
msgstr "听见没？你迟早也会唱同一出戏。"

#: slot/0x00a57090/0x12908e/0x00025b
msgid "Who's next? Get 'em in here!"
msgstr "下一个谁？带进来！"

#: slot/0x00a57090/0x12908e/0x00025c
msgid "Don't be getting any ideas."
msgstr "别动什么歪脑筋。"

#: slot/0x00a57090/0x12908e/0x00025d
msgid "Quiet, you."
msgstr "闭嘴。"

#: slot/0x00a57090/0x12908e/0x00025e
msgid "STOP IT!"
msgstr "住手！"

#: slot/0x00a57090/0x12908e/0x00025f
msgid "Blue team, search for the intruders. Gold team, guard the elevators. Go!"
msgstr "蓝队，搜索入侵者。金队，守住电梯。行动！"

#: slot/0x00a57090/0x12908e/0x000261
#: slot/0x00dff09b/0xaf8d11/0x00003c
msgid "Got it!"
msgstr "明白！"

#: slot/0x00a57090/0x12908e/0x000262
msgid "Yes, sir!"
msgstr "是！"

#: slot/0x00a57090/0x12908e/0x000263
msgid "They're calling for backup up top. Come on!"
msgstr "上面在叫增援。快走！"

#: slot/0x00a57090/0x12908e/0x000264
msgid "Right behind you!"
msgstr "跟在你后面！"

#: slot/0x00a57090/0x12908e/0x000271
msgid "They'll never find me here..."
msgstr "他们找不到我……"

#: slot/0x00a57090/0x12908e/0x000272
msgid "Fools..."
msgstr "蠢货……"

#: slot/0x00a57df4/0x24576f/0xe05055
msgid "Undo the prisoner's restraints."
msgstr "解开囚犯的束缚。"

#: slot/0x00a57df4/0x24576f/0xe15055
msgid ""
"Open the cell door.\n"
msgstr ""
"打开牢房门。\n"

#: slot/0x00a57df4/0x24576f/0xe25055
msgid "Increase the voltage."
msgstr "提高电压。"

#: slot/0x00a57df4/0x24576f/0xe35055
msgid "Decrease the voltage."
msgstr "降低电压。"

