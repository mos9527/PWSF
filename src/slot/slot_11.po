msgstr "雷达罩受损。"

#: slot/0x00472837/0x0a7cd6/0x000021
msgid "Take this!!"
msgstr "接招！"

#: slot/0x00472837/0x0a7cd6/0x000023
msgid "I'll send you straight to hell!"
msgstr "我直接送你下地狱！"

#: slot/0x00472837/0x0a7cd6/0x000026
msgid "There you are!"
msgstr "找到你！"

#: slot/0x00472837/0x0a7cd6/0x000027
msgid "Fly, my Kidnappers!!"
msgstr "上吧，我的绑架者！！"

#: slot/0x00472837/0x0a7cd6/0x000028
msgid "Attack mode."
msgstr "攻击模式。"

#: slot/0x00472837/0x0a7cd6/0x000029
