msgid "Lock disengaged."
msgstr "锁定解除。"

#: slot/0x00472837/0x0a7cd6/0x000001
#: slot/0x00472837/0x0a7cd6/0x000011
msgid "Chaingun."
msgstr "机炮。"

#: slot/0x00472837/0x0a7cd6/0x000003
#: slot/0x00472837/0x0a7cd6/0x000013
#: slot/0x0052801a/0x0a7cd6/0x00001c
msgid "Charging railgun."
msgstr "电磁炮充能。"

#: slot/0x00472837/0x0a7cd6/0x000006
msgid "Approaching target."
msgstr "接近目标。"

#: slot/0x00472837/0x0a7cd6/0x000007
#: slot/0x00472837/0x0a7cd6/0x000017
