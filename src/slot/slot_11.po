#: slot/0x00db94df/0x94ec80/0x000000
#: slot/0x00dff0a5/0xa84a6a/0x000060
msgid "What?!"
msgstr "什么？！"

#: slot/0x00472837/0x0a7cd6/0x00002c
msgid "Damn you!"
msgstr "可恶！"

#: slot/0x00472837/0x0a7cd6/0x00002f
msgid "Let's try that again."
msgstr "再试一次。"

#: slot/0x00472837/0x0a7cd6/0x000030
#: slot/0x00a57090/0x12908e/0x0001f8
msgid "Initiating capture."
msgstr "开始捕获。"

#: slot/0x00472837/0x0a7cd6/0x000031
msgid "Recalling Kidnappers."
msgstr "召回绑架者。"

#: slot/0x00472837/0x0a7cd6/0x000032
msgid "Recalling Kidnappers!"
msgstr "召回绑架者！"

#: slot/0x00472837/0x0a7cd6/0x000033
msgid "Kidnappers, come back!"
msgstr "绑架者，回来！"

#: slot/0x00483717/0x0a7cd6/0x000001
#: slot/0x00483717/0x0a7cd6/0x00000b
msgid "Emergency override complete. Reinitializing."
msgstr "紧急覆写完成。重新初始化。"

#: slot/0x00483717/0x0a7cd6/0x000002
#: slot/0x00483717/0x0a7cd6/0x00000c
msgid "Missile target acquired."
msgstr "导弹已锁定目标。"

#: slot/0x00483717/0x0a7cd6/0x000003
#: slot/0x00483717/0x0a7cd6/0x00000d
msgid "Commencing area attack!"
msgstr "开始区域攻击！"

#: slot/0x00483717/0x0a7cd6/0x000004
#: slot/0x00483717/0x0a7cd6/0x00000e
#: slot/0x0052801a/0x0a7cd6/0x00002d
