msgstr "你干什么！你会后悔的！"

#: slot/0x0081443c/0xa270a1/0x000190
msgid "H-help...!"
msgstr "救、救命……！"

#: slot/0x0081443c/0xa270a1/0x0001f4
msgid "There's a prisoner..."
msgstr "有个囚犯……"

#: slot/0x0081443c/0xa270a1/0x000258
