msgstr "重新初始化平台！"

#: slot/0x00ce245c/0x0a7cd6/0x000024
#: slot/0x00ce245c/0x0a7cd6/0x000046
msgid "Self-defense system online!"
msgstr "自卫系统上线！"

#: slot/0x00ce245c/0x0a7cd6/0x000025
#: slot/0x00ce245c/0x0a7cd6/0x000047
