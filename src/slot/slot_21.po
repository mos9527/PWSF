msgstr "火焰喷射器启动！"

#: slot/0x00ce245c/0x0a7cd6/0x000027
msgid "Launching S mines!"
msgstr "发射S地雷！"

#: slot/0x00ce245c/0x0a7cd6/0x000028
msgid "Firing rocket launcher!"
msgstr "发射火箭筒！"

#: slot/0x00ce245c/0x0a7cd6/0x000029
msgid "Firing drill missiles!"
msgstr "发射钻头导弹！"

#: slot/0x00ce245c/0x0a7cd6/0x00002b
#: slot/0x00ce245c/0x0a7cd6/0x00004d
msgid "EM pulse at maximum!"
msgstr "电磁脉冲满！"

#: slot/0x00ce245c/0x0a7cd6/0x00002c
#: slot/0x00ce245c/0x0a7cd6/0x00004e
msgid "Leg drive motor charging!"
msgstr "腿驱电机充能！"

#: slot/0x00ce245c/0x0a7cd6/0x00002d
#: slot/0x00ce245c/0x0a7cd6/0x00004f
msgid "Jump engaged!"
msgstr "跳跃启动"

#: slot/0x00ce245c/0x0a7cd6/0x000042
#: slot/0x00ce245c/0x0a7cd6/0x000064
msgid "It can't be."
msgstr "不可能。"

#: slot/0x00ce245c/0x0a7cd6/0x000043
msgid "Bring it on. "
msgstr "放马过来"

#: slot/0x00ce245c/0x0a7cd6/0x000048
msgid "Flamethrower!"
msgstr "喷火器！"

#: slot/0x00ce245c/0x0a7cd6/0x000049
msgid "Try this on for size!"
msgstr "尝尝这个！"

#: slot/0x00ce245c/0x0a7cd6/0x00004a
msgid "How do you like this?"
msgstr "这招如何？"

#: slot/0x00ce245c/0x0a7cd6/0x00004c
msgid "Poison beam!"
msgstr "毒光束！"

#: slot/0x00ce245c/0x0a7cd6/0x000050
msgid "Initializing nuclear launch sequence!"
msgstr "初始化核弹发射序列！"

#: slot/0x00ce245c/0x0a7cd6/0x000051
msgid "Launch angle set!"
msgstr "发射角度设定！"

#: slot/0x00ce245c/0x0a7cd6/0x000052
msgid "Opening missile hatch!"
msgstr "打开导弹舱口！"

#: slot/0x00ce245c/0x0a7cd6/0x000053
msgid "Commencing pre-ignition!"
msgstr "开始预点火！"

#: slot/0x00ce245c/0x0a7cd6/0x000054
msgid "10!"
msgstr ""

#: slot/0x00ce245c/0x0a7cd6/0x000055
msgid "9!"
msgstr ""

#: slot/0x00ce245c/0x0a7cd6/0x000056
msgid "8!"
msgstr ""

#: slot/0x00ce245c/0x0a7cd6/0x000057
