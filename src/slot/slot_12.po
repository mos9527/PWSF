msgstr "关于SBM091"

#: slot/0x00514128/0x215635/0x7c1b22
msgid "ABOUT SBM111"
msgstr "关于SBM111"

#: slot/0x00514128/0x215635/0x7d1b1e
msgid ""
"<C=FF4040>Retrieve all the items<C=R> from the Cloud Forest of Central Heredia. <C=FF4040>Beware of Ghosts<C=R>.\n"
"<C=FF4040>No LIFE regeneration items or weapons allowed<C=R>.\n"
"  Time Limit: 12:00\n"
"  Time Penalty: 1 min. for triggering an alert\n"
"  # of Targets: 5"
msgstr "<C=FF4040>取得中埃雷迪亚云雾林内所有物品<C=R>。<C=FF4040>当心幽灵<C=R>。\n<C=FF4040>禁止使用生命值回复道具与武器<C=R>。\n  时间限制：12:00\n  时间惩罚：触发警报罚1分钟\n  目标数：5"

