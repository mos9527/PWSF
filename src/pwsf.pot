#: olang/009c9ea4/0x62997d/0x000000
msgid ""
"To move your line of sight, \n"
"use <I=CAMERA>."
msgstr ""

#: olang/009c9ea4/0x076bed/0x000001
msgid ""
"Now, when I give you an order, \n"
"look in that direction."
msgstr ""

#: olang/009c9ea4/0x076de5/0x000000
msgid ""
"Alright, let’s try up and down with\n"
"<I=CAMERA> one more time."
msgstr ""

#: olang/009c9ea4/0x076ded/0x000000
msgid ""
"Alright, let’s try left and right with\n"
"<I=CAMERA> one more time."
msgstr ""

#: olang/009c9ea4/0x077dd9/0x000000
msgid "To do this,"
msgstr ""

#: olang/009c9ea4/0x077dd9/0x000001
#: olang/009c9ea4/0x644bfd/0x000001
msgid "position yourself near your opponent"
msgstr ""

#: olang/009c9ea4/0x077dd9/0x000002
msgid ""
"and press <I=ATK> \n"
"while you press <I=MOVE>."
msgstr ""

#: olang/009c9ea4/0x077dd9/0x000003
#: olang/009c9ea4/0x644bfd/0x000003
#: olang/009c9ea4/0x644bfe/0x000002
msgid ""
"Be sure to press <I=ATK> \n"
"when the icon appears."
msgstr ""

#: olang/009c9ea4/0x077dd9/0x000004
msgid ""
"Now, wait for my command \n"
"and throw your opponent."
msgstr ""

#: olang/009c9ea4/0x077ea9/0x000000
#: olang/009c9ea4/0x6458fd/0x000000
#: olang/009c9ea4/0x6458fe/0x000000
msgid "Boss,"
msgstr ""

#: olang/009c9ea4/0x077ea9/0x000001
msgid ""
"you have to press <I=ATK> \n"
"as you press <I=MOVE>!"
msgstr ""

#: olang/009c9ea4/0x077fd1/0x000000
#: olang/009c9ea4/0x646b7d/0x000000
msgid "To throw an enemy to the ground,"
msgstr ""

#: olang/009c9ea4/0x077fd1/0x000001
msgid "press <I=MOVE> when you have them restrained."
msgstr ""

