#: olang/0005ee2f/0xc6de03/0x02d356 olang/0005ee2f/0xc6de03/0x17b115
#: olang/0005ee2f/0xc6de03/0x262ccd olang/0005ee2f/0xc6de03/0xae4364
msgid "Human voice"
msgstr "人声"

#: olang/0005ee2f/0xc6de03/0x069574
msgid "Screen Display"
msgstr "画面显示"

#: olang/0005ee2f/0xc6de03/0x094877
msgid ""
"Move the screen position using the left stick.\n"
"Change the zoom level with LT and RT.\n"
"Press <I=DEC> to apply your changes.\n"
"To restore the default display settings, press <I=△>."
msgstr "用左摇杆移动画面位置。\n用LT和RT调整缩放。\n按<I=DEC>应用更改。\n按<I=△>恢复默认显示设置。"

#: olang/0005ee2f/0xc6de03/0x1889b7 olang/0005ee2f/0xc6de03/0x3726d7
msgid "Magazines"
msgstr "杂志"

#: olang/0005ee2f/0xc6de03/0x196f19
msgid "Pupa Voices"
msgstr "蛹语音"

#: olang/0005ee2f/0xc6de03/0x1aa0b2 olang/0005ee2f/0xc6de03/0x2f7e71
#: olang/0005ee2f/0xc6de03/0x3dfa29 olang/0005ee2f/0xc6de03/0xc610c0
msgid "Default voice"
msgstr "默认语音"

#: olang/0005ee2f/0xc6de03/0x27f9e4 olang/0005ee2f/0xc6de03/0x7c6806
#: olang/0005ee2f/0xc6de03/0xdba915
msgid "Change which AI weapon voices are used in the game."
msgstr "更改游戏中使用的AI武器语音。"

#: olang/0005ee2f/0xc6de03/0x284a42
msgid ""
"Edit screen display settings.\n"
"Adjust the display until the red lines surrounding\n"
"the background fit the screen perfectly."
msgstr "编辑画面显示设置。\n调整显示，使背景四周的红线\n与屏幕完全重合。"

#: olang/0005ee2f/0xc6de03/0x2cc2b4
msgid "Edit screen display settings and change which AI weapon voices are used in the game."
msgstr "编辑画面显示设置及游戏中的AI武器语音。"

#: olang/0005ee2f/0xc6de03/0x3850a3 olang/009c9ea4/0xc6de03/0x3850a3
msgid "Basilisk Voices"
msgstr "蛇怪语音"

#: olang/0005ee2f/0xc6de03/0x3a136d
msgid "VOICE"
msgstr "语音"

#: olang/0005ee2f/0xc6de03/0x3da827
msgid "Return to title menu"
msgstr "返回标题菜单"

#: olang/0005ee2f/0xc6de03/0x3db471 olang/0005ee2f/0xc6de03/0x91b2b1
msgid "AI Weapon Voices"
msgstr "AI 兵器语音"

#: olang/0005ee2f/0xc6de03/0x47c178
msgid "TEXTURES"
msgstr "贴图"

#: olang/0005ee2f/0xc6de03/0x50a352 olang/0005ee2f/0xc6de03/0xb7f4ae
#: olang/00cb1fb7/0x68bb2b/0x010dcc
msgid "All"
msgstr "全部"

#: olang/0005ee2f/0xc6de03/0x51550b
msgid "Return to title menu."
msgstr "返回标题菜单。"

#: olang/0005ee2f/0xc6de03/0x562679
msgid "Cocoon Voices"
msgstr "茧语音"

#: olang/0005ee2f/0xc6de03/0x77305a
msgid "Chrysalis Voices"
msgstr "蝶蛹语音"

#: olang/0005ee2f/0xc6de03/0x9e1df8
msgid "Edit screen display settings."
msgstr "编辑画面显示设置。"

#: olang/0005ee2f/0xc6de03/0xe12fec
msgid "Change which magazine is used in the game."
msgstr "更改游戏中使用的杂志。"

#: olang/0005ee2f/0xc6de03/0xe280fd
msgid "Data Management"
msgstr "数据管理"

#: olang/00327f6a/0xb39048/0xc81e47 olang/0060e2f2/0xd449d6/0x42ab9e
#: olang/00cb1fb7/0x68bb2b/0x42ab9e olang/00cb1fb7/0x68bb2b/0xc81e47
msgid ""
"Unable to find a HOST.\n"
"Try again after changing the search conditions or waiting for a short period of time."
msgstr "未找到主机。\n请更改搜索条件或稍后再试。"

#: olang/00327f6a/0xb39048/0xf4816f
msgid ""
"You can recruit trade partners worldwide over Xbox LIVE.\n"
"Select the type of invitation."
msgstr "可通过 Xbox LIVE 招募全球贸易伙伴。\n请选择邀请类型。"

#: olang/0043da6e/0x029324/0x2e012f
msgid "Failed to connect."
msgstr "连接失败。"

#: olang/0043da6e/0xc3d5b4/0x024ebc olang/0043da6e/0xc3d5b4/0xd851e8
#: olang/005184e3/0x029324/0x8a774e
msgid "Unable to connect to Xbox LIVE."
msgstr "无法连接 Xbox LIVE。"

#: olang/0043da6e/0xc3d5b4/0x043ff0
msgid "Confirm"
msgstr "确认"

#: olang/0043da6e/0xc3d5b4/0x192971
msgid ""
"You cannot continue playing because a change has been made to your sign in status.\n"
"You will now return to the title menu."
msgstr "登录状态已变更，无法继续游戏。\n即将返回标题菜单。"

#: olang/0043da6e/0xc3d5b4/0x20abf0
msgid "All other members have been disconnected. A single player game will begin."
msgstr "其他成员已全部断开。将开始单人游戏。"

#: olang/0043da6e/0xc3d5b4/0x434337
msgid "You need to be signed into Xbox LIVE to proceed any further."
msgstr "需登录 Xbox LIVE 才能继续。"

#: olang/0043da6e/0xc3d5b4/0x508f74
msgid "Connection to Xbox LIVE has been terminated."
msgstr "与 Xbox LIVE 的连接已断开。"

#: olang/0043da6e/0xc3d5b4/0x58bcd8
msgid "You cannot play online using the current gamer profile."
msgstr "当前玩家档案无法进行在线游戏。"

#: olang/0043da6e/0xc3d5b4/0x7a57b9
msgid "You cannot receive this invite as you are already in a room."
msgstr "你已在房间中，无法接收此邀请。"

#: olang/0043da6e/0xc3d5b4/0x932c67 olang/009c9ea4/0xc3d5b4/0x932c67
msgid "You cannot join this game as the mode cannot be played while using the current save data."
msgstr "当前存档数据无法进行该模式，无法加入此游戏。"

#: olang/0043da6e/0xc3d5b4/0xa75e7b
msgid "Unable to create room."
msgstr "无法创建房间。"

#: olang/0043da6e/0xc3d5b4/0xb0be5c
msgid "You must select a storage device to save data in order to start the game."
msgstr "需选择存储设备以保存数据才能开始游戏。"

#: olang/0043da6e/0xc3d5b4/0xb8dc0d
msgid ""
"The system data on the selected storage device was created by another gamer profile.\n"
"If you continue, you will be unable to save the game during play.\n"
"Continue?"
msgstr "所选存储设备上的系统数据由其他玩家设定档创建。\n若继续，游戏过程中将无法保存。\n是否继续？"

#: olang/0043da6e/0xc3d5b4/0xcb23b3
msgid "Room deleted by HOST."
msgstr "房间已被主机删除。"

#: olang/0043da6e/0xc3d5b4/0xd5a07d
msgid "Unable to search for room."
msgstr "无法搜索房间。"

#: olang/0043da6e/0xc3d5b4/0xe16f1d
msgid "The network connection has been terminated. A single player game will begin."
msgstr "网络连接已中断。将开始单人游戏。"

#: olang/0043da6e/0xc3d5b4/0xf11e61
msgid "Unable to join room."
msgstr "无法进房。"

#: olang/0043da6e/0xc3d5b4/0xf8f04e
msgid "The save data on the selected storage device was created by another gamer profile and so cannot be loaded."
msgstr "所选存储设备上的存档由其他玩家设定档创建，无法读取。"

#: olang/0043da6e/0xc3d5b4/0xf98609
msgid "Connection with HOST terminated."
msgstr "与主机的连接已中断。"

#: olang/0043da6e/0xc3d5b4/0xfb72a4
msgid "You must be signed in to a gamer profile to save data in order to start the game."
msgstr "需登录玩家设定档才能保存数据并开始游戏。"

#: olang/005184e3/0x029324/0x4b1cfb
msgid "Unable to sign in to Xbox LIVE."
msgstr "无法登录 Xbox LIVE。"

#: olang/005184e3/0x029324/0x61d95e
msgid ""
"An error has occurred.\n"
"Please verify that the Date & Time settings on your Xbox 360 console are correct."
msgstr "发生错误。\n请确认 Xbox 360 主机的日期与时间设置是否正确。"

#: olang/005184e3/0x1331ad/0xbbc0e2
msgid "Please verify the Date & Time settings on your Xbox 360 console. Incorrect date settings may interfere with package deliveries."
msgstr "请确认 Xbox 360 主机的日期与时间设置。日期设置错误可能影响包裹送达。"

#: olang/005184e3/0x19f879/0x01fbc4
msgid "Join a game created by another player."
msgstr "加入其他玩家创建的游戏。"

#: olang/005184e3/0x19f879/0x5e057c
msgid "SELECT HOSTING CONDITIONS"
msgstr "选择主机条件"

#: olang/005184e3/0x19f879/0x668dca
msgid "Create and host and a new versus game."
msgstr "创建并主持新的对战游戏。"

#: olang/005184e3/0x19f879/0x75954d
msgid "SELECT SEARCH CONDITIONS"
msgstr "选择搜索条件"

#: olang/005184e3/0x19f879/0x84bf02
msgid "<Add Stage>"
msgstr "<添加关卡>"

#: olang/005184e3/0x19f879/0x92ac58
msgid "Connect to Xbox LIVE and battle players from around the world. 2 teams of up to 3 players are allowed."
msgstr "连接Xbox LIVE，与全球玩家对战。每队最多3人，共2队。"

#: olang/005184e3/0x19f879/0xa57bdd
msgid ""
"Press up or down on the directional pad to select a Channel.\n"
"Press <I=DEC> to start hosting."
msgstr "按方向键上下选择频道。\n按<I=DEC>开始创建。"

#: olang/005184e3/0x19f879/0xc297b4 olang/009c9ea4/0x19f879/0xc297b4
msgid "Press the <I=DEC> button to change the password."
msgstr "按<I=DEC>键更改密码。"

#: olang/005184e3/0x1a3e77/0x6a33a6 olang/009c9ea4/0x1a3e77/0x6a33a6
msgid "Enlarge: <I=L2>"
msgstr "放大：<I=L2>"

#: olang/005184e3/0x1a3e77/0x6a33a7 olang/009c9ea4/0x1a3e77/0x6a33a7
msgid "Reduce: <I=R2>"
msgstr "缩小<I=R2>"

#: olang/005184e3/0x1a3e77/0x6a33a8
msgid "Rotate Camera: Right stick"
msgstr "旋转镜头：右摇杆"

#: olang/005184e3/0x1a3e77/0x6a33a9 olang/005184e3/0x5f753b/0x88adbe
msgid "Switch Cameras: Directional pad left/right"
msgstr "切换镜头：方向键左右"

#: olang/005184e3/0x20dacf/0x661129
msgid "Save play data."
msgstr "保存游戏数据。"

#: olang/005184e3/0x20dacf/0x6c9043
msgid "Accepted a volunteer. Volunteers increase as you play online."
msgstr "已接受一名志愿者。在线游玩可增加志愿者。"

#: olang/005184e3/0x20dacf/0xa08aca olang/005184e3/0x43f3a5/0x47e5fe
#: olang/005184e3/0xe6e4ed/0xb96848 olang/009c9ea4/0x20dacf/0xa08aca
#: olang/009c9ea4/0x43f3a5/0x47e5fe olang/009c9ea4/0xe6e4ed/0xb96848
msgid "Confirm or change controls."
msgstr "确认或更改操作。"

#: olang/005184e3/0x20dacf/0xac79ca olang/005184e3/0x43f3a5/0x506452
#: olang/005184e3/0xe6e4ed/0xb7fd8f olang/005184e3/0xfb5d7b/0x96ec94
msgid "BUTTON CONFIG"
msgstr "按键设置"

#: olang/005184e3/0x215635/0x15aca6
msgid ""
"Proceed immediately to the Control Tower and stop Peace Walker from launching its nukes.\n"
"The WALKMAN cannot be equipped."
msgstr "立即前往管制塔，阻止和平行者发射核弹。\n无法装备WALKMAN。"

#: olang/005184e3/0x215635/0x17015a olang/009c9ea4/0x215635/0x17015a
msgid ""
"Snake encounters a mysterious \"visitor\" on the coast of Costa Rica.\n"
"\n"
"<I=CPY>CAPCOM CO., LTD."
msgstr "SNAKE在哥斯达黎加海岸遇到神秘的“访客”。\n\n<I=CPY>CAPCOM CO., LTD."

#: olang/005184e3/0x215635/0x18015a olang/009c9ea4/0x215635/0x18015a
msgid ""
"Snake accepts an invitation from Trenya and heads to Isla del Monstruo.\n"
"  From <<Hunting Quests>>\n"
"<I=CPY>CAPCOM CO., LTD."
msgstr "SNAKE接受Trenya的邀请，前往怪物岛。\n  来自《狩猎任务》\n<I=CPY>CAPCOM CO., LTD."

#: olang/005184e3/0x215635/0x3cb479 olang/005184e3/0x215635/0xd1f145
msgid "MSF Entrance Exam"
msgstr "MSF入队考试"

#: olang/005184e3/0x215635/0x4a3800 olang/005184e3/0x215635/0xe00d7b
msgid "[097] Tank Battle: MBTk-70"
msgstr "[097] 坦克战：MBTk-70"

#: olang/005184e3/0x215635/0x4a3dc0 olang/005184e3/0x215635/0xf70d7b
msgid "[098] Tank Battle: MBTk-70 Custom"
msgstr "[098] 坦克战：MBTk-70 Custom"

#: olang/005184e3/0x215635/0x95b11d olang/005184e3/0x215635/0x9ab11d
#: olang/009c9ea4/0x215635/0x95b11d olang/009c9ea4/0x215635/0x9ab11d
msgid ""
"  Mission Location: Isla del Monstruo\n"
"<C=FF4040>Hunt the Rathalos<C=R>.\n"
"\n"
"<I=CPY>CAPCOM CO., LTD."
msgstr "任务地点：怪物岛\n<C=FF4040>狩猎火龙<C=R>。\n\n<I=CPY>CAPCOM CO., LTD."

#: olang/005184e3/0x215635/0xb5b11d olang/005184e3/0x215635/0xbab11d
#: olang/009c9ea4/0x215635/0xb5b11d olang/009c9ea4/0x215635/0xbab11d
msgid ""
"  Mission Location: Isla del Monstruo\n"
"<C=FF4040>Hunt the Tigrex<C=R>.\n"
"\n"
"<I=CPY>CAPCOM CO., LTD."
msgstr "任务地点：怪物岛\n<C=FF4040>狩猎轰龙<C=R>。\n\n<I=CPY>CAPCOM CO., LTD."

#: olang/005184e3/0x215635/0xd5b11d olang/005184e3/0x215635/0xdab11d
#: olang/009c9ea4/0x215635/0xd5b11d olang/009c9ea4/0x215635/0xdab11d
msgid ""
"  Mission Location: Isla del Monstruo\n"
"<C=FF4040>Hunt the Gear REX<C=R>.\n"
"\n"
"<I=CPY>CAPCOM CO., LTD."
msgstr "任务地点：怪物岛\n<C=FF4040>狩猎霸王<C=R>。\n\n<I=CPY>CAPCOM CO., LTD."

#: olang/005184e3/0x291428/0x50818e olang/005184e3/0x9dc379/0xdb198e
#: olang/005184e3/0xc99c23/0x50818e
msgid "BACK button"
msgstr "BACK键"

#: olang/005184e3/0x2a29c5/0x000000 olang/005184e3/0x2a4a05/0x000000
#: olang/005184e3/0x2a6a45/0x000000 olang/005184e3/0x2d4a85/0x000000
#: olang/005184e3/0x3127c5/0x000000 olang/005184e3/0x314805/0x000000
#: olang/005184e3/0x316845/0x000000 olang/005184e3/0x344885/0x000000
msgid "Hey, lemme borrow that."
msgstr "喂，借我用下。"

#: olang/005184e3/0x2d0e66/0xf19383 olang/005184e3/0x2d0e6b/0xf19383
msgid "Right stick"
msgstr "右摇杆"

#: olang/005184e3/0x2d0e67/0xf29383 olang/005184e3/0x2d0e69/0xf29383
msgid ""
"Press the Action Button to confirm \n"
"Right stick up: Look Up\n"
"Right stick down: Look Down"
msgstr "按动作键确认 \n右摇杆上：向上看\n右摇杆下：向下看"

#: olang/005184e3/0x2d0e68/0xf29383 olang/005184e3/0x2d0e6a/0xf29383
msgid ""
"Press the Action Button to confirm \n"
"Right stick up: Look Down\n"
"Right stick down: Look Up"
msgstr "按动作键确认 \n右摇杆上：向下看\n右摇杆下：向上看"

#: olang/005184e3/0x2d0e6c/0xf29383 olang/005184e3/0x2d0e6e/0xf29383
msgid ""
"Press the Action Button to confirm \n"
"Right stick left: Look Left\n"
"Right stick right: Look Right"
msgstr "按动作键确认 \n右摇杆左：向左看\n右摇杆右：向右看"

#: olang/005184e3/0x2d0e6d/0xf29383 olang/005184e3/0x2d0e85/0xf29383
msgid ""
"Press the Action Button to confirm \n"
"Right stick left: Look Right\n"
"Right stick right: Look Left"
msgstr "按动作键确认 \n右摇杆左：向右看\n右摇杆右：向左看"

#: olang/005184e3/0x2d0e87/0xf19383 olang/005184e3/0x2d0ea5/0xf19383
msgid "Left stick"
msgstr "左摇杆"

#: olang/005184e3/0x2d0e88/0xf19383
msgid "Left stick + (tap) Attack Button"
msgstr "左摇杆 + (轻按) 攻击键"

#: olang/005184e3/0x2d0e89/0xf19383
msgid "Left stick + Crouch Button"
msgstr "左摇杆 + 蹲伏键"

#: olang/005184e3/0x2d0e8d/0xf19383
msgid "Left stick + Attack Button"
msgstr "左摇杆 + 攻击键"

#: olang/005184e3/0x2d0ea8/0xf19383
msgid "Left stick + Hand-to-hand Attack Button"
msgstr "左摇杆 + 徒手攻击键"

#: olang/005184e3/0x4282bf/0x000000 olang/005184e3/0x4a8abf/0x000000
#: olang/005184e3/0xb666bf/0x000000 olang/005184e3/0xbe6ebf/0x000000
msgid "Don't move!"
msgstr "别动！"

#: olang/005184e3/0x43f3a5/0x394f17 olang/0072f326/0xa49217/0x2de9a9
msgid ""
"Select your control scheme.  \n"
"\n"
"SHOOTER TYPE: The configuration is similar to that of \"MGS4.\"\n"
"\n"
"ACTION TYPE: The configuration is similar to that of \"MPO.\"\n"
"\n"
"HUNTER TYPE: The configuration is similar to that of the MONSTER HUNTER FREEDOM<I=TM> series."
msgstr "选择操作方式。  \n\n射击型：与《MGS4》相近。\n\n动作型：与《MPO》相近。\n\n猎人型：与《怪物猎人 自由<I=TM>》系列相近。"

#: olang/005184e3/0x4686bf/0x000000 olang/005184e3/0x4e8ebf/0x000000
#: olang/005184e3/0xb262bf/0x000000 olang/005184e3/0xba6abf/0x000000
#: olang/005184e3/0xc2c774/0x000000 olang/009c9ea4/0x903077/0x000014
#: olang/009c9ea4/0xbc4a75/0x000008
msgid "Freeze!"
msgstr "不许动！"

#: olang/005184e3/0x4882d7/0x000000 olang/005184e3/0x4e86d7/0x000000
#: olang/005184e3/0x7062d8/0x000000 olang/005184e3/0x7666d8/0x000000
#: olang/005184e3/0x7c6ad8/0x000000 olang/005184e3/0x808ad7/0x000000
#: olang/005184e3/0x826ed8/0x000000 olang/005184e3/0x868ed7/0x000000
msgid "Next!"
msgstr "下一个！"

#: olang/005184e3/0x529072/0x000002
msgid "Hit the Y button as fast as you can!"
msgstr "尽快连按 Y 键！"

#: olang/005184e3/0x5d8989/0xb3e6dc
msgid "Press the X button to select which soldier to assign."
msgstr "按 X 键选择要派遣的士兵。"

#: olang/005184e3/0x5f753b/0x28adbc olang/005184e3/0x5f753b/0x48adbc
#: olang/005184e3/0x5f753b/0x88adbc olang/005184e3/0x5f753b/0xa8adbc
#: olang/005184e3/0x5f753b/0xc8adbc olang/009c9ea4/0x5f753b/0x28adbc
#: olang/009c9ea4/0x5f753b/0x48adbc olang/009c9ea4/0x5f753b/0x88adbc
#: olang/009c9ea4/0x5f753b/0xa8adbc olang/009c9ea4/0x5f753b/0xc8adbc
msgid "Zoom In: <I=R2>"
msgstr "放大：<I=R2>"

