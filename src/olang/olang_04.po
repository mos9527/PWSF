#: olang/009c9ea4/0xe34675/0x000019
msgid "What?!"
msgstr "什么？！"

#: olang/009c9ea4/0xe34675/0x00001a
msgid "Damn you!"
msgstr "可恶！"

#: olang/009c9ea4/0xe34675/0x00001b
msgid "There you are!"
msgstr "找到你！"

#: olang/009c9ea4/0xe34675/0x00001c
