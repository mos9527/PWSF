#: olang/009c9ea4/0xe34675/0x000013
msgid "Take this!!"
msgstr "接招！"

#: olang/009c9ea4/0xe34675/0x000014
msgid "I'll send you straight to hell!"
msgstr "我直接送你下地狱！"

#: olang/009c9ea4/0xe34675/0x000015
msgid "Fly, my Kidnappers!!"
msgstr "飞吧，绑匪！"

#: olang/009c9ea4/0xe34675/0x000016
msgid "Attack mode!"
msgstr "攻击模式！"

#: olang/009c9ea4/0xe34675/0x000017
