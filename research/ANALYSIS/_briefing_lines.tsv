2	en	909	0x38db70	232887	0					23	Snake...\n
2	en	909	0x38db70	232887	1					23	Yeah...\n
2	en	909	0x38db70	232887	2					23	It's good to hear your voice again.\n
2	en	909	0x38db70	232887	3					23	Kaz, how about something a little sharper\nnext time.\n
2	en	909	0x38db70	232887	4					23	You got it. How about a diamond-bladed\njigsaw?\n
2	en	909	0x38db70	232887	5					23	And, ah, when's the "next time" gonna be,\nanyway?\n
2	en	909	0x38db70	232887	6					23	Sorry! Hey, you OK?\n
2	en	909	0x38db70	232887	7					23	Yeah.... Lungs taste like charcoal.\n
