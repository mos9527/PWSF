2	it	971	0x3cb620	248674	25					47	Io... Hai ragione.\n
2	it	971	0x3cb620	248674	26					47	Benvenuta all'inferno.\n
2	it	971	0x3cb620	248674	27					47	Snake, posso chiederti un favore?\n
2	it	971	0x3cb620	248674	28					47	Spara.\n
