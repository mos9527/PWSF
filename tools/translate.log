{"file": "D:\\PWSF\\src\\slot\\slot_10.po", "msgid": "But wait, here is your consolation prize:", "reason": "unparsable: {\"1\": \"接受我们的提议，我们就允许你\\n继续掌控MSF和吉克。\", \"2\": \"这……也算提议？\", \"3\": \"THE BOSS扔下了她的枪，\\n也扔下了她一生的使命。\", \"4\": \"你——她的弟子——从来都\\n做不到这一点。你太害怕放手。\", \"5\": \"我生来就是为了战斗。我是一把枪。\", \"6\": \"是吗？！那你管这个叫什么？\\n它也是枪吗？\", \"7\": \"你撒谎的水平真差！承认"}
{"file": "D:\\PWSF\\src\\slot\\slot_10.po", "msgid": "We are about to show the world just \nhow dangerous a gang of outlaws", "reason": "unparsable: {\"1\": \"接受我们的提议，我们就允许你\\n继续掌控MSF和吉克。\", \"2\": \"这……也算提议？\", \"3\": \"THE BOSS扔下了她的枪，\\n也扔下了她一生的使命。\", \"4\": \"你——她的弟子——从来都\\n做不到这一点。你太害怕放手。\", \"5\": \"我生来就是为了战斗。我是一把枪。\", \"6\": \"是吗？！那你管这个叫什么？\\n它也是枪吗？\", \"7\": \"你撒谎的水平真差！承认"}
{"file": "D:\\PWSF\\src\\slot\\slot_10.po", "msgid": " - an army without borders - can be!", "reason": "unparsable: {\"1\": \"接受我们的提议，我们就允许你\\n继续掌控MSF和吉克。\", \"2\": \"这……也算提议？\", \"3\": \"THE BOSS扔下了她的枪，\\n也扔下了她一生的使命。\", \"4\": \"你——她的弟子——从来都\\n做不到这一点。你太害怕放手。\", \"5\": \"我生来就是为了战斗。我是一把枪。\", \"6\": \"是吗？！那你管这个叫什么？\\n它也是枪吗？\", \"7\": \"你撒谎的水平真差！承认"}
{"file": "D:\\PWSF\\src\\slot\\slot_10.po", "msgid": "You and your men will become pariahs,\nand you will be wiped off the face of the earth.", "reason": "unparsable: {\"1\": \"接受我们的提议，我们就允许你\\n继续掌控MSF和吉克。\", \"2\": \"这……也算提议？\", \"3\": \"THE BOSS扔下了她的枪，\\n也扔下了她一生的使命。\", \"4\": \"你——她的弟子——从来都\\n做不到这一点。你太害怕放手。\", \"5\": \"我生来就是为了战斗。我是一把枪。\", \"6\": \"是吗？！那你管这个叫什么？\\n它也是枪吗？\", \"7\": \"你撒谎的水平真差！承认"}
{"file": "D:\\PWSF\\src\\slot\\slot_10.po", "msgid": "Rather than heroes, you will be seen \nas a well-armed, extremist cult", "reason": "unparsable: {\"1\": \"接受我们的提议，我们就允许你\\n继续掌控MSF和吉克。\", \"2\": \"这……也算提议？\", \"3\": \"THE BOSS扔下了她的枪，\\n也扔下了她一生的使命。\", \"4\": \"你——她的弟子——从来都\\n做不到这一点。你太害怕放手。\", \"5\": \"我生来就是为了战斗。我是一把枪。\", \"6\": \"是吗？！那你管这个叫什么？\\n它也是枪吗？\", \"7\": \"你撒谎的水平真差！承认"}
{"file": "D:\\PWSF\\src\\slot\\slot_10.po", "msgid": "prone to indiscriminate outbursts \nof nuclear aggression.", "reason": "unparsable: {\"1\": \"接受我们的提议，我们就允许你\\n继续掌控MSF和吉克。\", \"2\": \"这……也算提议？\", \"3\": \"THE BOSS扔下了她的枪，\\n也扔下了她一生的使命。\", \"4\": \"你——她的弟子——从来都\\n做不到这一点。你太害怕放手。\", \"5\": \"我生来就是为了战斗。我是一把枪。\", \"6\": \"是吗？！那你管这个叫什么？\\n它也是枪吗？\", \"7\": \"你撒谎的水平真差！承认"}
{"file": "D:\\PWSF\\src\\slot\\slot_10.po", "msgid": "You will give rise to a new world order, ", "reason": "unparsable: {\"1\": \"接受我们的提议，我们就允许你\\n继续掌控MSF和吉克。\", \"2\": \"这……也算提议？\", \"3\": \"THE BOSS扔下了她的枪，\\n也扔下了她一生的使命。\", \"4\": \"你——她的弟子——从来都\\n做不到这一点。你太害怕放手。\", \"5\": \"我生来就是为了战斗。我是一把枪。\", \"6\": \"是吗？！那你管这个叫什么？\\n它也是枪吗？\", \"7\": \"你撒谎的水平真差！承认"}
