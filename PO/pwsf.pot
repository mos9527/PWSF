msgstr ""

#. fr: Réengager la cible.
#. de: Ziel wird erneut angegriffen.
#. it: Ingaggio nuovamente il bersaglio.
#. es: Volviendo a atacar objetivo.
#: olang/009c9ea4/0x903077/0x000006
msgid "Re-engaging target!"
msgstr ""

#. fr: Auto-réparation terminée. Réinitialisation en cours.
#. de: Reparatur abgeschlossen. Reinitialisierung.
#. it: Autoriparazione completata. Riattivazione.
#. es: Autorreparación completa. Reiniciando.
#: olang/009c9ea4/0x903077/0x000007
msgid "Auto-repair complete. Reinitializing."
msgstr ""

#. fr: Il est temps pour toi de mourir !
#. de: Es wird Zeit, zu STERBEN!
#. it: È arrivata la tua ora!
#. es: ¡Es hora de morir!
#: olang/009c9ea4/0x903077/0x000011
msgid "Time for you to DIE!"
msgstr ""

#. fr: Tu crois que je vais te laisser t'enfuir ?
#. de: Glaubst du, du kannst entkommen?!
#. it: Credi che ti lascerò andare?!
#. es: ¿Crees que te dejaré huir?
#. it: Credi che ti lascerò andare?
#: olang/009c9ea4/0x903077/0x000012
#: olang/009c9ea4/0xe9cbf5/0x000010
msgid "You think I'll let you get away?!"
msgstr ""

#. fr: Meurs !
#. de: Stirb!
#. it: Muori!
#. es: ¡Muere!
#: olang/009c9ea4/0x903077/0x000013
#: olang/009c9ea4/0xbc4a75/0x00002c
#: olang/009c9ea4/0xe9cbf5/0x000011
msgid "Die!"
msgstr ""

#. fr: Je t'écraserai comme un insecte !
#. de: Ich zerquetsche dich wie ein Insekt!
#. it: Ti schiaccerò come un insetto!
#. es: ¡Te aplastaré como a un insecto!
#: olang/009c9ea4/0x903077/0x000015
msgid "I'll crush you like an insect!"
msgstr ""

#. fr: Allez.
#. de: Dann mal los.
#. it: Forza.
#. es: Adelante.
#: olang/009c9ea4/0x903077/0x000016
#: olang/009c9ea4/0xbc4a75/0x000046
msgid "Bring it on!"
msgstr ""

#. fr: Ce n'est pas encore fini !
#. de: Es ist noch nicht vorbei!
#. it: Non è ancora finita!
#. es: ¡Esto aún no se ha acabado!
#. fr: Ce n'est pas encore terminé !
#: olang/009c9ea4/0x903077/0x000017
#: olang/009c9ea4/0xbc4a75/0x000026
#: olang/009c9ea4/0xe9cbf5/0x00000f
msgid "It's not over yet!"
msgstr ""

#. fr: ANNULER : <I=COOPS_CANCEL>
#. de: ABBRECHEN: <I=COOPS_CANCEL>
#. it: ANNULLA: <I=COOPS_CANCEL>
#. es: CANCELAR: <I=COOPS_CANCEL>
#: olang/009c9ea4/0x995528/0x945cab
msgid "CANCEL: <I=COOPS_CANCEL>"
msgstr ""

#. fr: Quitter sans enregistrer votre mot de passe ?
#. de: Fortfahren, ohne das Passwort zu ändern?
#. it: Tornare indietro? Le modifiche non verranno salvate.
#. es: ¿Quieres salir sin guardar tu contraseña?
#: olang/009c9ea4/0x9b86ab/0x0198da
msgid "不修改密码就离开吗？"
msgstr ""

#. fr: Une fois saisi, votre nom de joueur ne pourra pas être modifié.
#. de: Nach der Eingabe, kann dieser nicht mehr geändert werden.
#. it: Una volta inserito, non potrà essere cambiato.
#. es: Una vez introducido, no podrá cambiarse.
#: olang/009c9ea4/0x9b86ab/0x3020bc
msgid "玩家名一经确定便无法更改。"
msgstr ""

#. fr: Le nom est trop court.
#. Veuillez entrer un nom de plus de %d caractères.
#. de: Der eingegebene Name ist zu kurz.
#. Bitte geben Sie mehr als %d Zeichen ein.
#. it: Nome troppo corto.
#. Inserisci almeno %d caratteri.
#. es: Nombre demasiado corto. 
#. Introduce %d o más caracteres.
#: olang/009c9ea4/0x9b86ab/0x3f2c7b
#: olang/009c9ea4/0x9b86ab/0x5f42b2
#, c-format
msgid ""
"所选名称过短。\n"
"请输入长度超过 %d 个字符的名称。"
msgstr ""

#. fr: Retourner à l'écran-titre ?
#. de: Zum Titelmenü zurückkehren?
#. it: Tornare al menu dei titoli?
#. es: ¿Regresar al menú de título?
#: olang/009c9ea4/0x9b86ab/0x4c248f
msgid "返回标题画面吗？"
msgstr ""

#. fr: Entrez votre nom de joueur.
#. de: Geben Sie den Spielernamen ein.
#. it: Inserisci il nome giocatore.
#. es: Escribe tu nombre de jugador.
#: olang/009c9ea4/0x9b86ab/0x518104
msgid "请输入玩家名。"
msgstr ""

#. fr: Modifiez votre mot de passe.
#. de: Bitte ändern Sie Ihr Passwort.
#. it: Modifica la password.
#. es: Modifica tu contraseña.
#: olang/009c9ea4/0x9b86ab/0x51eea1
msgid "请修改密码。"
msgstr ""

#. fr: Ce nom contient des mots qui ne peuvent pas être utilisés dans ce jeu.
#. de: Der eingegebene Name enthält Begriffe, die in diesem
#. Spiel nicht verwendet werden können.
#. it: Il nome include caratteri non utilizzabili.
#. es: Has introducido caracteres no permitidos.
#: olang/009c9ea4/0x9b86ab/0x75bf6e
msgid "其中包含本游戏无法使用的字词。"
msgstr ""

