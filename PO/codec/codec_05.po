#. speaker 0x0e3bb338 voice v_bri_mis_amd0170_000_0
#. timeline 1727..1978
#: codec/1/206/0xce300/2
msgid ""
"No!\n"
msgstr ""

#. speaker 0x0e463a34 voice v_bri_mis_amd0170_000_0
#. timeline 2006..2772
#: codec/1/206/0xce300/3
msgid ""
"We just have to trust the Boss - and wait.\n"
msgstr ""

#. speaker 0x0e3bb338 voice v_bri_mis_amd0170_000_0
#. timeline 2800..3134
#: codec/1/206/0xce300/4
msgid ""
"For how long?\n"
msgstr ""

#. speaker 0x0e463a34 voice v_bri_mis_amd0170_000_0
#. timeline 3162..4151
#: codec/1/206/0xce300/5
msgid ""
"Amanda, you're cute when you're angry, but please,\n"
"calm down.\n"
msgstr ""

#. speaker 0x0e463a34 voice v_bri_mis_amd0170_000_0
#. timeline 4179..4806
#: codec/1/206/0xce300/6
msgid ""
"He's prepared for situations like this.\n"
msgstr ""

#. speaker 0x0e3bb338 voice v_bri_mis_amd0170_000_0
#. timeline 4820..5712
#: codec/1/206/0xce300/7
msgid ""
"With what? They'll find whatever he has on him.\n"
