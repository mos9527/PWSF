#. speaker 0x0e3bb338 voice v_bri_mis_amd0120_000_0
#. timeline 9069..9599
#: codec/1/205/0xcd210/8
msgid ""
"You might get away if you're lucky.\n"
msgstr ""

#. speaker 0x0e28dce6 voice v_bri_mis_amd0120_000_0
#. timeline 9613..10240
#: codec/1/205/0xcd210/9
msgid ""
"I'd rather not have to take that chance.\n"
msgstr ""

#. speaker 0x0e3bb338 voice v_bri_mis_amd0120_000_0
#. timeline 10267..10992
#: codec/1/205/0xcd210/10
msgid ""
"Indeed, that would be best.\n"
msgstr ""

#. speaker 0x0e3bb338 voice v_bri_mis_amd0140_000_0
#. timeline 445..919
#: codec/1/205/0xcd600/0
msgid ""
"I remember those barracks.\n"
msgstr ""

#. speaker 0x0e3bb338 voice v_bri_mis_amd0140_000_0
#. timeline 947..2061
#: codec/1/205/0xcd600/1
msgid ""
"They're full of criss-crossing pathways so visibility\n"
