#. de: Menschliche Stimme
#. it: Voce umana
#. es: Voz humana
#: olang/0005ee2f/0xc6de03/0x02d356
#: olang/0005ee2f/0xc6de03/0x17b115
#: olang/0005ee2f/0xc6de03/0x262ccd
#: olang/0005ee2f/0xc6de03/0xae4364
msgid "Human voice"
msgstr ""

#. fr: Affichage
#. de: Bildschirmanzeige
#. it: Visuale schermo
#. es: Ajustes de pantalla
#: olang/0005ee2f/0xc6de03/0x069574
msgid "Screen Display"
msgstr ""

#. fr: Déplacer l'affichage à l'aide du stick analogique gauche.
#. Modifier le niveau du zoom à l'aide de LT et RT.
#. Appuie sur <I=DEC> pour appliquer les changements 
#. et sur <I=△> pour restaurer les paramètres d'affichage par défaut.
#. de: Ändern Sie die Bildschirmposition mit dem linken Stick.
#. Ändern Sie den Zoomfaktor mit LT oder RT.
#. Drücken Sie die <I=DEC>-Taste, um die Änderungen zu übernehmen.
#. Drücken Sie die <I=△>-Taste, um die Anzeige auf die Standardeinstellungen zurückzusetzen.
#. it: Sposta la posizione dello schermo usando la levetta sinistra.
#. Modifica il livello d'ingrandimento con  LT e RT.
#. Premi il pulsante <I=DEC> per applicare le modifiche.
#. Per ripristinare le impostazioni dello schermo predefinite, premi il pulsante <I=△>.
#. es: Mueve la posición de la pantalla usando el stick izquierdo.
#. Cambia el nivel del zoom con LT y RT.
#. Pulsa <I=DEC> para aplicar tus cambios.
#. Para restaurar los ajustes por defecto, pulsa <I=△>.
#: olang/0005ee2f/0xc6de03/0x094877
msgid ""
"Move the screen position using the left stick.\n"
"Change the zoom level with LT and RT.\n"
"Press <I=DEC> to apply your changes.\n"
"To restore the default display settings, press <I=△>."
msgstr ""

#. de: Magazine
#. it: Riviste
#. es: Revistas
#: olang/0005ee2f/0xc6de03/0x1889b7
#: olang/0005ee2f/0xc6de03/0x3726d7
msgid "Magazines"
msgstr ""

