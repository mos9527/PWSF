#: olang/009c9ea4/0x5f753b/0xc8adbd
msgid "Zoom Out: <I=L2>"
msgstr ""

#. fr: Pivoter : gauche/droite du stick analogique droit
#. de: Drehen: Rechter Stick nach links/rechts
#. it: Ruota: levetta destra a sinistra/destra
#. es: Rotar: stick derecho izquierda/derecha
#: olang/005184e3/0x5f753b/0x28adbe
msgid "Rotate: Right stick left/right"
msgstr ""

#. fr: Déplacer : stick analogique droit haut/bas
#. de: Bewegen: Rechter Stick nach oben/unten
#. it: Sposta: levetta destra su/giù
#. es: Mover: stick derecho arriba/abajo
#: olang/005184e3/0x5f753b/0x28adbf
msgid "Move: Right stick left up/down"
msgstr ""

#. fr: Pivoter : Stick analogique droit
#. de: Drehen: Rechter Stick
#. it: Ruota: levetta destra
#. es: Rotar: stick derecho
#. fr: Pivoter : stick analogique droit
#: olang/005184e3/0x5f753b/0x48adbe
#: olang/005184e3/0x5f753b/0xc992ce
msgid "Rotate: Right stick"
msgstr ""

#. fr: Déplacer caméra : stick analogique droit
#. de: Kamera bewegen: Rechter Stick
#. it: Sposta visuale: levetta destra
#. es: Mover cámara: stick derecho
#: olang/005184e3/0x5f753b/0x88adbf
#: olang/005184e3/0x5f753b/0xa8adbe
msgid "Move Camera: Right stick"
msgstr ""

#. fr: Zoomer : <I=L2>
#. de: Hereinzoomen: <I=L2>
#. it: Avvicina: <I=L2>
#. es: Ampliar: <I=L2>
#: olang/005184e3/0x5f753b/0xc992cc
#: olang/005184e3/0x919326/0xc992cc
#: olang/009c9ea4/0x5f753b/0xc992cc
#: olang/009c9ea4/0x919326/0xc992cc
msgid "Zoom In: <I=L2>"
msgstr ""

#. fr: Dézoomer : <I=R2>
#. de: Herauszoomen: <I=R2>
#. it: Allontana: <I=R2>
#. es: Reducir: <I=R2>
#: olang/005184e3/0x5f753b/0xc992cd
#: olang/005184e3/0x919326/0xc992cd
#: olang/009c9ea4/0x5f753b/0xc992cd
#: olang/009c9ea4/0x919326/0xc992cd
msgid "Zoom Out: <I=R2>"
msgstr ""

#. fr: Déplacer : stick analogique droit
#. de: Bewegen: Rechter Stick
#. it: Sposta: ｌevetta destra
#. es: Mover: stick derecho
#: olang/005184e3/0x5f753b/0xc992cf
msgid "Move: Right stick"
msgstr ""

#. fr: Pour déplacer ta ligne de vue, utilise le stick analogique droit.
#. de: Benutzen Sie zum Ausrichten
#. des Blickfelds den rechten Stick.
#. it: Per muovere la tua linea visiva,
#. usa la levetta destra.
#. es: Para cambiar la línea de visión,
#. se utilizará el stick derecho.
#: olang/005184e3/0x62997d/0x000000
msgid ""
"To move your line of sight, \n"
"use the right stick."
msgstr ""

#. fr: Pour déplacer ta ligne de vue, incline le stick analogique droit vers le haut et le bas !
#. de: Bewegen Sie den rechten Stick nach oben oder unten,
#. um Ihr Blickfeld auszurichten!
#. it: Inclina la levetta destra su e giù
#. per muovere la tua linea visiva!
#. es: Incline el stick derecho hacia arriba y hacia abajo
#. para mover la línea de visión.
#: olang/005184e3/0x629bfd/0x000001
msgid ""
"Use up and down on the Right Stick \n"
"to move your line of sight!"
msgstr ""

#. fr: Pour déplacer la ligne de vue, incline le joystick droit vers la gauche et la droite !
#. de: Bewegen Sie den rechten Stick nach rechts oder links,
#. um Ihr Blickfeld auszurichten!
#. it: Inclina la levetta destra a sinistra e destra
#. per muovere la tua linea visiva.
#. es: Incline el stick derecho a derecha e izquierda
#. para mover la línea de visión.
#: olang/005184e3/0x629c7d/0x000001
msgid ""
"Use right and left on the Right Stick \n"
"to move your line of sight!"
msgstr ""

#. fr: À présent, déplacer ta ligne de vue vers le haut et vers le bas ne devrait plus avoir de secrets pour toi.
#. de: Mit dem Ausrichten des Blickfelds nach oben und unten
#. dürften Sie jetzt vertraut sein.
#. it: Ora dovresti avere più confidenza
#. nel muovere la visuale su e giù.
#. es: Ahora deberíais estar familiarizados con el movimiento de la línea de visión arriba y abajo.
#. fr: À présent, déplacer ta ligne de vue à haut et bas ne devrait plus avoir de secrets pour toi.
#. it: Ora dovresti avere più confidenza
#. nel muovere la visuale a su e giù.
#. es: Ahora deberías tener más confianza
#. en mover la vista a arriba y hacia.
#: olang/005184e3/0x62a8fd/0x000000
#: olang/009c9ea4/0x62a8fd/0x000000
msgid ""
"You should be familiar with\n"
"the up and down controls now."
msgstr ""

#. fr: À présent, déplacer ta ligne de vue à gauche et droite ne devrait plus avoir de secrets pour toi.
#. de: Mit dem Ausrichten des Blickfelds nach links und rechts
#. dürften Sie jetzt vertraut sein.
#. it: Ora dovresti avere più confidenza
#. nel muovere la visuale a sinistra e destra.
#. es: Ahora deberíais estar familiarizados con
#. el movimiento de la línea de visión.
#. es: Ahora deberías tener más confianza
#. en mover la vista a izquierda y derecha.
#: olang/005184e3/0x62a97d/0x000000
#: olang/009c9ea4/0x62a97d/0x000000
msgid ""
"You should be familiar with\n"
"the left and right controls now."
msgstr ""

#. fr: Très bien, nous allons regarder une dernière fois à gauche et à droite avec le stick analogique droit.
#. de: Gut, wir schauen mit dem rechten Stick
#. noch mal nach oben und unten. 
#. it: Bene, andiamo ancora una volta su e giù
#. con la levetta destra.
#. es: Bien, miremos arriba y abajo con
#. el stick derecho una vez más.
#: olang/005184e3/0x62b8fd/0x000000
msgid ""
"Alright, let’s try up and down on\n"
" the Right Stick one more time."
msgstr ""

#. fr: Très bien, nous allons regarder une dernière fois à gauche et à droite avec le stick analogique droit.
#. de: Gut, wir schauen mit dem rechten Stick
#. noch mal nach links und rechts. 
#. it: Bene, andiamo ancora una volta a sinistra e destra
#. con la levetta destra.
#. es: Bien, miremos a izquierda y derecha con
#. el stick derecho una vez más.
#: olang/005184e3/0x62b97d/0x000000
msgid ""
"Alright, let’s try left and right on\n"
"the Right Stick one more time."
msgstr ""

#. fr: Utilise le stick analogique gauche pour te déplacer.
#. de: Mit dem linken Stick können Sie sich bewegen.
#. it: Utilizza la levetta sinistra per spostarti.
#. es: Para moverse, se usa el stick izquierdo.
#: olang/005184e3/0x62c97d/0x000001
msgid "Use the left stick to move around.\r"
msgstr ""

#. fr: Bon, et maintenant ? Utilise le stick analogique gauche pour te déplacer !
#. de: Was ist?
#. Bewegen Sie sich mit dem linken Stick! 
#. it: Cosa c'è?
#. Usa la levetta sinistra per spostarti!
#. es: ¿Y ahora qué?
#. Use el stick izquierdo para moverse.
#: olang/005184e3/0x62cafd/0x000000
msgid ""
"What now? \n"
"Use the left stick to move! "
msgstr ""

#. fr: Boss, utilise le stick analogique gauche pour te déplacer !
#. de: Boss, mit dem linken Stick
#. können Sie sich bewegen!
#. it: Boss, puoi usare
#. la levetta sinistra per spostarti!
#. es: Boss, use
#. el stick izquierdo para moverse.
#: olang/005184e3/0x62cb7d/0x000000
msgid ""
"Boss, you can use \n"
"the left stick to move!"
msgstr ""

#. fr: Boss, fais une roulade en appuyant sur la touche Attaquer tout en courant avec le stick analogique gauche !
#. de: Boss, führen Sie eine Rolle durch Antippen der Angriffstaste aus,
#. während Sie mit dem linken Stick laufen!
#. it: Boss, rotola premendo rapidamente il pulsante Attacco
#. mentre corri con la levetta sinistra!
#. es: Boss, pulse el botón de ataque
#. mientras corre con el stick izquierdo para rodar.
#: olang/005184e3/0x62d8fd/0x000000
msgid ""
"Boss, roll by tapping the Attack Button\n"
"while running with the left stick!"
msgstr ""

#. fr: Boss, fais une roulade en appuyant sur la touche S'accroupir tout en courant avec le stick analogique gauche !
#. de: Boss, führen Sie eine Rolle durch Antippen der Hocketaste aus,
#. während Sie mit dem linken Stick laufen!
#. it: Boss, rotola premendo il pulsante Postura
#. mentre corri con la levetta sinistra!
#. es: Boss, pulse el botón de agacharse
#. mientras corre con el stick izquierdo para rodar.
#: olang/005184e3/0x62d8fe/0x000000
msgid ""
"Boss, roll by pressing the Crouch Button\n"
"while running with the left stick!"
msgstr ""

#. fr: Boss, appuie sur la touche Attaquer au corps à corps, sans bouger !
#. de: Drücken Sie die Hand-Angriffstaste  ,
#. ohne sich zu bewegen, Boss.
#. it: Premi il pulsante Attacco corpo a corpo 
#. senza muoverti, Boss.
#. es: ¡Pulse el botón de ataque sin armas 
#. sin moverse, Boss!
#: olang/005184e3/0x62db7e/0x000000
msgid ""
"Press the Hand-to-hand Attack Button\n"
"without moving, Boss. "
msgstr ""

#. fr: Pour utiliser la matraque étourdissante, appuie sur la touche Viser et une fois prêt,
#. de: Drücken Sie zur Verwendung des Betäubungsstabs
#. die Zieltaste 
#. it: Per usare lo storditore elettrico,
#.  premi il pulsante Puntamento per prepararlo,
#. es: Para usar la vara eléctrica,
#. pulse el botón de apuntar para prepararla
#. 
#. ,
#: olang/005184e3/0x62dc7e/0x000000
msgid ""
"To use the stun rod, \n"
"press the Aim Button to ready it,\r"
msgstr ""

#. fr: appuie sur la touche Attaquer.
#. de: und drücken Sie danach die Waffen-Angriffstaste.
#. it: quindi premi il pulsante Attacco.
#. es: y luego pulse el botón de ataque con armas.
#: olang/005184e3/0x62dc7e/0x000001
msgid "then press the Weapon-Attack Button.\r"
msgstr ""

#. fr: Hé ! Appuie sur la touche Viser !
#. de: He! Drücken Sie die Zieltaste !
#. it: Ehi! Premi il pulsante Puntamento!
#. es: ¡Eh! ¡Pulse el botón de apuntar!
#: olang/005184e3/0x64487e/0x000000
msgid "Hey! Press the Aim Button !"
msgstr ""

#. fr: Boss, appuie sur la touche Viser !
#. de: Boss, bitte drücken Sie die Zieltaste !
#. it: Boss, premi il pulsante Puntamento!
#. es: Boss, pulse el botón de apuntar.
#: olang/005184e3/0x6448fe/0x000000
msgid "Boss, please press the Aim Button !"
msgstr ""

#. fr: Quel est le problème ? Appuie sur la touche Attaquer après avoir appuyé sur la touche Viser!
#. de: Was ist los? Drücken Sie die Waffen-Angriffstaste ,
#. nachdem Sie die Zieltaste  gedrückt haben. 
#. it: Qual è il problema? Premi il pulsante Attacco 
#. dopo aver premuto il pulsante Puntamento!
#. es: ¿Qué pasa? Pulse el botón de ataque con armas 
#. después de pulsar el botón de apuntar.
#: olang/005184e3/0x644a7e/0x000000
msgid ""
"What's wrong? Press the Weapon-Attack Button\n"
"after pressing the Aim Button ! "
msgstr ""

#. fr: Boss, appuie sur la touche Attaquer après avoir appuyé sur la touche Viser !
#. de: Boss, bitte drücken Sie die Waffen-Angriffstaste,
#. nachdem Sie die Zieltaste gedrückt haben! 
#. it: Boss, premi il pulsante Attacco 
#. dopo aver premuto il pulsante Puntamento!
#. es: Boss, pulse el botón de ataque con armas 
#. después de pulsar el botón de apuntar.
#: olang/005184e3/0x644afe/0x000000
msgid ""
"Boss, please press the Weapon-Attack Button \n"
"after pressing the Aim Button !"
msgstr ""

#. fr: Appuie sur la touche Attaquer corps à corps près d'un ennemi en inclinant le stick analogique gauche !
#. de: Drücken Sie in der Nähe eines Gegners die Hand-Angriffstaste,
#. während Sie den linken Stick bewegen! 
#. it: Premi il pulsante Attacco corpo a corpo 
#. vicino a un nemico mentre inclini la levetta sinistra!
#. es: Pulse el botón de ataque sin armas 
#. cerca de un rival mientras inclina el stick izquierdo.
#: olang/005184e3/0x644bfe/0x000001
msgid ""
"and press the Hand-to-hand Attack Button \n"
"near an enemy as you tilt the left stick! "
msgstr ""

#. fr: Tout va bien ? Appuie sur RT !
#. de: Alles okay? Drücken Sie RT!
#. it: Tutto OK? Premi RT!
#. es: ¿Está bien? ¡Pulse RT!
#: olang/005184e3/0x647bfe/0x000000
msgid "You OK? Press RT!"
msgstr ""

#. fr: Boss, il faut appuyer sur RT !
#. de: Boss, Sie müssen RT drücken!
#. it: Boss, devi premere RT!
#. es: ¡Hay que pulsar RT, Boss!
#: olang/005184e3/0x647c7e/0x000000
msgid "Boss, you have to press RT!"
msgstr ""

#. fr: Incline ensuite le stick analogique gauche pour les projeter.
#. de: Bewegen Sie danach den linken Stick,
#. um ihn zu werfen.
#. it: Quindi inclina la levetta sinistra 
#. per lanciarlo.
#. es:  A continuación, incline
#. el stick izquierdo para lanzarlo.
#: olang/005184e3/0x649a7d/0x000001
#: olang/005184e3/0x649a7e/0x000001
msgid ""
"Then tilt the left stick \n"
"to throw them.\r"
msgstr ""

#. fr: En inclinant le stick analogique gauche vers d’autres ennemis,
#. de: Indem Sie den linken Stick in Richtung
#. anderer Feinde bewegen,
#. it: 
#. Inclinando la levetta sinistra verso 
#. altri nemici, 
#. es: Si se inclina el stick izquierdo
#. hacia otros enemigos,
#: olang/005184e3/0x649a7d/0x000002
msgid ""
"By tilting the left stick toward \n"
"other enemies, \r"
msgstr ""

#. fr: Appuie sur la touche Attaquer au corps à corps  près d'un ennemi pour le maîtriser !
#. de: Drücken Sie in der Nähe eines Gegners die Hand-Angriffstaste ,
#. um ihn in den Würgegriff zu nehmen!
#. it: Premi il pulsante Attacco corpo a corpo  
#. vicino a un nemico per bloccarlo!
#. es: Pulse el botón de ataque sin armas 
#. cerca de un rival para reducirlo.
#: olang/005184e3/0x649a7e/0x000000
msgid ""
"Press the Hand-to-hand Attack Button \n"
"near an enemy to restrain them!"
msgstr ""

#. fr: En inclinant le stick analogique gauche vers d’autres ennemis,
#. de: Indem Sie den linken Stick in Richtung
#. anderer Feinde bewegen,
#. it: Inclinando la levetta sinistra verso 
#. altri nemici, 
#. es: Si se inclina el stick izquierdo
#. hacia otros enemigos,
#: olang/005184e3/0x649a7e/0x000002
msgid ""
"By tilting the left stick toward \n"
"other enemies,  "
msgstr ""

#. fr: Boss, incline le stick analogique gauche pendant que tu maîtrises l’adversaire.
#. de: Bewegen Sie den linken Stick, während Sie
#. den Gegner im Würgegriff haben, Boss!
#. it: Inclina la levetta sinistra mentre blocchi 
#. l'avversario, Boss!
#. es: ¡Incline el stick izquierdo mientras reduce
#. a su oponente, Boss!
#: olang/005184e3/0x64a7fd/0x000000
msgid ""
"Tilt the left stick while restraining \n"
"the opponent, Boss!"
msgstr ""

#. fr: Appuie sur la touche Attaquer au corps à corps quand l’icône apparaît !
#. de: Drücken Sie die Hand-Angriffstaste 
#. , wenn das Symbol angezeigt wird!
#. it: Premi il pulsante Attacco corpo a corpo  
#. quando appare l'icona!
#. es: Pulse el botón de ataque sin armas 
#. cuando aparezca el icono.
#: olang/005184e3/0x64aafe/0x000000
msgid ""
"Press the Hand-to-hand Attack Button \n"
"when the Icon appears! "
msgstr ""

#. fr: Choisir un joueur pour l'échange.
#. de: Wählen Sie einen Spieler zum Tauschen aus.
#. it: Scegli un giocatore con cui scambiare.
#. es: Selecciona un jugador para realizar el intercambio.
#: olang/005184e3/0x6c8948/0xd71eb4
msgid "Select a player to trade with."
msgstr ""

#. fr: Les restrictions d'informations sont maintenant en place. 
#. Merci de patienter. 
#. Cette section contient des informations relatives à la progression de tes OPS PRINCIPALES, 
#. et ne seront pas visibles sur ton système.
#. de: Informationsbeschränkungen wurden aktiviert.
#. Bitte warten.
#. Dieser Abschnitt enthält Informationen, die über Ihren HAUPT-OPS-Spielfortschritt hinausgehen
#. und auf Ihrem System nicht angezeigt werden.
#. it: Restrizione delle informazioni in atto. 
#.  Attendere. 
#.  Questa sezione contiene informazioni relative a missioni oltre i tuoi progressi nelle MISSIONI PRINCIPALI 
#.  e non sarà visualizzata sul tuo sistema.
#. es: Restricciones de información activadas. 
#.  Espera. 
#.  Esta sección contiene información a la que todavía no has llegado en tus OPERACIONES PRINCIPALES, 
#.  y no se mostrará en tu sistema.
#: olang/005184e3/0x6ccb00/0xabe100
msgid ""
"Information restrictions now in place. \n"
" Please wait. \n"
" This section contains information from beyond your MAIN OPS progress, \n"
" and will not be shown on your system."
msgstr ""

#. fr: Parle !
#. de: Rede!
#. it: Parla!
#. es: ¡Habla!
#: olang/005184e3/0x8082bf/0x000000
#: olang/005184e3/0x8486c0/0x000000
#: olang/005184e3/0x888abf/0x000000
#: olang/005184e3/0x8c8ebf/0x000000
#: olang/005184e3/0xf466bf/0x000000
#: olang/005184e3/0xf86abf/0x000000
#: olang/005184e3/0xfc6ebf/0x000000
msgid "Talk!"
msgstr ""

#. fr: À l'époque, dans ma vieille unité, le commandant, pendant la gymnastique matinale, avait coutume de dire : « Quand vous avez des ennuis, appuyez sur la touche START ! »
#. Je me demande comment il va aujourd'hui.
#. de: In meiner alten Einheit hat der Kommandeur uns bei den Morgenübungen immer gesagt: „Wenn Sie in Schwierigkeiten sind, drücken Sie die START-Taste!“ Was wohl aus ihm geworden ist?
#. it: Nella mia vecchia unità, durante l'allenamento mattutino il comandante era solito dirci: "Ogni volta che siete nei guai, premete il pulsante START!!"
#. Chissà come se la passa in questo periodo.
#. es: En mi antigua unidad, el comandante solía decir durante los ejercicios matinales: "Si tenéis problemas, pulsad el botón START".
#. Me pregunto cómo le irá.
#: olang/005184e3/0x840500/0x374a51
msgid ""
"Back in my old unit, the commander used to tell us at morning calisthenics: \"Whenever you're in trouble, hit the START button!!\"\n"
"Wonder how he's doing these days."
msgstr ""

#. fr: Touche START : quitter le didacticiel.
#. de: START-Taste: Tutorial beenden.
#. it: Pulsante START: fine tutorial.
#. es: Botón START: salir del tutorial.
#: olang/005184e3/0x840ff7/0x44e180
msgid "START button: End tutorial."
msgstr ""

#. fr: Vérification du périphérique de stockage...
#. Ne pas éteindre la console ni retirer le périphérique de stockage.
#. de: Speichergerät wird überprüft ...
#. Speichergerät nicht entfernen
#. und die Konsole nicht ausschalten.
#. it: Controllo della periferica di memorizzazione in corso...
#. Non rimuovere la periferica di memorizzazione
#. o spegnere la console.
#. es: Comprobando el dispositivo de almacenamiento...
#. No retires el dispositivo de almacenamiento
#. ni apagues la consola.
#: olang/005184e3/0x8b79b6/0x220a93
msgid ""
"Checking storage device...\n"
"Do not remove the storage device \n"
"or turn off the power."
msgstr ""

#. fr: Impossible de prendre la capture 
#. d'écran.
#. de: Erstellen eines Screenshots fehlgeschlagen.
#. it: Impossibile catturare l'immagine.
#. es: No se ha podido capturar la imagen.
#: olang/005184e3/0x8b79b6/0x2e2681
msgid "Failed to capture screenshot.\r"
msgstr ""

#. fr: Le jeu sauvegarde automatiquement les données. Ne pas éteindre la console en cours de sauvegarde.
#. de: Dieses Spiel speichert an gewissen Punkten automatisch. Schalten Sie die Konsole während des Speichervorgangs nicht aus.
#. it: In questo gioco, i dati vengono salvati automaticamente. Non spegnere la console durante il salvataggio.
#. es: Este juego guarda los datos automáticamente. No apagues la consola durante este proceso.
#: olang/005184e3/0x8b79b6/0x3b222d
msgid "This game saves data automatically. Do not turn off the console during this time."
msgstr ""

#. fr: Aucune donnée.
#. de: Keine Speicherdatei vorhanden.
#. it: Non esistono dati di salvataggio.
#. es: No hay datos guardados.
#: olang/005184e3/0x8b79b6/0x93a0b2
msgid "Save data does not exist.\r"
msgstr ""

#. fr: Impossible de prendre la capture d'écran.
#. de: Erstellen des Screenshots fehlgeschlagen.
#. it: Impossibile catturare l'immagine.
#. es: Fallo al capturar la pantalla.
#: olang/005184e3/0x8b79b6/0xa6ed53
#: olang/009c9ea4/0x8b79b6/0xa6ed53
msgid "Failed to capture screenshot."
msgstr ""

#. fr: Enregistrement en cours. N'éteignez pas votre console.
#. de: Inhalt wird gespeichert. Bitte schalten Sie Ihre Konsole nicht aus.
#. it: Salvataggio del contenuto. Non spegnere la console.
#. es: Guardando contenido. No apagues tu consola.
#: olang/005184e3/0x8b79b6/0xbba0fd
#: olang/0072f326/0xa49217/0x836b27
#: olang/0072f326/0xdbd1b3/0x4dfe7b
msgid "Saving content. Please don't turn off your console."
msgstr ""

#. fr: Espace mémoire libre insuffisant sur le 
#. périphérique de stockage. Ce jeu 
#. nécessite un minimum de XX MB d'espace 
#. mémoire libre pour sauvegarder 
#. des données.
#. de: Ungenügend freier Speicherplatz auf 
#. dem Speichergerät.
#. Das Spiel benötigt mindestens XX MB 
#. freien Speicherplatz, um Daten zu 
#. sichern. 
#. it: Spazio libero insufficiente sulla
#. 
#. periferica di memorizzazione. Questo gioco
#. 
#. richiede almeno XX MB di spazio libero
#. per salvare i dati di gioco.
#. es: Insuficiente espacio libre en el 
#. dispositivo de almacenamiento.
#. Este juego requiere al menos
#. XXMB de espacio libre para 
#. guardar los datos.
#: olang/005184e3/0x8b79b6/0xffa130
msgid ""
"Insufficient free space on\r\n"
"the storage device. This game requires \r\n"
"at least XXMB of free space in order \n"
"to save data."
msgstr ""

#. fr: Pivoter : stick analogique gauche
#. de: Drehen: Linker Stick
#. it: Ruota: levetta sinistra
#. es: Rotar: stick izquierdo
#: olang/005184e3/0x919326/0xc992ce
msgid "Rotate: Left stick"
msgstr ""

