#. fr: Tir de missiles fouisseurs.
#. de: Feuere Bohrerraketen ab.
#. it: Lancio missili perforanti.
#. es: Lanzando misiles taladradores.
#: olang/009c9ea4/0xbc4a75/0x000007
msgid "Firing drill missiles."
msgstr ""

#. fr: Impulsion EM au maximum.
#. de: EM-Puls-Maximum erreicht.
#. it: Impulso EM al massimo.
#. es: Pulso EM al máximo.
#: olang/009c9ea4/0xbc4a75/0x000009
