msgstr ""

#. fr: Lance-flammes engagé.
#. de: Flammenwerfer aktiv.
#. it: Lanciafiamme attivato.
#. es: Lanzallamas iniciado.
#: olang/009c9ea4/0xbc4a75/0x000004
