msgstr ""

#. fr: Lancement de mines S.
#. de: Lege S-Minen.
#. it: Lancio mina S.
#. es: Lanzando minas S.
#: olang/009c9ea4/0xbc4a75/0x000005
msgid "Launching S mines."
msgstr ""

#. fr: Tir de lance-roquette.
#. de: Feuere Raketenwerfer ab.
#. it: Attivazione lanciarazzi.
#. es: Lanzando misil.
#: olang/009c9ea4/0xbc4a75/0x000006
