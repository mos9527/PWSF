#. de: Löschen...
#. it: Eliminazione in corso...
#. es: Eliminando...
#: olang/009c9ea4/0x596f30/0x99a4eb
msgid "Deleting..."
msgstr ""

#. fr: Sélectionnez les données à charger.
#. de: Wählen Sie die zu ladenden Spieldaten aus.
#. it: Seleziona i dati da caricare.
#. es: Elije los datos de juego a cargar.
#: olang/009c9ea4/0x596f30/0x9e630a
msgid "Please select the data you wish to load."
msgstr ""

#. fr: Sélectionnez les données à sauvegarder.
#. de: Wählen Sie die zu speichernden Spieldaten aus.
#. it: Seleziona i dati da salvare.
#. es: Elije los datos de juego a guardar.
#: olang/009c9ea4/0x596f30/0xa1adab
msgid "Please select the data you wish to save."
msgstr ""

#. fr: Chargement terminé.
#. de: Laden abgeschlossen.
#. it: Caricamento completato.
#. es: Datos cargados.
#: olang/009c9ea4/0x596f30/0xa67665
msgid "Load complete."
msgstr ""

#. fr: Échec de la sauvegarde des données de jeu.
#. de: Spieldaten konnten nicht gespeichert werden.
#. it: Impossibile salvare i dati di gioco.
#. es: Error al guardar los datos del juego.
#: olang/009c9ea4/0x596f30/0xadfa88
msgid "Failed to save game data."
msgstr ""

#. fr: Sauvegarder les données de jeu ?
#. de: Spieldaten speichern?
#. it: Salvare i dati di gioco?
#. es: ¿Guardar los datos del juego?
#: olang/009c9ea4/0x596f30/0xb2d99d
msgid "Save game data?"
msgstr ""

#. fr: Sauvegarde terminée.
#. de: Speichern abgeschlossen.
#. it: Salvataggio completato.
#. es: Datos guardados.
#: olang/009c9ea4/0x596f30/0xb3a0e9
msgid "Save complete."
msgstr ""

#. fr: Voulez-vous vraiment supprimer vos données sauvegardées ?
#. de: Möchten Sie Ihre gespeicherten Daten wirklich löschen?
#. it: Eliminare i dati salvati?
#. es: ¿Seguro que quieres eliminar los datos guardados?
#: olang/009c9ea4/0x596f30/0xb540bd
msgid "Are you sure you want to delete your saved data?"
msgstr ""

#. fr: Pas de données de sauvegarde.
#. de: Keine gespeicherten Daten.
#. it: Nessun dato di salvataggio.
#. es: No hay datos guardados.
#: olang/009c9ea4/0x596f30/0xb607f8
msgid "No saved data."
msgstr ""

#. fr: <I=DEC> Confirmer
#. de: <I=DEC> Bestätigen
#. it: <I=DEC> Conferma
#. es: <I=DEC> Confirmar
#: olang/009c9ea4/0x596f30/0xbcdff8
msgid "<I=DEC> Confirm"
msgstr ""

#. fr: Données sauvegardées supprimées.
#. de: Speicherdaten gelöscht.
#. it: Dati salvati eliminati.
#. es: Datos guardados eliminados.
#: olang/009c9ea4/0x596f30/0xe5e21a
msgid "Saved data deleted."
msgstr ""

#. fr: Temps total de jeu : [total_play_time]
#. de: Tempo di gioco totale : [total_play_time]
#. it: Totale Spielzeit : [total_play_time]
#. es: Tiempo total de juego : [total_play_time]
#: olang/009c9ea4/0x596f30/0xf100ae
msgid "Total Play Time : [total_play_time]"
msgstr ""

#. fr: Appuyer sur <I=□> pour sélectionner le soldat à assigner.
#. de: Wählen Sie mit der <I=□> den Soldaten, der zugeteilt werden soll.
#. it: Premi <I=□> per scegliere quale soldato assegnare.
#. es: Pulsa <I=□> para seleccionar al soldado que quieras asignar.
#: olang/009c9ea4/0x5d8989/0xb3e6dc
msgid "Press <I=□> to select which soldier to assign."
msgstr ""

#. fr: Appuyez sur <I=CONF> pour sélectionner l'équipe à laquelle
#. assigner le soldat.
#. de: Wählen Sie <I=CONF> aus um das Team zu bestimmen,
#. dem der Soldat zugewiesen werden soll.
#. it: Premi <I=CONF> per scegliere a quale squadra
#. assegnare il soldato.
#. es: Pulsa <I=CONF> para especificar el equipo
#. al cual asignar al soldado.
#: olang/009c9ea4/0x5d8989/0xb3e6fc
msgid ""
"Press <I=CONF> to specify the team to which\n"
"to assign the soldier."
msgstr ""

#. fr: Pivoter : <I=CAMERA> gauche/droite
#. de: Drehen: <I=CAMERA> nach links/rechts
#. it: Ruota: <I=CAMERA> a sinistra/destra
#. es: Rotar: <I=CAMERA> izquierda/derecha
#: olang/009c9ea4/0x5f753b/0x28adbe
msgid "Rotate: <I=CAMERA> left/right"
msgstr ""

#. fr: Déplacer : <I=CAMERA> haut/bas
#. de: Bewegen: <I=CAMERA> nach oben/unten
#. it: Sposta: <I=CAMERA> su/giù
#. es: Mover: <I=CAMERA> arriba/abajo
#: olang/009c9ea4/0x5f753b/0x28adbf
msgid "Move: <I=CAMERA> up/down"
msgstr ""

#. fr: Pivoter : <I=CAMERA>
#. de: Drehen: <I=CAMERA>
#. it: Ruota: <I=CAMERA>
#. es: Rotar: <I=CAMERA>
#: olang/009c9ea4/0x5f753b/0x48adbe
#: olang/009c9ea4/0x5f753b/0xc992ce
#: olang/009c9ea4/0x919326/0xc992ce
msgid "Rotate: <I=CAMERA>"
msgstr ""

#. fr: Déplacer caméra : <I=CAMERA>
#. de: Kamera bewegen: <I=CAMERA>
#. it: Sposta visuale: <I=CAMERA>
#. es: Mover cámara: <I=CAMERA>
#: olang/009c9ea4/0x5f753b/0x88adbf
#: olang/009c9ea4/0x5f753b/0xa8adbe
msgid "Move Camera: <I=CAMERA>"
msgstr ""

#. fr: Déplacer : <I=CAMERA>
#. de: Bewegen: <I=CAMERA>
#. it: Sposta: <I=CAMERA>
#. es: Mover: <I=CAMERA>
#: olang/009c9ea4/0x5f753b/0xc992cf
msgid "Move: <I=CAMERA>"
msgstr ""

#. fr: Pour déplacer ta ligne de vue,
#. incline <I=CAMERA> vers le haut et le bas !
#. de: Bewegen Sie <I=CAMERA> nach oben oder unten,
#. um Ihr Blickfeld auszurichten!
#. it: Inclina <I=CAMERA> su e giù
#. per muovere la tua linea visiva!
#. es: Incline <I=CAMERA> hacia arriba y hacia abajo
#. para mover la línea de visión.
#: olang/009c9ea4/0x629bfd/0x000001
msgid ""
"Use up and down on <I=CAMERA> \n"
"to move your line of sight!"
msgstr ""

#. fr: Pour déplacer la ligne de vue,
#. incline <I=CAMERA> vers la gauche et la droite !
#. de: Bewegen Sie <I=CAMERA> nach rechts oder links,
#. um Ihr Blickfeld auszurichten!
#. it: Inclina <I=CAMERA> a sinistra e destra
#. per muovere la tua linea visiva!
#. es: Incline <I=CAMERA> a derecha e izquierda
#. para mover la línea de visión.
#: olang/009c9ea4/0x629c7d/0x000001
msgid ""
"Use right and left on <I=CAMERA> \n"
"to move your line of sight!"
msgstr ""

#. fr: Boss,
#. utilise <I=CAMERA> vers le haut et le bas
#. pour déplacer ta ligne de vue.
#. de: Boss,
#. bewegen Sie <I=CAMERA> nach oben oder unten,
#. um Ihr Blickfeld auszurichten.
#. it: Boss,
#. inclina <I=CAMERA> su e giù
#. per muovere la tua linea visiva.
#. es: Boss,
#. incline <I=CAMERA> hacia arriba y hacia abajo 
#. para mover la línea de visión.
#: olang/009c9ea4/0x62a7fd/0x000000
msgid ""
"Boss, \n"
"use up and down on <I=CAMERA> \n"
"to move your line of sight."
msgstr ""

#. fr: utilise haut et bas de <I=CAMERA> pour déplacer la ligne de vue.
#. de: drücken Sie die Oben- und Unten-<I=CAMERA>, 
#. um Ihr Blickfeld auszurichten!
#. it: usa <I=CAMERA> su e giù per muovere la tua linea visiva.
#. es: utilice <I=CAMERA> arriba y hacia abajo 
#. para mover la línea de visión.
#: olang/009c9ea4/0x62a7fd/0x000001
msgid ""
"use the up and down <I=CAMERA> \n"
"to move your line of sight.  "
msgstr ""

#. fr: Boss,
#. utilise <I=CAMERA> vers la gauche et la droite
#. pour déplacer ta ligne de vue.
#. de: Boss,
#. bewegen Sie <I=CAMERA> nach links oder rechts,
#. um Ihr Blickfeld auszurichten!
#. it: Boss,
#. inclina <I=CAMERA> a sinistra e destra
#. per muovere la tua linea visiva!
#. es: Boss,
#. incline <I=CAMERA> a derecha e izquierda
#. para mover la línea de visión.
#: olang/009c9ea4/0x62a87d/0x000000
msgid ""
"Boss, \n"
"use left and right on <I=CAMERA> \n"
"to move your line of sight!"
msgstr ""

#. fr: utilise gauche et droite de <I=CAMERA> pour déplacer la ligne de vue.
#. de: drücken Sie die Links- und Rechts-<I=CAMERA>, um Ihr Blickfeld auszurichten!
#. it: usa <I=CAMERA> sinistra e destra per muovere la tua linea visiva.
#. es: utilice <I=CAMERA> la derecha e izquierda 
#. para mover la línea de visión.
#: olang/009c9ea4/0x62a87d/0x000001
msgid ""
"use the left and right <I=CAMERA> \n"
"to move your line of sight.  "
msgstr ""

#. fr: Appuie sur <I=ACT> si tu es prêt à continuer.
#. de: Drücken Sie <I=ACT>, wenn Sie weitermachen wollen.
#. it: Premi <I=ACT> se sei pronto per proseguire.
#. es: Pulsad <I=ACT> si estáis listos para continuar.
#: olang/009c9ea4/0x62a8fd/0x000001
#: olang/009c9ea4/0x62a97d/0x000001
msgid "Press <I=ACT> if you're ready to move on."
msgstr ""

#. fr: Très bien, nous allons regarder une dernière fois
#. en haut et en bas avec <I=CAMERA>.
#. de: Gut, wir schauen mit <I=CAMERA>
#. noch mal nach oben und unten.
#. it: Bene, andiamo ancora una volta su e giù
#. con <I=CAMERA>.
#. es: Bien, miremos arriba y abajo con
#. <I=CAMERA> una vez más.
#: olang/009c9ea4/0x62b8fd/0x000000
msgid ""
"Alright, let’s try up and down on\n"
" <I=CAMERA> one more time."
msgstr ""

#. fr: Très bien, nous allons regarder une dernière fois
#. à gauche et à droite avec <I=CAMERA>.
#. de: Gut, wir schauen mit <I=CAMERA>
#. noch mal nach links und rechts. 
#. it: Bene, andiamo ancora una volta a sinistra e destra
#. con <I=CAMERA>.
#. es: Bien, miremos a izquierda y derecha con
#. <I=CAMERA> una vez más.
#: olang/009c9ea4/0x62b97d/0x000000
msgid ""
"Alright, let’s try left and right on\n"
"<I=CAMERA> one more time."
msgstr ""

#. fr: Il y a trois positions :
#. debout, accroupi et allongé.
#. de: Es gibt drei Haltungen:
#. Stehen, Hocken und Liegen.
#. it: Hai tre posture disponibili:
#. in piedi, accovacciato e disteso.
#. es: Hay tres posiciones:
#. de pie, agachado y tumbado.
#: olang/009c9ea4/0x62bb7d/0x000004
msgid ""
"You have three stances:\n"
"stand, crouch, and lying down."
msgstr ""

#. fr: Pour changer de position, utilise <I=STANCE>.
#. de: Drücken Sie <I=STANCE>, um die Haltung zu wechseln.
#. it: Per cambiare postura usa <I=STANCE>.
#. es: Para cambiar de posición, se utiliza <I=STANCE>.
#: olang/009c9ea4/0x62bb7d/0x000005
msgid "To change stances use <I=STANCE>. "
msgstr ""

#. fr: Appuie sur <I=STANCE> pour passer de la position debout à accroupi.
#. de: Tippen Sie <I=STANCE> an, um zwischen Stehen und Hocken zu wechseln.
#. it: Premi <I=STANCE> per alternare fra in piedi e accovacciato.
#. es: Tocando el botón se cambia entre estar de pie y estar agachado.
#: olang/009c9ea4/0x62bb7d/0x000006
msgid ""
"Tap <I=STANCE> to change \n"
"between standing and crouching."
msgstr ""

#. fr: Tu peux te déplacer dans ces positions.
#. de: Sie können sich in jeder Haltung bewegen.
#. it: Puoi muoverti in entrambe le posizioni.
#. es: Ambas posiciones permiten moverse.
#: olang/009c9ea4/0x62bb7d/0x000007
msgid "You can move in either stance."
msgstr ""

#. fr: Appuie sur <I=STANCE> et maintiens-la pour t’allonger.
#. de: Halten Sie <I=STANCE> gedrückt, um sich hinzulegen.
#. it: Premi <I=STANCE> e tienilo premuto per stare disteso a terra.
#. es: Manteniendo pulsado <I=STANCE> se pasará a estar tumbado.
#: olang/009c9ea4/0x62bb7d/0x000008
msgid "Hold <I=STANCE> and keep it held to lie down."
msgstr ""

#. fr: Qu'est-ce que tu fais ?
#. de: Was machen Sie da?
#. it: Cosa stai facendo?
#. es: ¿Pero qué está haciendo?
#: olang/009c9ea4/0x62c87d/0x000000
#: olang/009c9ea4/0x64687e/0x000000
msgid "What are you doing? "
msgstr ""

#. fr: Sers-toi de <I=STANCE> pour changer de position !
#. de: Drücken Sie <I=STANCE>, um Ihre Haltung zu wechseln!
#. it: Usa <I=STANCE> per cambiare la tua posizione!
#. es: Use <I=STANCE> para cambiar de posición.
#: olang/009c9ea4/0x62c87d/0x000001
msgid "Use <I=STANCE> to change your stance! "
msgstr ""

#. fr: Boss, change de position avec <I=STANCE> !
#. de: Boss, wechseln Sie Ihre Haltung mit <I=STANCE>!
#. it: Boss, cambia la tua posizione con <I=STANCE>!
#. es: Boss, cambie de posición con <I=STANCE>.
#: olang/009c9ea4/0x62c8fd/0x000000
msgid "Boss, change your stance with <I=STANCE>!"
msgstr ""

#. fr: Bon, et maintenant ? Utilise
#. <I=MOVE> pour te déplacer !
#. de: Was ist?
#. Bewegen Sie sich mit <I=MOVE>!
#. it: Cosa c'è?
#. Usa <I=MOVE> per spostarti!
#. es: ¿Y ahora qué?
#. Use <I=MOVE> para moverse.
#: olang/009c9ea4/0x62cafd/0x000000
msgid ""
"What now? \n"
"Use <I=MOVE> to move!"
msgstr ""

#. fr: Pour faire une roulade, appuie sur <I=STANCE> en courant.
#. de: Tippen Sie zum Rollen <I=STANCE> beim Laufen an.
#. it: Per rotolare, premi rapidamente <I=STANCE> mentre corri.
#. es: Para rodar, toque <I=STANCE> mientras corre.
#: olang/009c9ea4/0x62cbfd/0x000004
#: olang/009c9ea4/0x62cbfe/0x000004
msgid "To roll, tap <I=STANCE> while running."
msgstr ""

#. fr: Pigé ?
#. de: Verstanden?
#. it: Hai capito?
#. es: ¿Entendido?
#: olang/009c9ea4/0x62cbfd/0x000005
msgid "You got that?"
msgstr ""

#. fr: Pigé ?
#. de: Verstanden?
#. it: Hai capito?
#. es: ¿Entendido?
#: olang/009c9ea4/0x62cbfe/0x000005
msgid "You got that? "
msgstr ""

#. fr: Appuie sur <I=STANCE> en courant. Surtout n’oublie pas ça !
#. de: Tippen Sie <I=STANCE> beim Laufen an. Nicht vergessen!
#. it: Premi rapidamente <I=STANCE> mentre corri. Ricordatelo!
#. es: Toque <I=STANCE> mientras corre. ¡No lo olvide!
#: olang/009c9ea4/0x62cbfe/0x000006
msgid ""
"Tap <I=STANCE> while running. \n"
"Don't forget it!"
msgstr ""

#. fr: Quel est le problème ?
#. Cours avec <I=MOVE>,
#. puis appuie sur <I=STANCE> pour faire une roulade !
#. de: Was ist los?
#. Laufen Sie mit <I=MOVE>
#. und drücken Sie <I=STANCE> zum Rollen!
#. it: Qual è il problema?!
#. Corri con <I=MOVE>,
#. poi premi <I=STANCE> per rotolare!
#. es: ¿Qué pasa?
#. ¡Corra con <I=MOVE>
#. y pulse <I=STANCE> para rodar!
#: olang/009c9ea4/0x62d87d/0x000000
#: olang/009c9ea4/0x62d87e/0x000000
msgid ""
"What's wrong?! \n"
"Run with <I=MOVE>, \n"
"then press <I=STANCE> to roll!"
msgstr ""

#. fr: Cours avec <I=MOVE>,
#. puis appuie sur <I=ATK> pour faire une roulade !
#. de: Laufen Sie mit <I=MOVE>
#. und drücken Sie <I=ATK> zum Rollen!
#. it: Corri con <I=MOVE>,
#. poi premi rapidamente <I=ATK> per rotolare!
#. es: Corra con <I=MOVE>
#. y pulse <I=ATK> para rodar.
#: olang/009c9ea4/0x62d87d/0x000001
msgid ""
"Run with <I=MOVE>,\n"
"then tap <I=ATK> to roll!"
msgstr ""

#. fr: Cours avec <I=MOVE>,
#. puis appuie sur <I=STANCE> pour faire une roulade !
#. de: Laufen Sie mit <I=MOVE>
#. und drücken Sie <I=STANCE> zum Rollen!
#. it: Corri con <I=MOVE>,
#. poi premi  <I=STANCE> per rotolare!
#. es: Corra con <I=MOVE>
#. y pulse <I=STANCE> para rodar.
#: olang/009c9ea4/0x62d87e/0x000001
msgid ""
"Run with <I=MOVE>, \n"
"then tap <I=STANCE> to roll!"
msgstr ""

#. fr: Pour frapper un ennemi, 
#. appuie sur <I=ATK>, sans bouger.
#. de: Drücken Sie <I=ATK>, 
#. wenn Sie stehen, um einen Feind zu schlagen!
#. it: Per colpire un nemico, 
#. premi <I=ATK> mentre stai fermo in piedi!
#. es: Para golpear a un enemigo, 
#. hay que pulsar <I=ATK> sin moverse.
#: olang/009c9ea4/0x62d9fd/0x000000
msgid ""
"To strike an enemy, \n"
"press <I=ATK> while standing still! "
msgstr ""

#. fr: À mon commandement, appuie plusieurs fois sur <I=ATK> et étale ton adversaire !
#. de: Drücken Sie auf meinen Befehl mehrfach <I=ATK> und schalten Sie Ihren Gegner aus!
#. it: Al mio ordine, premi ripetutamente <I=ATK> per stendere il tuo avversario!
#. es: Cuando yo dé la orden, debéis pulsar <I=ATK> repetidamente para derribar al rival.
#: olang/009c9ea4/0x62d9fd/0x000001
msgid ""
"On my command, press <I=ATK>\n"
"repeatedly and take down your opponent!"
msgstr ""

#. fr: Pour frapper un ennemi, 
#. appuie sur <I=CQC> au contact, sans bouger.
#. de: Drücken Sie <I=CQC>, wenn Sie stehen, 
#. um einen Feind zu schlagen!
#. it: Per colpire un nemico, 
#. premi <I=CQC> mentre stai fermo in piedi!
#. es: Para golpear a un enemigo, 
#. hay que pulsar <I=CQC> sin moverse.
#: olang/009c9ea4/0x62d9fe/0x000000
msgid ""
"To strike an enemy, \n"
"press <I=CQC> while standing still!"
msgstr ""

#. fr: À mon commandement,
#. de: Drücken Sie auf meinen Befehl
#. it: Al mio ordine, premi
#. es: Cuando yo dé la orden,
#: olang/009c9ea4/0x62d9fe/0x000001
msgid "On my command,"
msgstr ""

#. fr: appuie plusieurs fois sur <I=CQC> 
#. et étale ton adversaire !
#. de: mehrfach <I=CQC> 
#. und schalten Sie Ihren Gegner aus!
#. it: ripetutamente <I=CQC> per stendere il tuo avversario!
#. es: debéis pulsar <I=CQC> repetidamente 
#. para derribar al rival.
#: olang/009c9ea4/0x62d9fe/0x000002
msgid ""
"press <I=CQC> repeatedly \n"
"and take down your opponent!"
msgstr ""

#. fr: Ça va, Boss ?
#. de: Alles okay, Boss?
#. it: Tutto bene, Boss?
#. es: ¿Está bien, Boss?
#: olang/009c9ea4/0x62dafd/0x000000
#: olang/009c9ea4/0x62dafe/0x000000
msgid "You alright, boss?"
msgstr ""

#. fr: Appuie sur <I=ATK>, sans bouger !
#. de: Drücken Sie <I=ATK>, ohne sich zu bewegen!
#. it: Premi <I=ATK> senza muoverti!
#. es: ¡Pulse <I=ATK> sin moverse!
#: olang/009c9ea4/0x62dafd/0x000001
msgid "Press <I=ATK> without moving!"
msgstr ""

#. fr: Appuie sur <I=CQC> à mains nues, sans bouger !
#. de: Drücken Sie <I=CQC>, ohne sich zu bewegen!
#. it: Premi <I=CQC> senza muoverti!
#. es: ¡Pulse <I=CQC> sin moverse!
#: olang/009c9ea4/0x62dafe/0x000001
msgid "Press <I=CQC> without moving!"
msgstr ""

#. fr: Boss, appuie sur <I=ATK>, sans bouger !
#. de: Drücken Sie <I=ATK>, ohne sich zu bewegen, Boss.
#. it: Premi <I=ATK> senza muoverti, Boss.
#. es: ¡Pulse <I=ATK> sin moverse, Boss!
#: olang/009c9ea4/0x62db7d/0x000000
msgid "Press <I=ATK> without moving, Boss. "
msgstr ""

#. fr: Boss, appuie sur <I=CQC>, sans bouger !
#. de: Drücken Sie <I=CQC>, ohne sich zu bewegen, Boss.
#. it: Premi <I=CQC> senza muoverti, Boss.
#. es: ¡Pulse <I=CQC> sin moverse, Boss!
#: olang/009c9ea4/0x62db7e/0x000000
msgid "Press <I=CQC> without moving, Boss. "
msgstr ""

#. fr: Pour utiliser la matraque étourdissante, appuie sur <I=AIM> et une fois prêt,
#. de: Drücken Sie zur Verwendung des Betäubungsstabs <I=AIM>, um ihn zu ziehen.
#. it: Per usare lo storditore elettrico, premi <I=AIM> per prepararlo,
#. es: Para usar la vara eléctrica, hay que pulsar <I=AIM> para prepararla
#. es: Para usar la vara eléctrica, pulse <I=AIM> para prepararla
#: olang/009c9ea4/0x62dc7d/0x000000
#: olang/009c9ea4/0x62dc7e/0x000000
msgid ""
"To use the stun rod, \n"
"press <I=AIM> to ready it,"
msgstr ""

#. fr: appuie sur <I=ATK>.
#. de: Drücken Sie danach <I=ATK>.
#. it: quindi premi <I=ATK>.
#. es: y después pulsar <I=ATK>.
#. it: quindi premi <I=ATK> con arma.
#. es: y pulse <I=ATK> con armas.
#: olang/009c9ea4/0x62dc7d/0x000001
#: olang/009c9ea4/0x62dc7e/0x000001
msgid "then press <I=ATK>."
msgstr ""

#. fr: Hé, hé ! Maintiens <I=AIM> enfoncée !
#. de: He! Halten Sie <I=AIM> gedrückt!
#. it: Ehi, ehi! Tieni premuto <I=AIM>!
#. es: ¡Mantenga pulsado <I=AIM>!
#: olang/009c9ea4/0x64487d/0x000000
msgid "Hey, hey! Hold down <I=AIM>!"
msgstr ""

#. fr: Hé ! Appuie sur <I=AIM> !
#. de: He! Drücken Sie <I=AIM>!
#. it: Ehi! Premi <I=AIM>!
#. es: ¡Eh! ¡Pulse <I=AIM>!
#: olang/009c9ea4/0x64487e/0x000000
msgid "Hey! Press <I=AIM>!"
msgstr ""

#. fr: Boss, maintiens <I=AIM> enfoncée. Merci !
#. de: Boss, bitte halten Sie <I=AIM> gedrückt!
#. it: Boss, tieni premuto <I=AIM>!
#. es: ¡Boss, mantenga pulsado <I=AIM>!
#: olang/009c9ea4/0x6448fd/0x000000
msgid "Boss, please hold down <I=AIM>!"
msgstr ""

#. fr: Boss, appuie sur <I=AIM>. Merci !
#. de: Boss, bitte drücken Sie <I=AIM>!
#. it: Boss, premi <I=AIM>!
#. es: Boss, pulse <I=AIM>.
#: olang/009c9ea4/0x6448fe/0x000000
msgid "Boss, please press <I=AIM>!"
msgstr ""

#. fr: Quel est le problème ? Appuie sur <I=ATK> en maintenant <I=AIM> enfoncée !
#. de: Was ist los? Drücken Sie <I=ATK>, während Sie <I=AIM> gedrückt halten!
#. it: Qual è il problema? Premi <I=ATK> mentre tieni premuto <I=AIM>!
#. es: ¿Qué pasa? Pulse <I=ATK> mientras mantiene pulsado <I=AIM>.
#: olang/009c9ea4/0x644a7d/0x000000
msgid ""
"What's wrong? Press <I=ATK>\n"
"while holding down <I=AIM>! "
msgstr ""

#. fr: Quel est le problème ? Appuie sur <I=ATK> après avoir appuyé sur <I=AIM> !
#. de: Was ist los? Drücken Sie <I=ATK>, nachdem Sie <I=AIM> gedrückt haben!
#. it: Qual è il problema? Premi <I=ATK> dopo aver premuto <I=AIM>!
#. es: ¿Qué pasa? Pulse <I=ATK> después de pulsar <I=AIM>.
#: olang/009c9ea4/0x644a7e/0x000000
msgid ""
"What's wrong? Press <I=ATK>\n"
"after pressing <I=AIM>! "
msgstr ""

#. fr: Boss, appuie sur <I=ATK> en maintenant <I=AIM> enfoncée !
#. de: Boss, bitte drücken Sie <I=ATK>, während Sie <I=AIM> gedrückt halten!
#. it: Boss, premi <I=ATK> mentre tieni premuto <I=AIM>!
#. es: Boss, pulse <I=ATK> mientras mantiene pulsado <I=AIM>.
#: olang/009c9ea4/0x644afd/0x000000
msgid ""
"Boss, please press <I=ATK> \n"
"while holding down <I=AIM>!"
msgstr ""

#. fr: Boss, appuie sur <I=ATK> après avoir appuyé sur <I=AIM> !
#. de: Boss, bitte drücken Sie <I=ATK>, nachdem Sie <I=AIM> gedrückt haben!
#. it: Boss, premi <I=ATK> dopo aver premuto <I=AIM>!
#. es: Boss, pulse <I=ATK> después de pulsar <I=AIM>.
#: olang/009c9ea4/0x644afe/0x000000
msgid ""
"Boss, please press <I=ATK> \n"
"after pressing <I=AIM>! "
msgstr ""

#. fr: et appuie sur <I=ATK> 
#. en inclinant <I=MOVE>.
#. de: und drücken Sie <I=ATK>,
#. während Sie <I=MOVE> bewegen.
#. it: e premi <I=ATK>
#. mentre inclini <I=MOVE>.
#. es: y pulsar el <I=ATK>
#. mientras mueve <I=MOVE>.
#: olang/009c9ea4/0x644bfd/0x000002
msgid ""
"and press <I=ATK> \n"
"while you tilt <I=MOVE>."
msgstr ""

#. fr: Appuie sur <I=CQC> 
#. près d'un ennemi en inclinant <I=MOVE> !
#. de: Drücken Sie in der Nähe eines Gegners <I=CQC>,
#. während Sie <I=MOVE> bewegen!
#. it: Premi <I=CQC> 
#. vicino a un nemico mentre inclini <I=MOVE>!
#. es: Pulse <I=CQC> 
#. cerca de un rival mientras mueve <I=MOVE>.
#: olang/009c9ea4/0x644bfe/0x000001
msgid ""
"and press <I=CQC> \n"
"near an enemy as you tilt <I=MOVE>!"
msgstr ""

#. fr: Hé !
#. Appuie sur <I=ATK>
#. en inclinant <I=MOVE> !
#. de: He!
#. Drücken Sie <I=ATK>,
#. während Sie <I=MOVE> bewegen!
#. it: Ehi!
#. Premi <I=ATK>
#. mentre inclini <I=MOVE>!
#. es: ¡Eh!
#. ¡Pulse <I=ATK>
#. mientras mueve <I=MOVE>!
#: olang/009c9ea4/0x6457fd/0x000000
msgid ""
"Hey! \n"
"Press <I=ATK> \n"
"as you tilt <I=MOVE>!"
msgstr ""

#. fr: Appuie sur <I=ATK> en inclinant <I=MOVE>!
#. de: Drücken Sie <I=ATK>, 
#. während Sie <I=MOVE> bewegen!
#. it: Premi <I=ATK> mentre inclini <I=MOVE>!
#. es: Pulse <I=ATK> mientras inclina <I=MOVE>.
#: olang/009c9ea4/0x6457fd/0x000001
msgid "Press <I=ATK> as you tilt <I=MOVE>!"
msgstr ""

#. fr: Hé !
#. Appuie sur <I=CQC>
#. en inclinant <I=MOVE> !
#. de: He!
#. Drücken Sie <I=CQC>,
#. während Sie <I=MOVE> bewegen!
#. it: Ehi!
#. Premi <I=CQC> 
#. mentre inclini <I=MOVE>!
#. es: ¡Eh!
#. ¡Pulse <I=CQC>
#. mientras mueve <I=MOVE>!
#: olang/009c9ea4/0x6457fe/0x000000
msgid ""
"Hey! \n"
"Press <I=CQC>\n"
"as you tilt <I=MOVE>!"
msgstr ""

#. fr: Hé !
#. de: He!
#. it: Ehi!
#. es: ¡Eh!
#: olang/009c9ea4/0x6457fe/0x000001
msgid "Hey! "
msgstr ""

#. fr: tu dois appuyer sur <I=ATK>
#. en inclinant <I=MOVE>.
#. de: Sie müssen <I=ATK> drücken,
#. während Sie <I=MOVE> bewegen!
#. it: devi premere <I=ATK>
#. mentre inclini <I=MOVE>!
#. es: ¡tiene que pulsar <I=ATK>
#. mientras mueve <I=MOVE>!
#: olang/009c9ea4/0x6458fd/0x000001
msgid ""
"you have to press <I=ATK> \n"
"as you tilt <I=MOVE>!"
msgstr ""

#. fr: tu dois appuyer sur <I=CQC>
#. en inclinant <I=MOVE> !
#. de: Sie müssen <I=CQC> drücken,
#. während Sie <I=MOVE> bewegen!
#. it: devi premere <I=CQC> 
#. mentre inclini <I=MOVE>!
#. es: ¡tiene que pulsar <I=CQC>
#. mientras mueve <I=MOVE>!
#: olang/009c9ea4/0x6458fe/0x000001
msgid ""
"you have to press <I=CQC> \n"
"as you tilt <I=MOVE>!"
msgstr ""

#. fr: Pour maîtriser ton adversaire,
#. de: Um Ihren Gegner in den Würgegriff zu nehmen,
#. it: Per bloccare il tuo avversario,
#. es: Para reducir a un oponente,
#: olang/009c9ea4/0x645bfd/0x000000
msgid "To restrain your opponent, "
msgstr ""

#. fr: maintiens <I=ATK> enfoncée en étant près de lui.
#. de: halten Sie <I=ATK> gedrückt, 
#. wenn Sie in seiner Nähe sind.
#. it: tieni premuto <I=ATK> mentre gli sei vicino.
#. es: hay que mantener pulsado <I=ATK> cerca de él.
#: olang/009c9ea4/0x645bfd/0x000001
msgid "hold down <I=ATK> while near them. "
msgstr ""

#. fr: Pour maîtriser ton adversaire,
#. de: Um Ihren Gegner in den Würgegriff zu nehmen,
#. it: Per bloccare il tuo avversario,
#. es: Para reducir a un oponente,
#: olang/009c9ea4/0x645bfe/0x000000
msgid "To restrain your opponent,"
msgstr ""

#. fr: maintiens <I=CQC> enfoncée en étant près de lui.
#. de: halten Sie <I=CQC> gedrückt, 
#. wenn Sie in seiner Nähe sind.
#. it: tieni premuto <I=CQC> mentre gli sei vicino.
#. es: hay que mantener pulsado <I=CQC> cerca de él.
#: olang/009c9ea4/0x645bfe/0x000001
msgid "hold down <I=CQC> while near them. "
msgstr ""

#. fr: À mon commandement, maîtrise ton adversaire !
#. de: Nehmen Sie Ihren Gegner auf
#. meinen Befehl hin in den Würgegriff.
#. it: Blocca il tuo avversario
#. al mio ordine.
#. es: Reduzca a su oponente cuando yo
#. dé la orden.
#: olang/009c9ea4/0x645bfe/0x000002
msgid ""
"Restrain your opponent \n"
"on my command. \n"
msgstr ""

#. fr: Qu'est-ce que tu fais ?
#. de: Was machen Sie da?
#. it: Cosa stai facendo?
#. es: ¿Pero qué está haciendo?
#: olang/009c9ea4/0x64687d/0x000000
msgid "What are you doing?"
msgstr ""

#. fr: Appuie sur <I=ATK> en étant près de ton adversaire.
#. de: Drücken Sie <I=ATK> in der Nähe Ihres Gegners!
#. it: Premi <I=ATK> vicino al tuo avversario!
#. es: ¡Pulse <I=ATK> cerca de su rival!
#: olang/009c9ea4/0x64687d/0x000001
msgid "Press <I=ATK> while near your opponent! "
msgstr ""

#. fr: Appuie sur <I=CQC> en étant près de ton adversaire.
#. de: Drücken Sie <I=CQC> in der Nähe Ihres Gegners!
#. it: Premi <I=CQC> vicino al tuo avversario!
#. es: ¡Pulse <I=CQC> cerca de su rival!
#: olang/009c9ea4/0x64687e/0x000001
msgid "Press <I=CQC> while near your opponent! "
msgstr ""

#. fr: Boss,
#. de: Boss,
#. it: Boss,
#. es: Boss,
#: olang/009c9ea4/0x6468fd/0x000000
#: olang/009c9ea4/0x6468fe/0x000000
#: olang/009c9ea4/0x64ab7e/0x000000
msgid "Boss, "
msgstr ""

#. fr: tu dois appuyer sur <I=ATK> 
#. quand tu es près de ton adversaire !
#. de: Sie müssen <I=ATK> in der Nähe Ihres Gegners drücken!
#. it: devi premere <I=ATK> vicino al tuo avversario!
#. es: hay que pulsar <I=ATK> cerca del rival.
#: olang/009c9ea4/0x6468fd/0x000001
msgid ""
"you have to press <I=ATK> \n"
"while next to your opponent! "
msgstr ""

#. fr: tu dois appuyer sur <I=CQC> 
#. en étant près de ton adversaire !
#. de: Sie müssen <I=CQC> in der Nähe Ihres Gegners drücken!
#. it: devi premere <I=CQC> vicino al tuo avversario!
#. es: hay que pulsar <I=CQC> cerca del rival.
#: olang/009c9ea4/0x6468fe/0x000001
msgid ""
"you have to press <I=CQC> \n"
"while next to your opponent!"
msgstr ""

#. fr: pousse <I=MOVE> dans une direction quand tu le tiens.
#. de: drücken Sie <I=MOVE>
#. in eine Richtung, wenn Sie ihn in den Würgegriff genommen haben.
#. it: premi verso una direzione con <I=MOVE>
#. dopo averlo bloccato.
#. es: pulse una dirección en <I=MOVE> 
#. cuando los tenga reducidos.
#: olang/009c9ea4/0x646b7d/0x000001
msgid "press a direction on <I=MOVE> when you have them restrained."
msgstr ""

#. fr: Pour interroger quelqu’un,
#. de: Wenn Sie jemanden verhören wollen,
#. it: Per interrogare qualcuno,
#. es: Para interrogar a alguien,
#: olang/009c9ea4/0x647a7d/0x000000
#: olang/009c9ea4/0x647a7e/0x000000
msgid "To interrogate someone,"
msgstr ""

#. fr: appuie sur <I=ATK> pour le maîtriser, puis appuie sur <I=INTERROGATE>.
#. de: Drücken Sie <I=ATK>, um ihn in den Würgegriff zu nehmen.
#. Drücken Sie danach <I=INTERROGATE>.
#. it: premi <I=ATK> per bloccarlo e quindi premi <I=INTERROGATE>.
#. es: pulse <I=ATK> para reducirlo y, a continuación, <I=INTERROGATE>.
#: olang/009c9ea4/0x647a7d/0x000001
#: olang/009c9ea4/0x647a7e/0x000001
msgid ""
"Press <I=ATK> to restrain \n"
"them, then press <I=INTERROGATE>."
msgstr ""

#. fr: Tout va bien ? Appuie sur <I=ACT> !
#. de: Alles okay? Drücken Sie <I=ACT>.
#. it: Tutto OK? Premi <I=ACT>!
#. es: ¿Está bien? ¡Pulse <I=ACT>!
#: olang/009c9ea4/0x647bfd/0x000000
msgid "You OK? Press <I=ACT>!"
msgstr ""

#. fr: Tout va bien ? Appuie sur <I=INTERROGATE> !
#. de: Alles okay? Drücken Sie <I=INTERROGATE>!
#. it: Tutto OK? Premi <I=INTERROGATE>!
#. es: ¿Está bien? ¡Pulse <I=INTERROGATE>!
#: olang/009c9ea4/0x647bfe/0x000000
msgid "You OK? Press <I=INTERROGATE>!"
msgstr ""

#. fr: Boss, il faut appuyer sur <I=ACT>.
#. de: Sie müssen <I=ACT> drücken, Boss!
#. it: Devi premere <I=ACT>, Boss!
#. es: ¡Hay que pulsar <I=ACT>, Boss!
#: olang/009c9ea4/0x647c7d/0x000000
msgid "You have to press <I=ACT>, Boss!"
msgstr ""

#. fr: Boss, il faut appuyer sur <I=INTERROGATE> !
#. de: Boss, Sie müssen <I=INTERROGATE> drücken!
#. it: Boss, devi premere <I=INTERROGATE>!
#. es: ¡Hay que pulsar <I=INTERROGATE>, Boss!
#: olang/009c9ea4/0x647c7e/0x000000
msgid ""
"You have to press <I=INTERROGATE>, \n"
"Boss!"
msgstr ""

#. fr: Incline ensuite <I=MOVE>
#. pour les projeter.
#. de: Bewegen Sie danach <I=MOVE>,
#. um ihn zu werfen.
#. it: Quindi inclina <I=MOVE> 
#. per lanciarlo.
#. es: A continuación, mueva
#. <I=MOVE> para lanzarlo.
#: olang/009c9ea4/0x649a7d/0x000001
#: olang/009c9ea4/0x649a7e/0x000001
msgid "Then tilt <I=MOVE> to throw them."
msgstr ""

#. fr: En inclinant <I=MOVE> vers
#. d’autres ennemis,
#. de: Indem Sie <I=MOVE> in Richtung
#. anderer Feinde bewegen,
#. it: Inclinando <I=MOVE> verso 
#. altri nemici,
#. es: Si mueve <I=MOVE>
#. hacia otros enemigos,
#: olang/009c9ea4/0x649a7d/0x000002
#: olang/009c9ea4/0x649a7e/0x000002
msgid "By tilting <I=MOVE> toward other enemies,"
msgstr ""

#. fr: D'abord, maîtrise un ennemi en appuyant sur <I=CQC> quand tu es proche de lui.
#. de: Nehmen Sie zuerst einen Gegner in den Würgegriff, indem Sie in seiner Nähe <I=CQC> drücken.
#. it: Premi <I=CQC> vicino a un nemico per bloccarlo!
#. es: Primero, reduzca a un rival pulsando el
#. <I=CQC> sin armas cerca de él.
#: olang/009c9ea4/0x649a7e/0x000000
msgid "First, restrain an opponent by pressing <I=CQC> while near them."
msgstr ""

#. fr: Hé !
#. Incline <I=MOVE> pendant que
#. tu maîtrises l’adversaire !
#. de: He!
#. Bewegen Sie <I=MOVE>,
#. während Sie den Gegner im Würgegriff haben!
#. it: Ehi!
#. Inclina <I=MOVE> mentre blocchi 
#. l'avversario!
#. es: ¡Eh!
#. ¡Mueva <I=MOVE> mientras reduce a su oponente!
#: olang/009c9ea4/0x649bfd/0x000000
msgid ""
"Hey!\n"
"Tilt <I=MOVE> while \n"
"restraining the opponent!"
msgstr ""

#. fr: Incline <I=MOVE> pendant que tu maîtrises l’adversaire !
#. de: Bewegen Sie <I=MOVE>,
#. während Sie den Gegner im Würgegriff haben!
#. it: Inclina <I=MOVE> mentre blocchi l'avversario!
#. es: ¡Incline <I=MOVE> mientras reduce 
#. a su oponente!
#: olang/009c9ea4/0x649bfd/0x000001
msgid "Tilt <I=MOVE> while restraining the opponent! "
msgstr ""

#. fr: Boss, incline <I=MOVE> pendant que
#. tu maîtrises l’adversaire.
#. de: Bewegen Sie <I=MOVE>, während Sie
#. den Gegner im Würgegriff haben, Boss!
#. it: Inclina <I=MOVE> mentre blocchi 
#. l'avversario, Boss!
#. es: ¡Mueva <I=MOVE> mientras reduce
#. a su oponente, Boss!
#: olang/009c9ea4/0x64a7fd/0x000000
msgid ""
"Tilt <I=MOVE> while restraining \n"
"the opponent, Boss!"
msgstr ""

#. fr: tu dois les éliminer l’un après l’autre.
#. de: müssen Sie sie einen nach dem anderen ausschalten.
#. it: dovrai affrontarli uno alla volta.
#. es: tendréis que atacarles uno tras otro.
#: olang/009c9ea4/0x64a97d/0x000001
msgid ""
"you'll have to take them on one \n"
"after the other."
msgstr ""

#. fr: appuie de nouveau sur <I=ATK> en lançant l’ennemi.
#. de: <I=ATK>, während Sie den aktuellen Feind werfen.
#. it: premi un'altra volta <I=ATK> mentre lanci il nemico attuale.
#. es: hay que volver a pulsar <I=ATK> mientras se lanza un enemigo.
#: olang/009c9ea4/0x64a97d/0x000003
msgid ""
"simply press <I=ATK> again \n"
"while throwing the current enemy.  "
msgstr ""

#. fr: Quand tu es entouré par plusieurs ennemis,
#. de: Wenn Sie von mehreren Feinden
#. umzingelt sind,
#. it: Quando sei circondato
#. da più nemici,
#. es: Si está rodeado
#. por varios enemigos,
#. fr: Quand tu es entouré par plusieurs ennemis,
#. de: Wenn Sie von mehreren Feinden
#. umzingelt sind,
#. es: Si está rodeado
#. por varios enemigos,
#: olang/009c9ea4/0x64a97e/0x000000
#: olang/00cd740b/0x64a97e/0x000000
msgid ""
"When you're surrounded \n"
"by multiple enemies,"
msgstr ""

#. fr: tu dois les éliminer l’un après l’autre.
#. de: müssen Sie sie einen nach dem anderen ausschalten.
#. it: dovrai affrontarli uno alla volta.
#. es: atáquelos uno a uno.
#: olang/009c9ea4/0x64a97e/0x000001
msgid ""
"you'll have to take them on one \n"
"after the other. "
msgstr ""

#. fr: Pour ce faire,
#. de: ausschalten.
#. it: Per farlo,
#. es: Para eso,
#: olang/009c9ea4/0x64a97e/0x000002
msgid ""
"To do it, \n"
msgstr ""

#. fr: appuie de nouveau sur <I=CQC> en projetant un ennemi.
#. de: <I=CQC>, während Sie den aktuellen Feind werfen.
#. it: premi un'altra volta <I=CQC> mentre lanci il nemico attuale.
#. es: vuelva a pulsar <I=CQC> mientras lanza a un enemigo.
#: olang/009c9ea4/0x64a97e/0x000003
msgid ""
"simply press <I=CQC> again \n"
"while throwing the current enemy."
msgstr ""

#. fr: Attends bien l’apparition de l’icône.
#. de: Warten Sie aber, bis das Symbol
#. angezeigt wird.
#. it: Ricordati solo di aspettare
#. che appaia l'icona.
#. es: Hay que esperar a que aparezca el icono.
#: olang/009c9ea4/0x64a97e/0x000004
msgid ""
"Just be sure to wait for the Icon \n"
"to appear. \n"
msgstr ""

#. fr: Appuie sur <I=ATK> quand l’icône apparaît !
#. de: Drücken Sie <I=ATK>, wenn das Symbol erscheint!
#. it: Premi <I=ATK> quando appare l'icona!
#. es: Pulse <I=ATK> cuando aparezca el icono.
#: olang/009c9ea4/0x64aafd/0x000000
msgid "Press <I=ATK> when the Icon appears!"
msgstr ""

#. fr: Appuie sur <I=CQC> à corps quand l’icône apparaît !
#. de: Drücken Sie <I=CQC>, wenn das Symbol erscheint!
#. it: Premi <I=CQC> quando appare l'icona!
#. es: Pulse <I=CQC> cuando aparezca el icono.
#: olang/009c9ea4/0x64aafe/0x000000
msgid "Press <I=CQC> when the Icon appears! "
msgstr ""

#. fr: Boss, appuie sur <I=ATK> quand l’icône apparaît.
#. de: Boss, drücken Sie <I=ATK>, wenn das Symbol erscheint!
#. it: Boss, premi <I=ATK> quando appare l'icona!
#. es: Boss, pulse <I=ATK> cuando aparezca el icono.
#: olang/009c9ea4/0x64ab7d/0x000000
msgid "Boss, press <I=ATK> when the Icon appears!"
msgstr ""

#. fr: appuie sur <I=CQC> quand l’icône apparaît !
#. de: drücken Sie <I=CQC>, wenn das Symbol erscheint!
#. it: premi <I=CQC> quando appare l'icona!
#. es: pulse <I=CQC> cuando aparezca el icono.
#: olang/009c9ea4/0x64ab7e/0x000001
msgid "press <I=CQC> when the Icon appears! "
msgstr ""

#. fr: Recherche en cours selon les conditions définies.
#. *Veuillez utiliser la dernière version du jeu.
#. de: Führen Sie die Suche mit den festgelegten Bedingungen durch.
#. *Bitte verwenden Sie die aktuellste Version des Spiels.
#. it: Effettua una ricerca secondo i parametri selezionati.
#. Assicurarsi che il gioco sia aggiornato alla versione più recente.
#. es: Buscar con las condiciones seleccionadas.
#. *Asegúrate de haber actualizado el juego a la última versión.
#: olang/009c9ea4/0x68bb2b/0x01c78f
msgid ""
"Search with the conditions you have selected.\n"
"*Make sure your game is updated to the latest version."
msgstr ""

#. fr: Recherche de MEMBRES selon les conditions définies.
#. *Veuillez utiliser la dernière version du jeu.
#. de: Rekrutieren Sie MITGLIEDER mit den festgelegten Bedingungen.
#. *Bitte verwenden Sie die aktuellste Version des Spiels.
#. it: Cerca MEMBRI idonei ai parametri di ricerca selezionati.
#. *Assicurarsi che il gioco sia aggiornato alla versione più recente.
#. es: Buscar miembros con las condiciones seleccionadas.
#. *Asegúrate de haber actualizado el juego a la última versión.
#: olang/009c9ea4/0x68bb2b/0x594dbd
msgid ""
"Search for MEMBERS with the conditions you have selected.\n"
"*Make sure your game is updated to the latest version."
msgstr ""

#. fr: Tu peux utiliser les fonctionnalités en ligne pour recruter des MEMBRES CO-OPS à travers le monde.
#. Sélectionne le type d'invitation.
#. de: Verbinden Sie sich online, um CO-OPS-MITGLIEDER aus der ganzen Welt zu rekrutieren.
#. Wählen Sie die Art der Einladung aus.
#. it: Puoi reclutare i MEMBRI CO-OPS in tutto il mondo connettendoti online.
#. Seleziona il tipo di invito.
#. es: Puedes reclutar MIEMBROS CO-OPS de todo el mundo usando las funciones online. 
#. Selecciona el tipo de invitación.
#: olang/009c9ea4/0x68bb2b/0xac71d5
msgid ""
"You can recruit CO-OPS MEMBERS worldwide online.\n"
"Select the type of invitation."
msgstr ""

#. fr: Le compte actuel ne peut pas être utilisé pour le multijoueur en ligne.
#. de: Das aktuelle Konto kann nicht für Online-Multiplayer verwendet werden.
#. it: L'account attuale non può essere utilizzato per il multigiocatore online.
#. es: No es posible usar la cuenta de jugador actual en partidas multijugador online.
#: olang/009c9ea4/0x68bb2b/0xf6831d
msgid "Online multiplayer cannot be used by the current account."
msgstr ""

#. fr: Ouvrir le MANUEL EN LIGNE ?
#. de: Das Online-Handbuch öffnen?
#. it: Aprire il MANUALE ONLINE?
#. es: ¿Quieres abrir el manual en línea?
#: olang/009c9ea4/0x6b2d56/0x48e16c
msgid "Open the ONLINE MANUAL?"
msgstr ""

#. fr: Des ogives !
#. de: Atomwaffen!
#. it: Le testate nucleari!
#. es: ¡Las armas nucleares!
#: olang/009c9ea4/0x74d55a/0x000000
msgid "Nukes!"
msgstr ""

#. fr: Appuie sur <I=DEC> pour voir les conditions requises.
#. de: Drücken Sie <I=DEC>, um die Bedingungen zu sehen, die erfüllt werden müssen.
#. it: Premi <I=DEC> per vedere i requisiti da soddisfare.
#. es: Pulsa <I=DEC> para ver las condiciones.
#: olang/009c9ea4/0x82e3c9/0x6fd5da
msgid "Press <I=DEC> to view the requirements that must be met."
msgstr ""

#. fr: À l'époque, dans ma vieille unité, le commandant, pendant la gymnastique matinale, avait coutume de dire : « Quand vous avez des ennuis, appuyez sur la fenêtre de menu ! »
#. Je me demande comment il va aujourd'hui.
#. de: In meiner alten Einheit hat der Kommandeur uns bei den Morgenübungen immer gesagt: „Wenn Sie in Schwierigkeiten sind, öffnen Sie das Menü-Fenster!“ Was wohl aus ihm geworden ist?
#. it: Nella mia vecchia unità, durante l'allenamento mattutino il comandante era solito dirci: "Ogni volta che siete nei guai, aprite la finestra menu!!"
#. Chissà come se la passa in questo periodo.
#. es: En mi antigua unidad, el comandante solía decir durante los ejercicios matinales: "Si tenéis problemas, pulsad el botón Ventana del menú".
#. Me pregunto cómo le irá.
#: olang/009c9ea4/0x840500/0x374a51
msgid ""
"Back in my old unit, the commander used to tell us at morning calisthenics: \"Whenever you're in trouble, open the menu window!!\"\n"
"Wonder how he's doing these days."
msgstr ""

#. fr: Hé Boss, tu peux me montrer comment on recharge ?
#. Ah, c’est comme ça ! Il suffit d’appuyer sur la touche Action en étant équipé de l’arme. Merci bien, Boss !
#. de: He, Boss, können Sie mir das Nachladen beibringen?
#. ... Ahh, so geht das also! Einfach die Aktionstaste bei ausgerüsteter Waffe drücken! Vielen Dank, Boss!
#. it: Ehi Boss, mi insegneresti a ricaricare?
#. ...Ah, allora si fa così! Basta solo premere il Tasto Azione con l'arma equipaggiata! Grazie mille, Boss!
#. es: Boss, ¿me enseñas a recargar?
#. ¡Ah, así que es eso! ¿Solo pulsar el botón de acción con el arma equipada? ¡Muchas gracias, Boss!
#: olang/009c9ea4/0x840500/0x374af7
msgid ""
"Hey Boss, can you teach me how to reload?\n"
"...Ahh, so that's it! Just push the Action Button with the weapon equipped! Thanks a bunch, Boss!"
msgstr ""

#. fr: <I=PAUSE>: quitter le didacticiel.
#. de: <I=PAUSE>: Tutorial beenden.
#. it: <I=PAUSE>: fine tutorial.
#. es: <I=PAUSE>: salir del tutorial.
#: olang/009c9ea4/0x840ff7/0x44e180
msgid "<I=PAUSE>: End tutorial."
msgstr ""

